public fun evalBinop (operator, left, right) {
   case operator of
     "+"  -> left + right
   | "-"  -> left - right
   | "*"  -> left * right
   | "/"  -> left / right
   | "%"  -> left % right
   | "==" -> left == right
   | "!=" -> left != right
   | "<"  -> left < right
   | ">"  -> left > right
   | "<=" -> left <= right
   | ">=" -> left >= right
   | "&&" -> left && right
   | "!!" -> left !! right
   esac
}