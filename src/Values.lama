public fun unval(v) {
  case v of
    Val(x) -> x
  | Composite(x) -> x
  | _ -> failure("While calling a builtin, expected val, got %s", v.string)
  esac
}

public fun mkBox(x) {
  case x of
    #val -> Val(x)
  | #fun -> failure("Expression evaluated to a function: %s", x)
  | _ -> Composite(x)
  esac
}

public fun tryRead(arr, idx) {
  case idx of
    #val -> 
    case arr of
      Sexp(_, sex) -> sex[idx]
    | #str -> arr[idx]
    | #array -> arr[idx]
    | _ -> failure("Could not read %s[%s]", arr.string, idx)
    esac
  | _ -> failure("Could not read %s[%s] since index is not int", arr.string, idx.string)
  esac
}

public fun tryAssign(assignment, arr, idx, output) {
  fun assignByAddress() {
    case assignment of
      #val -> failure ("Indirect assignment is not supported in this environment\n")
    | _ -> assignment(arr, output)
    esac
  }

  case [arr, idx] of
    [Composite(arr@#str), Val(idx)] -> 
      case output of
        Val(output) -> if 0 <= output && output < 256 then arr[idx] := output else failure("Unable to put %d into string %s", output, arr) fi
      | _ -> failure("Unable to put unknown object %s into string %s", output.string, arr)
    esac
  | [Composite(arr@#array), Val(idx)] -> arr[idx] := unval(output)
  | [Composite(Sexp(_, sex)), Val(idx)] -> sex[idx] := unval(output)
  | [Glb(_), _] -> assignByAddress()
  | [Loc(_), _] -> assignByAddress()
  | _ -> failure("Could not assign %s[%s] = %s\n", arr.string, idx.string, output.string)
  esac
}