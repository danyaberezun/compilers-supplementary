var result = parseString (parse |> bypass (end), fread ("test_in.txt"));
var program = case result of
    Succ (t) -> t
  | _        -> failure ("parse failure\n")
  esac;
iter (fun (x) {printf ("%d\n", x)}, evalStmt ({}, program))
