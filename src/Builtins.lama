-- Builtins
import World;

fun fixBox (n) {
  n * 2 + 1
}

fun fixUnbox (v) {
  (v - 1) / 2
}

public fun evalBuiltin (name, args, w) {
  case [name, args] of
    ["stringval", {a}]            -> [a.string, w]
  | ["length"   , {a@#array}]     -> [fixBox (a.length), w]
  | ["length"   , {a@#str}]       -> [fixBox (a.length), w]
  | ["length"   , {Sexp (_, ev)}] -> [fixBox (ev.length), w]  
  | ["read"     , {}] ->
      case readWorld (w) of
        [v, w'] -> [fixBox (v), w']
      esac
  | ["write"    , {x@#val}]       -> [fixBox (0), writeWorld (fixUnbox (x), w)]
  | _ ->
     failure ("no builtin ""%s"" or it can not be applied to %s\n", name, args.string)
  esac
}
