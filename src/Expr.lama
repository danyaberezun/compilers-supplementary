-- Expression evaluator

import List;
import State;


-- The evaluator itself: takes a state and an expression,
-- returns integer value
--
-- An expression is represented by a data structure of the following shape:
--
-- expr = Var   (string)             |
--        Const (int)                |
--        Binop (string, expr, expr)

public fun evalBinaryOp (op, lhs, rhs) {
   case op of
   "+" -> lhs + rhs
   | "-" -> lhs - rhs
   | "*" -> lhs * rhs
   | "/" -> lhs / rhs
   | "%" -> lhs % rhs
   | "<" -> lhs < rhs
   | ">" -> lhs > rhs
   | "<=" -> lhs <= rhs
   | ">=" -> lhs >= rhs
   | "&&" -> lhs && rhs
   | "==" -> lhs == rhs
   | "!=" -> lhs != rhs
   esac
}

public fun evalExpr (st, expr) {
   case expr of 
   Var (el) -> st (el)
   | Const(el) -> el
   | Binop (op, ex1, ex2) ->
      let lhs = evalExpr (st, ex1) in
      let rhs = evalExpr (st, ex2) in
      evalBinaryOp (op, lhs, rhs)
   esac
}
