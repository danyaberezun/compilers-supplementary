-- Expression evaluator

import List;
import State;

public fun binop (op) {
  case op of
    "+"  -> infix +
  | "-"  -> infix -
  | "*"  -> infix *
  | "/"  -> infix /
  | "%"  -> infix %
  | "<"  -> infix <
  | ">"  -> infix >
  | "<=" -> infix <=
  | ">=" -> infix >=
  | "==" -> infix ==
  | "!=" -> infix !=
  | "&&" -> infix &&
  | "!!" -> infix !!
  esac
}

public fun evalExpr (st, expr) {
  case expr of
    Const (n)        -> n
  | Var   (x)        -> st (x)
  | Binop (op, l, r) -> binop (op) (evalExpr (st, l), evalExpr (st, r))
  esac
}
