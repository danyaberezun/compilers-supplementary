-- Expression evaluator

import List;
import State;


-- The evaluator itself: takes a state and an expression,
-- returns integer value
--
-- An expression is represented by a data structure of the following shape:
--
-- expr = Var   (string)             |
--        Const (int)                |
--        Binop (string, expr, expr)

public fun evalExpr (st, expr) {
   case expr of
     Var(x)                 -> st(x)
   | Const(x)               -> x
   | Binop(op, left, right) -> evalOp(op, evalExpr(st, left), evalExpr(st, right))
   esac
}
public fun evalOp (operator, left, right) {
   case operator of
     "+"  -> left + right
   | "-"  -> left - right
   | "*"  -> left * right
   | "/"  -> left / right
   | "%"  -> left % right
   | "==" -> if left == right then 1 else 0 fi
   | "!=" -> 1 - evalOp("==", left, right)
   | "<"  -> if left < right then 1 else 0 fi
   | ">"  -> if left > right then 1 else 0 fi
   | ">=" -> 1 - evalOp("<", left, right)
   | "<=" -> 1 - evalOp(">", left, right)
   | "&&" -> if (left != 1 && left != 0) !! (right != 1 && right != 0) then failure("both arguments of && must be 0 or 1")
             else if left == 1 && right == 1 then 1 else 0 fi
             fi
   | "!!" -> if (left != 1 && left != 0) !! (right != 1 && right != 0) then failure("both arguments of !! must be 0 or 1")
             else if left == 1 !! right == 1 then 1 else 0 fi
             fi
   esac
}
