-- Expression evaluator

import List;
import State;
import World;

-- As association map which maps "\otimes" into "\oplus"
var ops = {
  ["+" , infix + ],
  ["-" , infix - ],
  ["*" , infix * ],
  ["/" , infix / ],
  ["%" , infix % ],
  ["==", infix ==],
  ["!=", infix !=],
  ["<" , infix < ],
  ["<=", infix <=],
  [">" , infix > ],
  [">=", infix >=],
  ["&&", infix &&],
  ["!!", infix !!]
};

-- The evaluator for infix operators: takes an operator as a string
-- and two operand values, and returns the result
public fun evalOp (op, l, r) {
  case assoc (ops, op) of
    Some (f) -> f (l, r)
  esac
}

-- Evaluates an expression "expr" in a configuration "c".
-- A configuration is a pair of a state "s" and a world "w".
-- Returns a final configuration (if any)
--
-- A expression is represented by a data structure of the following shape:
--
-- expr = Assn    (expr, expr)         |
--        Seq     (expr, expr)         |
--        Skip                         |
--        Read    (string)             |
--        Write   (expr)               |
--        If      (expr, expr, expr)   |
--        While   (expr, expr)         |
--        DoWhile (expr, expr)         |
--        Var     (string)             |
--        Ref     (string)             |
--        Const   (int)                |
--        Binop   (string, expr, expr) |
--        Ignore  (expr)

-- Evaluates a list of expressions, properly threading a configurations.
-- Returns the final configuration and the list of values
fun evalList (c, exprs) {
  case foldl (fun ([c, vals], e) {
                case eval (c, e) of
                  [c, v] -> [c, v : vals]
                esac
              },
              [c, {}],
              exprs) of
    [c, vals] -> [c, reverse (vals)]
  esac
}

public fun evalBinop (op, x, y) {
   case op of
        "+" -> x + y
      | "-" -> x - y
      | "*" -> x * y
      | "/" -> x / y
      | "%" -> x % y
      | ">" -> x > y
      | "<" -> x < y
      | ">=" -> x >= y
      | "<=" -> x <= y
      | "==" -> x == y
      | "!=" -> x != y
      | "&&" -> x && y
      | "!!" -> x !! y
   esac
}

-- Evaluation returns [configuration, value], where value is one of
--   Val  (int)    -- a plain rvalue (integer)
-- | Ref  (string) -- a reference to a variable (lvalue)
-- | Void          -- no value (statement position)
fun eval (c@[s, w], expr) {
  case expr of
    Const (n)        -> [c, Val (n)]
  | Var   (x)        -> [c, Val (s (x))]
  | Ref   (x)        -> [c, Ref (x)]
  | Binop (op, a, b) ->
      case eval (c, a) of
        [c1, Val (x)] ->
          case eval (c1, b) of
            [c2, Val (y)] -> [c2, Val (evalOp (op, x, y))]
          esac
      esac
  | Assn  (l, r) ->
      case eval (c, l) of
        [c1, Ref (x)] ->
          case eval (c1, r) of
            [[s2, w2], Val (v)] -> [[s2 <- [x, v], w2], Val (v)]
          esac
      esac
  | Seq   (a, b) ->
      case eval (c, a) of
        [c1, _] -> eval (c1, b)
      esac
  | Skip             -> [c, Void]
  | Read  (x)        ->
      let [z, w1] = readWorld (w) in [[s <- [x, z], w1], Void]
  | Write (e)        ->
      case eval (c, e) of
        [[s1, w1], Val (v)] -> [[s1, writeWorld (v, w1)], Void]
      esac
  | If (e, t, f) ->
      case eval (c, e) of
        [c1, Val (n)] -> if n != 0 then eval (c1, t) else eval (c1, f) fi
      esac
  | While (e, body) ->
      case eval (c, e) of
        [c1, Val (n)] ->
          if n != 0
          then case eval (c1, body) of
                 [c2, _] -> eval (c2, While (e, body))
               esac
          else [c1, Void]
          fi
      esac
  | DoWhile (body, e) ->
      case eval (c, body) of
        [c1, _] ->
          case eval (c1, e) of
            [c2, Val (n)] ->
              if n != 0
              then eval (c2, DoWhile (body, e))
              else [c2, Void]
              fi
          esac
      esac
  | Ignore (e) ->
      case eval (c, e) of
        [c1, _] -> [c1, Void]
      esac
  esac
}


-- Evaluates a program with a given input and returns an output
public fun evalExpr (input, expr) {
  case eval ([emptyState, createWorld (input)], expr) of
    [c, _] -> c.snd.getOutput
  esac
}
