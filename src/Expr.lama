-- Expression evaluator

import List;
import State;
import World;

-- As association map which maps "\otimes" into "\oplus"
var ops = {
  ["+" , infix + ],
  ["-" , infix - ],
  ["*" , infix * ],
  ["/" , infix / ],
  ["%" , infix % ],
  ["==", infix ==],
  ["!=", infix !=],
  ["<" , infix < ],
  ["<=", infix <=],
  [">" , infix > ],
  [">=", infix >=],
  ["&&", infix &&],
  ["!!", infix !!]
};

-- The evaluator for infix operators: takes an operator as a string
-- and two operand values, and returns the result
public fun evalOp (op, l, r) {
  case assoc (ops, op) of
    Some (f) -> f (l, r)
  esac
}

-- Evaluates an expression "expr" in a configuration "c".
-- A configuration is a pair of a state "s" and a world "w".
-- Returns a final configuration (if any)
--
-- A expression is represented by a data structure of the following shape:
--
-- expr = Assn    (expr, expr)         |
--        Seq     (expr, expr)         |
--        Skip                         |
--        Read    (string)             |
--        Write   (expr)               |
--        If      (expr, expr, expr)   |
--        While   (expr, expr)         |
--        DoWhile (expr, expr)         |
--        Var     (string)             |
--        Ref     (string)             |
--        Const   (int)                |
--        Binop   (string, expr, expr) |
--        Ignore  (expr)

fun unref (v, [s, w]) {
  case v of
    Lvalue(x) -> s(x)
  | Rvalue(x) -> x
  | _ -> failure("unexpected value in unref: %s\n", v.string)
  esac
}

fun ref (v) {
  case v of
    Lvalue(x) -> x
  | _ -> failure("unexpected value in ref: %s\n", v.string)
  esac
}

-- Evaluates a list of expressions, properly threading a configurations.
-- Returns the final configuration and the list of values
fun evalList (c, exprs) {
  case foldl (fun ([c, vals], e) {
                case eval (c, e) of
                  [c, v] -> [c, v : vals]
                esac
              },
              [c, {}],
              exprs) of
    [c, vals] -> [c, reverse (vals)]
  esac
}

fun eval (c@[s, w], expr) {
  -- printf("eval: %s\n", expr.string);
  case expr of 
    Assn (l, r) -> 
      let [cl, vl] = eval(c, l) in
      let [[sr, wr], vr] = eval(cl, r) in
      let vr = unref(vr, [sr, wr]) in
      [[sr <- [vl.ref, vr], wr], Rvalue(vr)]
    | Seq (l, r) ->
      let [cl, _] = eval(c, l) in
      eval(cl, r)
    | Skip ->
      [c, Void]
    | Read (x) ->
      let [n, nw] = readWorld(w) in [[s <- [x, n], nw], Void]
    | Write (x) ->
      let [[s, w], v] = eval(c, x) in [[s, writeWorld(v.unref([s, w]), w)], Void]
    | If (e, tr, fls) ->
      let [ce, ve] = eval(c, e) in
      if unref(ve, ce) then
        eval(ce, tr) 
      else eval(ce, fls) fi
    | While (e, body) ->
      let [ce, ve] = eval(c, e) in
      if unref(ve, ce) then eval(ce, Seq(body, While(e, body)))
      else [ce, Void] fi
    | DoWhile (body, e) ->
      eval(c, Seq(body, While(e, body)))
    | Var (x) -> [c, Rvalue (s(x))]
    | Ref (x) -> [c, Lvalue (x)]
    | Binop (op, e1, e2) -> evalBinop(c, op, e1, e2)
    | Const (n) -> [c, Rvalue (n)]
    | Ignore (e) ->
      let [ce, _] = eval(c, e) in [ce, Void] 
    esac
}
fun evalBinop (c@[s, w], op, e1, e2) {
    let [ce1, ve1] = eval(c, e1) in
    let ve1 = unref(ve1, ce1) in
    let [ce2, ve2] = eval(ce1, e2) in
    let ve2 = unref(ve2, ce2) in
    case op of
       "+" -> [ce2, Rvalue (ve1 + ve2)]
    |  "-" -> [ce2, Rvalue (ve1 - ve2)]
    |  "*" -> [ce2, Rvalue (ve1 * ve2)]
    |  "/" -> [ce2, Rvalue (ve1 / ve2)]
    |  "%" -> [ce2, Rvalue (ve1 % ve2)]
    |  "==" -> [ce2, Rvalue (ve1 == ve2)]
    |  "!=" -> [ce2, Rvalue (ve1 != ve2)]
    |  "<" -> [ce2, Rvalue (ve1 < ve2)]
    |  "<=" -> [ce2, Rvalue (ve1 <= ve2)]
    |  ">" -> [ce2, Rvalue (ve1 > ve2)]
    |  ">=" -> [ce2, Rvalue (ve1 >= ve2)]
    |  "&&" -> [ce2, Rvalue (ve1 && ve2)]
    |  "!!" -> [ce2, Rvalue (ve1 !! ve2)]
    esac
}


-- Evaluates a program with a given input and returns an output
public fun evalExpr (input, expr) {
  case eval ([emptyState, createWorld (input)], expr) of
    [c, _] -> c.snd.getOutput
  esac
}
