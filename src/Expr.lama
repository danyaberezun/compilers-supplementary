-- Representing Void, if not a built-in type or keyword.
-- For now, we might need to define it or use a convention (e.g., a specific atom or integer).
-- Let's assume 'Void' is a conceptual placeholder for now, to be refined if needed.
-- In arnyyyy's code, it appears as a direct value. We'll use an atom for now if direct Void is not possible.
-- For simplicity in this step, we'll assume a global constant `VoidValue` could be defined if needed,
-- or rely on pattern matching to handle function return types where `Void' is implied.

-- As association map which maps operator strings to their functions
-- var ops_map = {
--   ["+" , infix + ],
--   ["-" , infix - ],
--   ["*" , infix * ],
--   ["/" , infix / ], // Division by zero will be handled by Lama's runtime or explicit checks if needed
--   ["%" , infix % ], // Modulo by zero will be handled by Lama's runtime or explicit checks if needed
--   ["==", infix ==],
--   ["!=", infix !=],
--   ["<" , infix < ],
--   ["<=", infix <=],
--   [">" , infix > ],
--   [">=", infix >=],
--   ["&&", infix &&],
--   ["!!", infix !!]
-- };

public fun evalOp (op_str, val1, val2) {
  case op_str of
    "+"  -> val1 + val2
  | "-"  -> val1 - val2
  | "*"  -> val1 * val2
  | "/"  -> if val2 == 0 then failure("Division by zero error\n") else val1 / val2 fi
  | "%"  -> if val2 == 0 then failure("Modulo by zero error\n") else val1 % val2 fi
  | "==" -> val1 == val2
  | "!=" -> val1 != val2
  | "<"  -> val1 < val2
  | "<=" -> val1 <= val2
  | ">"  -> val1 > val2
  | ">=" -> val1 >= val2
  | "&&" -> val1 && val2 
  | "!!" -> val1 !! val2
  | _    -> failure("Unsupported binary operator in evalOp: %s\n", op_str)
  esac
  -- Original approach using assoc, if `infix +` can be a function value:
  -- case assoc (ops_map, op_str) of
  --   Some (op_func) -> op_func (val1, val2)
  --   | None -> failure("Unsupported binary operator: %s\n", op_str)
  -- esac
}

-- The evaluator itself: takes a state and an expression,
-- returns integer value
--
-- An expression is represented by a data structure of the following shape:
-- expr = Var (string) | Const (int) | Binop (string, expr, expr) | Ref (string) | Assn (expr, expr) | Seq (expr, expr) | Skip | Read (string) | Write (expr) | If (expr, expr, expr) | While (expr, expr) | DoWhile (expr, expr) | Ignore (expr)

fun evalList (c, exprs) {
  case foldl (fun ([c, vals], e) {
                case eval (c, e) of
                  [c, v] -> [c, v : vals]
                esac
              },
              [c, {}],
              exprs) of
    [c, vals] -> [c, reverse (vals)]
  esac
}

fun eval (c@[st, w], expr) {
  case expr of
    Var (x)         -> [c, st (x)]
  | Const (n)       -> [c, n]
  | Ref (x)         -> [c, Ref (x)]
  | Skip            -> [c, Void]
  
  | Binop (op, l, r) ->
    case evalList (c, {l, r}) of
      [new_c, {vl, vr}] -> [new_c, evalOp (op, vl, vr)]
    esac

  | Read (x) -> 
    case readWorld (w) of
      [n, new_w] -> [[st <- [x, n], new_w], Void]
    esac

  | Write (e_node) ->
    case eval (c, e_node) of 
      [new_c@[new_st, new_w], v] -> [[new_st, writeWorld (v, new_w)], Void]
    esac

  | Assn (r_expr, e_val_expr) -> -- r_expr для L-value, e_val_expr для R-value
    case evalList (c, {r_expr, e_val_expr}) of
      [new_c@[new_st, new_w], {Ref (x_resolved), val_to_assign}] -> 
        [[new_st <- [x_resolved, val_to_assign], new_w], val_to_assign] -- Возвращаем присвоенное значение
      | [_, {other_type, _}] -> failure("LHS of assignment must be a variable reference (Ref), got: %s\n", "Non-Ref LHS")
    esac

  | Seq (e1, e2) ->
    case eval (c, e1) of
      [c_after_e1, _] -> eval (c_after_e1, e2)
    esac

  | If (e_cond, e_then, e_else) ->
    case eval (c, e_cond) of
      [c_after_cond, v_cond] -> 
        if v_cond != 0 then eval (c_after_cond, e_then) 
        else eval (c_after_cond, e_else) 
        fi
    esac

  | While (e_cond, e_body) ->
    case eval (c, e_cond) of
      [c_after_cond, v_cond] -> 
        if v_cond != 0 then
          case eval (c_after_cond, e_body) of
            [c_after_body, _] -> eval (c_after_body, While (e_cond, e_body)) -- Рекурсия, передаем обновленную c_after_body
          esac
        else
          [c_after_cond, Void] 
        fi
    esac
      
  | DoWhile (e_body, e_cond) ->
    case eval (c, e_body) of
      [c_after_body, _] ->
        case eval (c_after_body, e_cond) of
          [c_after_cond_check, v_cond] ->
            if v_cond != 0 then
              eval (c_after_cond_check, DoWhile (e_body, e_cond)) -- Рекурсия
            else [c_after_cond_check, Void] -- Условие ложно, выходим
            fi
        esac
    esac

  | Ignore (expr_node) -> 
    case eval (c, expr_node) of
      [new_c, _] -> [new_c, Void] -- Вычисляем, игнорируем результат, возвращаем Void
    esac
  | _ -> failure("Unsupported expression type in eval: %s\n", "unknown expression")
   esac
}

-- Public function to evaluate a program (an expression) with a given input
-- Returns the program's output (e.g., from Write expressions)
public fun evalExpr (input_list, top_level_expr) {
  case eval ([emptyState, createWorld (input_list)], top_level_expr) of
    [[_, final_world_obj], _] -> final_world_obj.getOutput
  esac
}