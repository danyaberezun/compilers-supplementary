-- Expression evaluator
import List;
import State;
import World;

-- As association map which maps "\otimes" into "\oplus"
var ops = {
  ["+" , infix + ],
  ["-" , infix - ],
  ["*" , infix * ],
  ["/" , infix / ],
  ["%" , infix % ],
  ["==", infix ==],
  ["!=", infix !=],
  ["<" , infix < ],
  ["<=", infix <=],
  [">" , infix > ],
  [">=", infix >=],
  ["&&", infix &&],
  ["!!", infix !!]
};

-- The evaluator for infix operators: takes an operator as a string
-- and two operand values, and returns the result
public fun evalOp (op, l, r) {
  case assoc (ops, op) of
    Some (f) -> f (l, r)
  esac
}

-- Evaluates an expression "expr" in a configuration "c".
-- A configuration is a pair of a state "s" and a world "w".
-- Returns a final configuration (if any)
--
-- A expression is represented by a data structure of the following shape:
--
-- expr = Assn    (expr, expr)         |
--        Seq     (expr, expr)         |
--        Skip                         |
--        Read    (string)             |
--        Write   (expr)               |
--        If      (expr, expr, expr)   |
--        While   (expr, expr)         |
--        DoWhile (expr, expr)         |
--        Var     (string)             |
--        Ref     (string)             |
--        Const   (int)                |
--        Binop   (string, expr, expr) |
--        Ignore  (expr)
public fun showExpr (expr) {
  case expr of
    Assn (e1, e2)     -> sprintf ("(%s) := %s", showExpr (e1), showExpr (e2))
  | Seq (e1, e2)      -> sprintf ("%s; %s", showExpr (e1), showExpr (e2))
  | Skip              -> "skip"
  | Read (s)          -> sprintf ("read(%s)", s)
  | Write (e)         -> sprintf ("write(%s)", showExpr (e))
  | If (cond, tb, eb) -> sprintf ("if %s then\n%s\nelse\n%s\nfi", showExpr (cond), showExpr (tb), showExpr (eb))
  | While (cond, bd)  -> sprintf ("while %s do\n%s\nod", showExpr (cond), showExpr (bd))
  | DoWhile (cond, bd)-> sprintf ("do\n%s\nwhile %s od", showExpr (bd), showExpr (cond))
  | Var (x)           -> x
  | Ref (x)           -> x
  | Const (n)         -> sprintf ("%d", n)
  | Binop (s, e1, e2) -> sprintf ("%s %s %s", showExpr (e1), s, showExpr (e2))
  | Ignore (e)        -> showExpr (e)
  esac
}

-- val = Int (n) |
--       Ref (x) |
--       None
fun showVal (v) {
  case v of
    Int (n) -> sprintf ("%d", n)
  | Ref (x) -> sprintf ("&%s", x)
  | None    -> "none"
  esac
}

-- Evaluates a list of expressions, properly threading a configurations.
-- Returns the final configuration and the list of values
fun evalList (c, exprs) {
  case foldl (fun ([c, vals], e) {
                case eval (c, e) of
                  [c, v] -> [c, v : vals]
                esac
              },
              [c, {}],
              exprs) of
    [c, vals] -> [c, reverse (vals)]
  esac
}

-- Takes a configuration c = [s(tate), w(orld)] and an expression
-- Returns [c, v] - final configuration and computation result
fun eval (c@[s, w], expr) {
  case expr of
    Assn (e1, e2) ->
      let [[s, w], v] = eval (c, e2) in
        let [[s, w], assnV] = eval ([s, w], e1) in
          case assnV of
            Ref (x) ->
              case v of
                Int (n) -> [[s <- [x, n], w], Int (n)]
              | _       -> failure ("Only int/bool variables are supported\n")
              esac
          | _       -> failure ("Expression %s is not an lvalue", showExpr (e1))
          esac
  | Seq (e1, e2) ->
      let [c, _] = eval (c, e1) in eval (c, e2)
  | Skip -> [[s, w], None]
  | Read (Ref (x)) ->
      let [n, w] = readWorld (w) in
        [[s <- [x, n], w], None]
  | Write (e) ->
      let [[s, w], v] = eval (c, e) in
        case v of
          Int (n) -> [[s, writeWorld (n, w)], None]
        | v       -> failure ("Expected int at %s, got %s", showExpr (e), showVal (v))
        esac
  | If (cond, tb, eb) ->
      let [[s, w], condV] = eval (c, cond) in
        case condV of
          Int (condN) ->
            if condN == 0 then
              eval ([s, w], eb)
            else
              eval ([s, w], tb)
            fi
        | _           -> failure ("Expected int at %s, got %s", showExpr (cond), showVal (condV))
        esac
  | While (cond, bd) ->
      let [[s, w], condV] = eval (c, cond) in
        case condV of
          Int (condN) ->
            if condN == 0 then
              [[s, w], None]
            else
              let [[s, w], bdV] = eval ([s, w], bd) in
                case bdV of
                  None -> eval ([s, w], While (cond, bd))
                | _    -> failure ("While loop body should evaluate to none")
                esac
            fi
        | _           -> failure ("Expected int at %s, got %s", showExpr (cond), showVal (condV))
        esac
  | DoWhile (cond, bd) -> eval (c, Seq (bd, While (cond, bd)))
  | Var (x) -> [[s, w], Int (s (x))]
  | Ref (x) -> [[s, w], Ref (x)]
  | Const (n) -> [[s, w], Int (n)]
  | Binop (op, lhs, rhs) ->
      let [c, lhsV] = eval (c, lhs) in
        case lhsV of
          Int (lhsN) ->
            let [c, rhsV] = eval (c, rhs) in
              case rhsV of
                Int (rhsN) ->
                  [c, Int (evalOp (op, lhsN, rhsN))]
              | _ -> failure ("Expected int at %s, got %s", showExpr (rhs), showVal (rhsV))
              esac
        | _ -> failure ("Expected int at %s, got %s", showExpr (lhs), showVal (lhsV))
        esac
  | Ignore (e) ->
    let [[s, w], _] = eval (c, e) in
      [[s, w], None]
  | _ -> failure ("Invalid expression")
  esac
}


-- Evaluates a program with a given input and returns an output
public fun evalExpr (input, expr) {
  case eval ([emptyState, createWorld (input)], expr) of
    [c, _] -> c.snd.getOutput
  esac
}
