-- Expression evaluator
import List;
import State;

-- The evaluator self: takes a state and an expression,
-- returns integer value
--
-- An expression is represented by a data structure of the following shape:
--
-- expr = Var   (string)             |
--        Const (int)                |
--        Binop (string, expr, expr)
public fun evalExpr (st, expr) {
  case expr of 
	  Var (x)                 -> st (x) |
    Const (n)               -> n      |
    Binop (op, left, right) -> evalOp (op, evalExpr(st, left), evalExpr(st, right))
  esac
}

fun evalOp (op, left, right) {
  case op of 
	  "+"   -> left + right   |
    "-"   -> left - right   |
    "*"   -> left * right   |
    "/"   -> left / right   |
    "%"   -> left % right   |
    "=="  -> left == right  |
    "!="  -> left != right  |
    ">"   -> left >  right  |
    "<"   -> left <  right  |
    ">="  -> left >= right  |
    "<="  -> left <= right  |
    "&&"  -> left && right  |
    "!!"  -> left !! right
  esac
}
