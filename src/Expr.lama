-- Expression evaluator
import List;
import State;

public fun runop(op, l, r) {
   --printf("oooo aa <%s, %d, %d>\n", op, l, r);
   --failure("helicopter <%s>", op);
   case op of 
     "*" -> l * r
   | "+" -> l + r 
   | "-" -> l - r
   | "/" -> l / r
   | "!!" -> l !! r
   | "%" -> l % r
   | "&&" -> l && r
   | "==" -> l == r
   | "!=" -> l != r
   | ">" -> l > r
   | "<" -> l < r
   | ">=" -> l >= r
   | "<=" -> l <= r 
   | _    -> 239
   esac
}


-- The evaluator itself: takes a state and an expression,
-- returns integer value
--
-- An expression is represented by a data structure of the following shape:
--
-- expr = Var   (string)             |
--        Const (int)                |
--        Binop (string, expr, expr)
public fun evalExpr (st, expr) {
   case expr of
      Var (x)         -> st(x)
   |  Const (n)       -> n
   |  Binop (s, l, r) -> runop(s, evalExpr(st, l), evalExpr(st, r))
   esac
}