-- Expression evaluator

import List;
import State;


-- The evaluator itself: takes a state and an expression,
-- returns integer value
--
-- An expression is represented by a data structure of the following shape:
--
-- expr = Var   (string)             |
--        Const (int)                |
--        Binop (string, expr, expr)

public fun evalExpr (st, expr) {
   case expr of
     Var(v)                    -> st(v)
   | Const(c)                  -> c
   | Binop("+",  expr1, expr2) -> evalExpr(st, expr1) +  evalExpr(st, expr2)
   | Binop("-",  expr1, expr2) -> evalExpr(st, expr1) -  evalExpr(st, expr2)
   | Binop("*",  expr1, expr2) -> evalExpr(st, expr1) *  evalExpr(st, expr2)
   | Binop("/",  expr1, expr2) -> evalExpr(st, expr1) /  evalExpr(st, expr2)
   | Binop("%",  expr1, expr2) -> evalExpr(st, expr1) %  evalExpr(st, expr2)
   | Binop("<",  expr1, expr2) -> if evalExpr(st, expr1) < evalExpr(st, expr2) then 1 else 0 fi
   | Binop(">",  expr1, expr2) -> if evalExpr(st, expr1) > evalExpr(st, expr2) then 1 else 0 fi
   | Binop("<=", expr1, expr2) -> if evalExpr(st, expr1) <= evalExpr(st, expr2) then 1 else 0 fi
   | Binop(">=", expr1, expr2) -> if evalExpr(st, expr1) >= evalExpr(st, expr2) then 1 else 0 fi
   | Binop("==",  expr1, expr2) -> if evalExpr(st, expr1) == evalExpr(st, expr2) then 1 else 0 fi
   | Binop("!=", expr1, expr2) -> if evalExpr(st, expr1) != evalExpr(st, expr2) then 1 else 0 fi
   | Binop("&&", expr1, expr2) -> if (evalExpr(st, expr1) && evalExpr(st, expr2)) then 1 else 0 fi
   | Binop("||", expr1, expr2) -> if evalExpr(st, expr1) != 0 then 1
                                  else if evalExpr(st, expr2) != 0 then 1 else 0 fi
                                  fi
   esac
}