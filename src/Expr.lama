-- Expression evaluator

import List;
import State;
import World;

-- As association map which maps "\otimes" into "\oplus"
var ops = {
  ["+" , infix + ],
  ["-" , infix - ],
  ["*" , infix * ],
  ["/" , infix / ],
  ["%" , infix % ],
  ["==", infix ==],
  ["!=", infix !=],
  ["<" , infix < ],
  ["<=", infix <=],
  [">" , infix > ],
  [">=", infix >=],
  ["&&", infix &&],
  ["!!", infix !!]
};

public fun evalOp (op, l, r) {
  case assoc (ops, op) of
    Some (f) -> f (l, r)
  esac
}

fun eval (c@[s, w], expr) {
  case expr of
    Skip -> [c, 0]
  | Const (n) -> [c, n]
  | Var (x) -> [c, s (x)]
  | Ref (x) -> [c, x]
  | Ignore (e) ->
      case eval (c, e) of
        [c, _] -> [c, 0]
      esac
  | Binop (op, l, r) ->
      case eval (c, l) of
        [c, lv] ->
          case eval (c, r) of
            [c, rv] -> [c, evalOp (op, lv, rv)]
          esac
      esac
  | Assn (l, r) ->
      case eval (c, l) of
        [[s, w], x] ->
          case eval ([s, w], r) of
            [[s, w], v] -> [[s <- [x, v], w], v]
          esac
      esac
  | Seq (l, r) ->
      case eval (c, l) of
        [c, _] -> eval (c, r)
      esac
  | Read (x) ->
      case readWorld (w) of
        [v, w] -> [[s <- [x, v], w], v]
      esac
  | Write (e) ->
      case eval (c, e) of
        [[s, w], v] -> [[s, writeWorld (v, w)], v]
      esac
  | If (e, t, f) ->
      case eval (c, e) of
        [c, v] -> if v != 0 then eval (c, t) else eval (c, f) fi
      esac
  | While (e, body) ->
      case eval (c, e) of
        [c, v] ->
          if v != 0
          then case eval (c, body) of [c, _] -> eval (c, expr) esac
          else [c, 0]
          fi
      esac
  | DoWhile (body, e) ->
      case eval (c, body) of
        [c, _] ->
          case eval (c, e) of
            [c, v] -> if v != 0 then eval (c, expr) else [c, 0] fi
          esac
      esac
  esac
}

public fun evalExpr (input, expr) {
  case eval ([emptyState, createWorld (input)], expr) of
    [c, _] -> c.snd.getOutput
  esac
}
