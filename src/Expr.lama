-- Expression evaluator

import List;
import State;


public fun evalBinop(op, val1, val2) {
   case op of
        "+" -> val1 + val2
      | "-" -> val1 - val2
      | "*" -> val1 * val2
      | "/" -> val1 / val2
      | "%" -> val1 % val2
      | "<" -> val1 < val2
      | ">" -> val1 > val2
      | "<=" -> val1 <= val2
      | ">=" -> val1 >= val2
      | "==" -> val1 == val2
      | "!=" -> val1 != val2
      | "&&" -> val1 && val2
      | "!!" -> val1 !! val2
   esac
}

-- The evaluator itself: takes a state and an expression,
-- returns integer value
--
-- An expression is represented by a data structure of the following shape:
--
-- expr = Var   (string)             |
--        Const (int)                |
--        Binop (string, expr, expr)

public fun evalExpr (st, expr) {
   case expr of
      Var (x) -> st(x)
      | Const (n) -> n
      | Binop (op, expr1, expr2) -> 
         let val1 = evalExpr(st, expr1) in
         let val2 = evalExpr(st, expr2) in
         evalBinop(op, val1, val2)
   esac
}
