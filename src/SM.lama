-- Stack machine.
import Ref;
import Array;
import List;
import Fun;
import Collection;
import World;
import State;
import Parser;
import Lexer;
import Expr;
import Builtins;
import Buffer;

-- Stack code printer. Takes a list of SM instructions, return its
-- string representation.
public fun showSMInsn (i) {
   -- Shows a location (a reference to function argument, local or global variable)
   fun showLoc (d) {
      case d of
        Arg(i) -> sprintf("arg[%d]", i)
      | Loc(i) -> sprintf("loc[%d]", i)
      | Glb(x) -> x
      esac
   }
   
   case i of
     BINOP(s)       -> sprintf("BINOP %s", s)
   | LD(x)          -> sprintf("LD %s", showLoc(x))
   | LDA(x)         -> sprintf("LDA %s", showLoc(x))
   | ST(x)          -> sprintf("ST %s", showLoc(x))
   | STI            -> "STI"
   | CONST(n)       -> sprintf("CONST %d", n)
   | LABEL(s)       -> sprintf("LABEL %s", s)
   | JMP(l)         -> sprintf("JMP %s", l)
   | CJMP(c, l)     -> sprintf("CJMP %s, %s", c, l)
   | CALL(f, n)     -> sprintf("CALL %s, %d", f, n)
   | BEGIN(f, a, l) -> sprintf("BEGIN %s, %d, %d", f, a, l)
   | GLOBAL(x)      -> sprintf("GLOBAL %s", x)
   | END            -> sprintf("END")
   | DUP            -> "DUP"
   | DROP           -> "DROP"
   | STRING(s)      -> sprintf("STRING ""%s""", s)
   | ARRAY(n)       -> sprintf("ARRAY %d", n)
   | SEXP(t, n)     -> sprintf("SEXP %s %d", t, n)
   | STA            -> "STA"
   | ELEM           -> "ELEM"
   | BUILTIN(f, n)  -> sprintf("BUILTIN %s, %d", f, n)
   esac
}
public fun showSM (prg) {
   map(fun (i) {showSMInsn(i) ++ "\n"}, prg).stringcat
}
fun isBuiltin (name) {
   case name of
     "read"   -> true
   | "write"  -> true
   | "length" -> true
   | _        -> false
   esac
}
-- Evaluation environment: keeps a mapping between labels and (sub)programs
fun initEvalEnv (insns) {
   var map = fix(fun (rec) {
                           fun ([m, insns]) {
                              case insns of
                                {}             -> m
                              | LABEL(lab): tl -> rec([addMap(m, lab, insns), tl])
                              | _: tl          -> rec([m, tl])
                              esac
                           }
                        }) $ [emptyMap(compare), insns];
   
   [fun (l) {
       case findMap(map, l) of
         Some(insns) -> insns
       esac
    }]
}
-- Accessor function
fun fromLabel (env, lab) {
   env[0](lab)
}
-- Stack machine interpreter. Takes an environment, a world and a program,
-- returns a final output
fun eval (env, w, insns) {
   -- Global state maps names of global variables to values
   var globalState = ref(fun (x) {error(sprintf("name ""%s"" is undefined", x), getLoc(x))});
   -- Make a fresh local state: a pair of arrays for arguments and local variables;
   -- takes the numbers of arguments and local variables respectively
   fun makeState (a, l) {
      [initArray(a, fun (_) {0}), initArray(l, fun (_) {0})]
   }
   -- Lookups a location in local/global states
   fun lookup ([args, locs], loc) {
      case loc of
        Arg(i) -> args[i]
      | Loc(i) -> locs[i]
      | Glb(x) -> deref(globalState)(x)
      esac
   }
   -- Assigns a value to a location
   fun assign ([args, locs], loc, vl) {
      case loc of
        Arg(i) -> args[i] := vl
      | Loc(i) -> locs[i] := vl
      | Glb(x) -> var g = deref(globalState); globalState ::= fun (y) {if compare(x, y) == 0 then vl else g(y) fi}
      esac
   }
   fun readElem (a, i) {
      case a of
        Sexp(_, arr) -> arr[i]
      | _            -> a[i]
      esac
   }
   fun writeElem (a, i, v) {
      case a of
        Sexp(_, arr) -> arr[i] := v
      | _            -> a[i] := v
      esac;
      v
   }
   -- Takes n positions from the list, retursn a pair: the remaining list and the taken
   -- sublist
   fun take (list, n) {
      fun inner (n, acc, list) {
         if n == 0 then [list, acc] else inner(n - 1, list.hd : acc, list.tl) fi
      }
      
      inner(n, {}, list)
   }
   fun bindArgs (state, src, n) {
      if n == 0 then state
      else case src of
             v: tl -> assign(state, Arg(n - 1), v);
                      bindArgs(state, tl, n - 1)
           esac
      fi
   }
   -- Core interpreter: takes a configuration and a program, returns a configuration
   fun eval (c@[st, cst, s, w], insns) {
      -- printf("%s\n", insns.string);
      case insns of
        {}        -> c
      | insn: ins -> case insn of
                       CONST(n)       -> eval([n : st, cst, s, w], ins)
                     | LABEL(s)       -> eval(c, ins)
                     | STRING(sv)     -> eval([sv : st, cst, s, w], ins)
                     | LD(x)          -> eval([s.lookup(x) : st, cst, s, w], ins)
                     | LDA(x)         -> eval([x : st, cst, s, w], ins)
                     | ST(x)          -> case st of
                                           v: _ -> assign(s, x, v)
                                         esac;
                                         eval(c, ins)
                     | STI            -> case st of
                                           v: loc: tl -> assign(s, loc, v);
                                                         eval([v : tl, cst, s, w], ins)
                                         esac
                     | STA            -> case st of
                                           v: i: a: tl -> writeElem(a, i, v);
                                                          eval([v : tl, cst, s, w], ins)
                                         esac
                     | ELEM           -> case st of
                                           i: a: tl -> eval([readElem(a, i) : tl, cst, s, w], ins)
                                         esac
                     | ARRAY(n)       -> case take(st, n) of
                                           [tl, vs] -> eval([listArray(vs) : tl, cst, s, w], ins)
                                         esac
                     | SEXP(tag, n)   -> case take(st, n) of
                                           [tl, vs] -> eval([Sexp(tag, listArray(vs)) : tl, cst, s, w], ins)
                                         esac
                     | BUILTIN(f, n)  -> case take(st, n) of
                                           [tl, vs] -> case evalBuiltin(f, vs, w) of
                                                         [v, w1] -> eval([v : tl, cst, s, w1], ins)
                                                       esac
                                         esac
                     | BINOP(op)      -> let w2: w1: tail = st in eval([evalOp(op, w1, w2) : tail, cst, s, w], ins)
                     | DUP            -> let x: tail = st in eval([x : x : tail, cst, s, w], ins)
                     | DROP           -> let _: tail = st in eval([tail, cst, s, w], ins)
                     | GLOBAL(x)      -> assign(s, Glb(x), 0);
                                         eval(c, ins)
                     | JMP(l)         -> eval(c, fromLabel(env, l))
                     | CJMP(c, l) -> let w1: tail = st in
                                            let todo = case c of
                                                         "z"  -> if w1 == 0 then fromLabel(env, l) else ins fi
                                                       | "nz" -> if w1 == 0 then ins else fromLabel(env, l) fi
                                                       esac in eval([tail, cst, s, w], todo)
                     | CALL(f, n)     -> case take(st, n) of
                                           [outer, args] -> eval([args.reverse, Stackframe(outer, s, ins) :
                                                                             cst, makeState(0, 0), w], env.fromLabel(f))
                                         esac
                     | BEGIN(_, a, l) -> var fresh = makeState(a, l);
                                         
                                         bindArgs(fresh, st, a);
                                         eval([{}, cst, fresh, w], ins)
                     | END            -> case cst of
                                           Stackframe(outer, s1, ret): cst1 -> eval([st +++ outer, cst1, s1, w], ret)
                                         esac
                     esac
      esac
   }
   
   eval([{}, {Stackframe({}, makeState(0, 0), {})}, makeState(0, 0), w], insns)[3].getOutput
}
-- Runs a stack machine for a given input and a given program, returns an output
public fun evalSM (input, insns) {
   eval(initEvalEnv(insns), createWorld(input), insns)
}
-- Compilation environment: generates labels
fun makeCompEnv (nLabels, scopeDepth, state, nLocals, nArgs, functions) {
   -- Generates a new label
   fun genLabel () {
      [sprintf("L%d", nLabels), makeCompEnv(nLabels + 1, scopeDepth, state, nLocals, nArgs, functions)]
   }
   -- Adds a new function 
   fun rememberFun (fLabel, args, body) {
      makeCompEnv(nLabels, scopeDepth, state, nLocals, nArgs, Fun(fLabel, args, body, state) : functions)
   }
   -- Enters a local scope
   fun beginScope () {
      makeCompEnv(nLabels, scopeDepth + 1, enterScope(state), nLocals, nArgs, functions)
   }
   -- Leaves a local scope
   fun endScope () {
      makeCompEnv(nLabels, scopeDepth - 1, leaveScope(state), nLocals, nArgs, functions)
   }
   -- Adds an argument for the current function
   fun addArg (name) {
      makeCompEnv(nLabels, scopeDepth, addName(state, name, Arg(nArgs)), nLocals, nArgs + 1, functions)
   }
   -- Adds a local variable for the current function
   fun addVar (name) {
      if isGlobal() then makeCompEnv(nLabels, scopeDepth, addName(state, name, Glb(name)), nLocals, nArgs, functions)
      else makeCompEnv(nLabels, scopeDepth, addName(state, name, Loc(nLocals)), nLocals + 1, nArgs, functions)
      fi
   }
   -- Adds a binding for a function
   fun addFun (name, fLabel, nargs) {
      makeCompEnv(nLabels, scopeDepth, addName(state, name, Fun(fLabel, nargs)), nLocals, nArgs, functions)
   }
   -- Enters a function
   fun beginFun (state) {
      makeCompEnv(nLabels, 2, enterFunction(state), 0, 0, functions)
   }
   -- Get functions and empty functions list
   fun getFuns () {
      [functions, makeCompEnv(nLabels, scopeDepth, state, nLocals, nArgs, {})]
   }
   -- Lookups a name of a variable
   fun lookupVar (name) {
      case lookup(state, name) of
        Fun(_, _) -> error(sprintf("the name ""%s"" does not designate a variable", name), getLoc(name))
      | x         -> x
      esac
   }
   -- Lookups a name of a function
   fun lookupFun (name) {
      case lookup(state, name) of
        x@Fun(_, _) -> x
      | _           -> error(sprintf("the name ""%s"" does not designate a function", name), getLoc(name))
      esac
   }
   -- Gets the number of local variables
   fun getLocals () {
      nLocals
   }
   -- Generates an intrinsic function name
   fun genFunLabel (name) {
      if isGlobal() then [sprintf("L%s", name), makeCompEnv(nLabels, scopeDepth, state, nLocals, nArgs, functions)]
      else [sprintf("L%s_%d", name, nLabels), makeCompEnv(nLabels + 1, scopeDepth, state, nLocals, nArgs, functions)]
      fi
   }
   -- Checks if the current scope is a global
   fun isGlobal () {
      scopeDepth == 2
   }
   
   [genLabel,
    rememberFun,
    beginScope,
    endScope,
    addArg,
    addVar,
    beginFun,
    getFuns,
    lookupVar,
    lookupFun,
    getLocals,
    genFunLabel,
    addFun,
    isGlobal]
}
-- Initialize a new compilation environment
fun initCompEnv () {
   makeCompEnv(0, 0, emptyState(), 0, 0, {})
}
-- Accessor functions
fun genLabel (env) {
   env[0]()
}
fun rememberFun (env, name, args, body) {
   env[1](name, args, body)
}
fun beginScope (env) {
   env[2]()
}
fun endScope (env) {
   env[3]()
}
fun addArg (env, name) {
   env[4](name)
}
fun addVar (env, name) {
   env[5](name)
}
fun beginFun (env, state) {
   env[6](state)
}
fun getFuns (env) {
   env[7]()
}
fun lookupVar (env, name) {
   env[8](name)
}
fun lookupFun (env, name) {
   env[9](name)
}
fun getLocals (env) {
   env[10]()
}
fun genFunLabel (env, name) {
   env[11](name)
}
fun addFun (env, name, fLabel, nargs) {
   env[12](name, fLabel, nargs)
}
fun isGlobal (env) {
   env[13]()
}
-- Helper function: generates n labels
fun genLabels (env, n) {
   fun inner (env, n) {
      if n == 0 then {env}
      else case genLabel(env) of
             [lab, env] -> lab : inner(env, n - 1)
           esac
      fi
   }
   
   listArray(inner(env, n))
}
-- Helper function: adds a bunch of arguments
fun addArgs (env, names) {
   foldl(fun (env, name) {addArg(env, name)}, env, names)
}
-- Helper function: adds a bunch of locals
fun addVars (env, names) {
   foldl(fun (env, name) {addVar(env, name)}, env, names)
}
fun addDefs (env, defs) {
   foldl(fun (env, def) {
        case def of
          Var(names)         -> addVars(env, names)
        | Fun(name, args, _) -> case genFunLabel(env, name) of
                                  [lab, env] -> addFun(env, name, lab, args.size)
                                esac
        esac
     }, env, defs)
}
fun rememberFuns (env, defs) {
   foldl(fun (env, def) {
        case def of
          Var(_)                -> env
        | Fun(name, args, body) -> case lookupFun(env, name) of
                                     Fun(lab, _) -> rememberFun(env, lab, args, body)
                                   esac
        esac
     }, env, defs)
}
fun globalDecls (env, defs) {
   if isGlobal(env)
   then foldl(fun (code, def) {
             case def of
               Var(names) -> foldl(fun (code, n) {code <+ GLOBAL(n)}, code, names)
             | _          -> code
             esac
          }, emptyBuffer(), defs)
   else emptyBuffer()
   fi
}
-- Compiles an expression into a stack machine code.
-- Takes an expression, returns a list of stack machine
-- instructions.
public fun compileSM (stmt) {
   fun label (lab, labUsed) {
      if labUsed then singletonBuffer(LABEL(lab)) else emptyBuffer() fi
   }
   infixl <<+> before <+> ([lab, env, e], trailing) {
      case env.genLabel of
        [eLab, env] -> case compile(eLab, env, e) of
                         [eUsed, env, eCode] -> [false, env, eCode <+> label(eLab, eUsed) <+> trailing]
                       esac
      esac
   }
   infixl <<+ before <+ (triple, insn) {triple <<+> singletonBuffer(insn)}
   fun compileMany (lab, env, exprs) {
      case exprs of
        {}    -> [false, env, emptyBuffer()]
      | {e}   -> compile(lab, env, e)
      | e: es -> case env.genLabel of
                   [eLab, env] -> case compile(eLab, env, e) of
                                    [eUsed, env, eCode] -> case compileMany(lab, env, es) of
                                                             [labUsed, env, esCode] -> [labUsed, env, eCode <+> label(eLab,
                                                                                                        eUsed) <+> esCode]
                                                           esac
                                  esac
                 esac
      esac
   }
   fun compile (lab, env, stmt) {
      -- printf("%s\n", stmt);
      case stmt of
        Skip                   -> [false, env, emptyBuffer()]
      | Var(x)                 -> [false, env, singletonBuffer(LD(env.lookupVar(x)))]
      | Ref(x)                 -> [false, env, singletonBuffer(LDA(env.lookupVar(x)))]
      | Const(n)               -> [false, env, singletonBuffer(CONST(n))]
      | Assn(Ref(x), r)        -> [lab, env, r] <<+ ST(env.lookupVar(x))
      | Assn(ElemRef(e, i), r) -> [lab, env, Seq(Seq(e, i), r)] <<+ STA
      | Assn(If(e, stmt1, stmt2), r) -> compile(lab, env, If(e, Assn(stmt1, r), Assn(stmt2, r)))
      | String(s)              -> [false, env, singletonBuffer(STRING(s))]
      | Binop(op, y, x)        -> let [lab, env, buff] = compile(lab, env, Seq(y, Seq(x, Skip))) in
                                     [false, env, buff <+ BINOP(op)]
      | Ignore(x)              -> let [lab, env, buff] = compile(lab, env, Seq(x, Skip)) in [false, env, buff <+ DROP]
      | Assn(l, r)             -> [lab, env, Seq(l, r)] <<+ STI
      | Elem(e, i)             -> [lab, env, Seq(e, i)] <<+ ELEM
      | ElemRef(e, i)          -> [lab, env, Seq(e, i)]
      | Array(es)              -> case env.genLabel of
                                    [argsLab, env] -> let [argsUsed, env, ac] = compileMany(argsLab, env, es) in
                                                         [false, env, ac <+> label(argsLab, argsUsed) <+ ARRAY(es.size)]
                                  esac
      | Sexp(tag, es)          -> case env.genLabel of
                                    [argsLab, env] -> let [argsUsed, env, ac] = compileMany(argsLab, env, es) in
                                                         [false, env, ac <+> label(argsLab, argsUsed) <+ SEXP(tag, es.size)]
                                  esac
      | Builtin(name, args)    -> case env.genLabel of
                                    [argsLab, env] -> let [argsUsed, env, ac] = compileMany(argsLab, env, args) in
                                                         [false, env, ac <+> label(argsLab,
                                                                        argsUsed) <+ BUILTIN(name, args.size)]
                                  esac
      | Seq(s1, s2)            -> let [s2Lab, env] = env.genLabel in
                                     let [s2LabUsed, env, s1Code] = compile(s2Lab, env, s1) in
                                        let [labUsed, env, s2Code] = compile(lab, env, s2) in
                                           [labUsed, env, s1Code <+> label(s2Lab, s2LabUsed) <+> s2Code]
      | If(e, stmt1, stmt2)    -> let [_, env, cond] = compile(lab, env, e) in
                                     let [elseLabel, env] = env.genLabel in
                                        let [labUsedThen, env, thenCode] = compile(lab, env, stmt1) in
                                           let [labUsedElse, env, elseCode] = compile(lab, env, stmt2) in
                                              [true,
                                               env,
                                               cond <+ CJMP("z",
                                                    elseLabel) <+> thenCode <+ JMP(lab) <+ LABEL(elseLabel) <+> elseCode]
      | While(e, stmt)         -> let [_, env, cond] = compile(lab, env, e) in
                                     let [condLabel, env] = env.genLabel in
                                        let [loopLabel, env] = env.genLabel in
                                           let [_, env, stmtCode] = compile(condLabel, env, stmt) in
                                              [false, env, singletonBuffer(JMP(condLabel)) <+>
                                                           singletonBuffer(LABEL(loopLabel)) <+>
                                                           stmtCode <+>
                                                           singletonBuffer(LABEL(condLabel)) <+>
                                                           cond <+
                                                           CJMP("nz", loopLabel)]
      | DoWhile(body, c)       -> case env.genLabel of
                                    [start, env] -> case env.genLabel of
                                                      [bEnd, env] -> let [bUsed, env, bc] = compile(bEnd, env, body) in
                                                                        let [_, env, ccBlock] = [start, env, c] <<+
                                                                                                CJMP("nz", start) in
                                                                           [false, env, singletonBuffer(LABEL(start)) <+>
                                                                                        bc <+>
                                                                                        label(bEnd, bUsed) <+>
                                                                                        ccBlock]
                                                    esac
                                  esac
      | Scope(defs, e)         -> let env = env.beginScope in
                                     let env = env.addDefs(defs) in
                                        let env = env.rememberFuns(defs) in
                                           let glob = env.globalDecls(defs) in
                                              let [used, env, ec] = compile(lab, env, e) in [used, env.endScope, glob <+> ec]
      | Call(name, args)       -> if isBuiltin(name)
                                  then case env.genLabel of
                                         [argsLab, env] -> let [argsUsed, env, ac] = compileMany(argsLab, env, args) in
                                                              [false, env, ac <+> label(argsLab,
                                                                             argsUsed) <+ BUILTIN(name, args.size)]
                                       esac
                                  else case env.lookupFun(name) of
                                         Fun(fLab, n) -> case env.genLabel of
                                                           [argsLab, env] -> let [argsUsed,
                                                                                  env,
                                                                                  ac] = compileMany(argsLab, env, args) in
                                                                                [false, env, ac <+> label(argsLab,
                                                                                               argsUsed) <+ CALL(fLab, n)]
                                                         esac
                                       esac
                                  fi
      esac
   }
   fun compileFunctions (env, main) {
      fun inner (env, funList) {
         case funList of
           {}                            -> case getFuns(env) of
                                              [{}, env] -> emptyBuffer()
                                            | [fs, env] -> inner(env, fs)
                                            esac
         | Fun(f, args, body, state): fs -> case genLabel(addArgs(beginFun(env, state), args)) of
                                              [endLab, env] -> case compile(endLab, env, body) of
                                                                 [endUsed, env, code] -> singletonBuffer(LABEL(f)) <+
                                                                                         BEGIN(f,
                                                                                               args.size,
                                                                                               getLocals(env)) <+>
                                                                                         code <+>
                                                                                         label(endLab, endUsed) <+
                                                                                         END <+>
                                                                                         inner(env, fs)
                                                               esac
                                            esac
         esac
      }
      
      main <+> inner(env, {})
   }
   var env0 = beginScope(initCompEnv());
   
   case env0.genLabel of
     [endLab, env] -> case compile(endLab, env, stmt) of
                        [endLabUsed, env, code] -> getBuffer $ compileFunctions(env,
                                                     singletonBuffer(LABEL("main")) <+ BEGIN("main",
                                                           0,
                                                           getLocals(env)) <+> code <+> label(endLab, endLabUsed) <+ END)
                      esac
   esac
}