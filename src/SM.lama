-- Stack machine.

import Array;
import List;
import Fun;
import Collection;
import World;
import State;
import Expr;
import Buffer;

-- Stack code printer. Takes a list of SM instructions, return its
-- string representation.
fun myReverse2(code,tw){
	case code of
		[]->tw
		|x:y->myReverse2(y,x:tw)
	esac
}
fun myReverse(code){
	myReverse2(code,[])
}
public fun showSMInsn (i) {
  case i of
    READ         -> sprintf ("READ")
  | WRITE        -> sprintf ("WRITE")
  | BINOP (s)    -> sprintf ("BINOP %s", s)
  | LD    (x)    -> sprintf ("LD %s", x)
  | ST    (x)    -> sprintf ("ST %s", x)
  | CONST (n)    -> sprintf ("CONST %d", n)
  | LABEL (s)    -> sprintf ("LABEL %s", s)
  | JMP   (l)    -> sprintf ("JMP %s", l)
  | CJMP  (c, l) -> sprintf ("CJMP %s, %s", c, l)
  esac
}
public fun showSM (prg) {
	case prg of
		[]->""
		|x:y->showSM(y)++showSMInsn(x)++"\n"
	esac
}
-- Evaluation environment: keeps a mapping between labels and (sub)programs
fun emptyEnvF (x) {
  failure ("undefined label ""%s""\n", x)
}
fun initEvalEnv (insns) {
	var f=emptyEnvF;
	var running=1;
	while running do
		case insns of
			[]->(running:=0)
			|x:y->
				case x of
					LABEL(lab) -> (f:=(f<-[lab,y]))
					|_->skip
				esac;
			insns:=y
		esac
	od;
	[f]
}

-- Accessor function
fun fromLabel (env, lab) {
  env [0] (lab)
}

-- Stack machine interpreter. Takes an environment, an SM-configuration and a program,
-- returns a final configuration
fun eval (env, [stack,state,[i,o]], insns) {
	var debug=0;
	var running=1;
	--printf(insns.string);
	--printf("\n");
	--write(state("res"));
	--printf("\n");
	--write(state("n"));
	--printf("\n");
	--write(state("k"));
	--printf("\n");
	while running do
		case insns of
			[]->(running:=0)
			|x:y-> case x of
				READ->case i of
					f:r->
						if debug then printf("READING\n") else Nop fi;
						stack:=(f:stack);
						i:=r;
						insns:=y
					esac
				|WRITE->case stack of
					f:r->
						if debug then printf("WRITING\n") else Nop fi;
						stack:=r;
						o:=(f:o);
						insns:=y
					esac
				|LD(v)->
					if debug then printf("LOADING %s\n",v) else Nop fi;
					stack:=(state(v):stack);
					insns:=y
				|ST(v)->
					if debug then printf("STORING %s\n",v) else Nop fi;
					case stack of
						f:r->
							stack:=r;
							state:=state<-[v,f];
							insns:=y
					esac
				|CONST(n)->
					if debug then printf("CONSTING %i\n",n) else Nop fi;
					stack:=(n:stack);
					insns:=y
				|BINOP(a)->
					if debug then printf("BINOPING %s\n",a) else Nop fi;
					case stack of
						s:f:r->
							stack:=(opEval(a,f,s):r);
							insns:=y
					esac
				|JMP(l)->
					if debug then printf("JUMPING %s\n",l) else Nop fi;
					insns:=env.fromLabel(l)
				|CJMP("nz",l)->
					if debug then printf("CHECKING nz\n") else Nop fi;
					case stack of
					f:r->
						if f
						then
							if debug then printf("JUMPING %s\n",l) else Nop fi;
							insns:=env.fromLabel(l)
						else
							if debug then printf("NOTJUMPING %s\n",l) else Nop fi;
							insns:=y
						fi
					esac
				|CJMP("z",l)->
					if debug then printf("CHECKING z\n") else Nop fi;
					case stack of
					f:r->
						if f
						then
							if debug then printf("NOTJUMPING %s\n",l) else Nop fi;
							insns:=y
						else
							if debug then printf("JUMPING %s\n",l) else Nop fi;
							insns:=env.fromLabel(l)
						fi
					esac
				|LABEL(l)->
					if debug then printf("MARKING %s\n",l) else Nop fi;
					insns:=y
			esac
		esac
	od;
	[stack,state,[i,o]]
}

-- Runs a stack machine for a given input and a given program, returns an output
public fun evalSM (input, insns) {
	var r=myReverse(insns);
	var env=initEvalEnv (r);
	--printf("PREEVAL\n");
	case eval (env, [{}, emptyState, createWorld (input)], r) of [stack,state,[i,o]] ->
		--printf("POSTEVAL\n");
		reverse(o)
	esac
}

-- Compilation environment: generates labels
fun makeCompEnv (n) {
  [fun () {
     [sprintf ("L%d", n), makeCompEnv (n+1)]
  }]
}

fun initCompEnv () {
  makeCompEnv (0)
}

-- Accessor function: generates one label
fun genLabel (env) {
  env [0] ()
}

-- Utility function: generates n labels
fun genLabels (env, n) {
  fun inner (env, n) {
    if n == 0
    then {env}
    else case env.genLabel of
           [lab, env] -> lab : inner (env, n-1)
         esac
    fi
  }

  listArray (inner (env, n))
}

-- Compiles an expression into a stack machine code.
-- Takes an expression, returns a list of stack machine instructions
fun merge(a,b){
	case a of
		[]->b
		|x:y->x:merge(y,b)
	esac
}
fun doCompileExpr(expr,tw){
	case expr of
		Var(a)->LD(a):tw
		|Const(a)->CONST(a):tw
		|Binop(a,b,c)->
			BINOP(a):doCompileExpr(c,doCompileExpr(b,tw))
	esac
}
fun compileExpr (expr) {
	doCompileExpr(expr,[])
}
-- Compiles a statement into a stack machine code.
-- Takes a statement, returns a list of stack machine
-- instructions.
public fun compileSM (stmt) {
  -- Generates SM code for a given statement
  --    lab  --- a label th go to after the statement is executed
  --    env  --- compilation environment
  --    stmt --- a statement to generate SM code for
  -- Returns a triple:
  --    boolean flag indicating if "lab" was used
  --    updated environment
  --    code buffer  
	fun doCompile (lab, env, stmt,tw) {
		case stmt of
			Skip->[false,env,tw]
			|Read(x)->[false,env,ST(x):READ:tw]
			|Write(e)->[false,env,WRITE:doCompileExpr(e,tw)]
			|Assn(x,e)->[false,env,ST(x):doCompileExpr(e,tw)]
			|Seq(s1,s2)->
				case env.genLabel of [s2Lab,env]->
					case doCompile(s2Lab,env,s1,tw) of [s2LabUsed,env,s1Code]->
						if s2LabUsed then
							doCompile(lab,env,s2,LABEL(s2Lab):s1Code)
						else
							doCompile(lab,env,s2,s1Code)
						fi
					esac
				esac
			|While(a,b)->
				case env.genLabel of [start,env] ->
					case doCompile(start,env,b,CJMP("z",lab):doCompileExpr(a,LABEL(start):tw)) of [_, env, code] ->
						[true,env,JMP(start):code]
					esac
				esac
			|If(a,b,c)->
				case env.genLabel of [ifbad,env]->
					case doCompile(lab,env,b,CJMP("z",ifbad):doCompileExpr(a,tw)) of [needB,env,codeB]->
					case doCompile(lab,env,c,LABEL(ifbad):JMP(lab):codeB) of [_,env,codeC]->
						[true,env,codeC]
					esac
					esac
				esac
			|DoWhile(a,b)->
				case env.genLabel of [start,env]->
				case env.genLabel of [end,env]->
				case doCompile(end,env,a,LABEL(start):tw) of
					[true,env,code]->[false,env,CJMP("nz",start):doCompileExpr(b,LABEL(end):code)]
					|[false,env,code]->[false,env,CJMP("nz",start):doCompileExpr(b,code)]
				esac
				esac
				esac
		esac
	}
	fun compile (lab, env, stmt) {
		doCompile(lab,env,stmt,[])
	}
	case initCompEnv ().genLabel of [endLab, env] ->
		case compile (endLab, env, stmt) of [endLabUsed, _, code] ->
			--printf("COMPILED!!!");
			--printf(code.string);
			if endLabUsed
				then LABEL(endLab):code
				else code
			fi
		esac
	esac
}
