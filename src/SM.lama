-- Stack machine.

import Array;
import List;
import Fun;
import Collection;
import World;
import State;
import Expr;
import Buffer;
import Fun;

-- Stack code printer. Takes a list of SM instructions, return its
-- string representation.
public fun showSMInsn (i) {
  case i of
    READ         -> "READ"
  | WRITE        -> "WRITE"
  | BINOP (s)    -> sprintf ("BINOP %s", s)
  | LD    (x)    -> sprintf ("LD %s", x)
  | LDA   (x)    -> sprintf ("LDA %s", x)
  | ST    (x)    -> sprintf ("ST %s", x)
  | STI          -> "STI"
  | CONST (n)    -> sprintf ("CONST %d", n)
  | LABEL (s)    -> sprintf ("LABEL %s", s)
  | JMP   (l)    -> sprintf ("JMP %s", l)
  | CJMP  (c, l) -> sprintf ("CJMP %s, %s", c, l)
  | DUP          -> "DUP"
  | DROP         -> "DROP"  
  esac
}

public fun showSM (prg) {
  map (fun (i) {showSMInsn (i) ++ "\n"}, prg).stringcat
}

-- Evaluation environment: keeps a mapping between labels and (sub)programs
fun initEvalEnv (insns) {
  var map =
    fix (fun (rec) {
          fun ([m, insns]) {
            case insns of
              {}               -> m
            | LABEL (lab) : tl -> rec ([addMap (m, lab, insns), tl])
            | _ : tl           -> rec ([m, tl])
            esac
          }
        }) $ [emptyMap (compare), insns];

  [fun (l) {
     case findMap (map, l) of Some (insns) -> insns esac
  }]
}

-- Accessor function
fun fromLabel (env, lab) {
  env [0] (lab)
}

-- Stack machine interpreter. Takes an environment, an SM-configuration and a program,
-- returns a final configuration
fun eval (env, c, insns) {
   case insns of
      {} -> c
   |  ins:iarr ->
      case c of
         [sk, st, w] ->
         case ins of
            READ -> eval(env, [readWorld(w).fst:sk, st, readWorld(w).snd], iarr)
         |  WRITE -> sprintf("%d\n", sk.hd);
               eval(env, [sk.tl, st, writeWorld(sk.hd, w)], iarr)
         |  BINOP(s) -> let sk = case s of
               "+" -> (sk.tl.hd + sk.hd):sk.tl.tl
            |  "-" -> (sk.tl.hd - sk.hd):sk.tl.tl
            |  "*" -> (sk.tl.hd * sk.hd):sk.tl.tl
            |  "/" -> (sk.tl.hd / sk.hd):sk.tl.tl
            |  "%" -> (sk.tl.hd % sk.hd):sk.tl.tl
            |  "==" -> (sk.tl.hd == sk.hd):sk.tl.tl
            |  "!=" -> (sk.tl.hd != sk.hd):sk.tl.tl
            |  "<" -> (sk.tl.hd < sk.hd):sk.tl.tl
            |  "<=" -> (sk.tl.hd <= sk.hd):sk.tl.tl
            |  ">" -> (sk.tl.hd > sk.hd):sk.tl.tl
            |  ">=" -> (sk.tl.hd >= sk.hd):sk.tl.tl
            |  "&&" -> (sk.tl.hd && sk.hd):sk.tl.tl
            |  "!!" -> (sk.tl.hd !! sk.hd):sk.tl.tl
            esac in
            eval(env, [sk, st, w], iarr)
         |  LD(x) -> eval(env, [st(x):sk, st, w], iarr)
         |  LDA(x) -> eval(env, [Lvalue(x):sk, st, w], iarr)
         |  ST(x) -> eval(env, [sk.tl, st<-[x, sk.hd], w], iarr)
         |  STI -> 
            case sk of
              v : Lvalue (x) : tl ->
              eval(env, [v:tl, st<-[x, v], w], iarr)
            esac
         |  CONST(n) -> eval(env, [n:sk, st, w], iarr)
         |  LABEL(n) -> eval(env, [sk, st, w], iarr)
         |  JMP(l) -> eval(env, [sk, st, w], fromLabel(env, l))
         |  CJMP(c, l) ->
            let cv = case c of
               "e" -> sk.hd == 0
            |  "ne" -> sk.hd != 0
            esac in
            if cv then
               eval(env, [sk.tl, st, w], fromLabel(env, l))
            else
               eval(env, [sk.tl, st, w], iarr)
            fi
          | DUP -> eval(env, [sk.hd:sk, st, w], iarr)
          | DROP -> eval(env, [sk.tl, st, w], iarr)
         esac
      esac
   esac
}

-- Runs a stack machine for a given input and a given program, returns an output
public fun evalSM (input, insns) {
  eval (initEvalEnv (insns), [{}, emptyState, createWorld (input)], insns)[2].getOutput
}

-- Compilation environment: generates labels
fun makeCompEnv (n) {
  [fun () {
     [sprintf ("L%d", n), makeCompEnv (n+1)]
  }]
}

fun initCompEnv () {
  makeCompEnv (0)
}

-- Accessor function: generates one label
fun genLabel (env) {
  env [0] ()
}

-- Utility function: generates n labels
fun genLabels (env, n) {
  fun inner (env, n) {
    if n == 0
    then {env}
    else case env.genLabel of
           [lab, env] -> lab : inner (env, n-1)
         esac
    fi
  }

  listArray (inner (env, n))
}

-- Compiles an expression into a stack machine code.
-- Takes an expression, returns a list of stack machine
-- instructions.
public fun compileSM (stmt) {
  fun label (lab, labUsed) {
    if labUsed
    then singletonBuffer (LABEL (lab))
    else emptyBuffer ()
    fi
  }
  
  fun compile (lab, env, stmt) {
    case stmt of
      Skip              -> [false, env, emptyBuffer ()]
    | Var    (x)        -> [false, env, singletonBuffer (LD (x))]
    | Ref    (x)        -> [false, env, singletonBuffer (LDA (x))]
    | Const  (n)        -> [false, env, singletonBuffer (CONST (n))]
    | Read   (x)        -> [false, env, singletonBuffer (READ) <+ ST(x)]
    | Write  (e) -> 
      let [s2Lab, env] = env.genLabel in
      let [s2LabUsed, env, s1Code] = compile(s2Lab, env, e) in
      [false, env, s1Code <+> label (s2Lab, s2LabUsed) <+ WRITE]
    | Assn   (x, e)     -> 
      let [xLab, env] = env.genLabel in
      let [xLabUsed, env, xCode] = compile(xLab, env, x) in
      let [eLab, env] = env.genLabel in
      let [eLabUsed, env, eCode] = compile(eLab, env, e) in
      [false, env, xCode <+> label (xLab, xLabUsed) <+> eCode <+> label (eLab, eLabUsed) <+ STI]
    | Seq (s1, s2) ->
      let [s2Lab, env] = env.genLabel in
      let [s2LabUsed, env, s1Code] = compile(s2Lab, env, s1) in
      let [labUsed, env, s2Code] = compile(lab, env, s2) in
      [labUsed, env, s1Code <+> label (s2Lab, s2LabUsed) <+> s2Code]
    | If (e, tb, fb) ->
      let [eLab, env] = env.genLabel in
      let [eLabUsed, env, eCode] = compile(eLab, env, e) in
      let [s2Lab, env] = env.genLabel in
      let [_, env, tcode] = compile(lab, env, tb) in
      let [_, env, fcode] = compile(lab, env, fb) in
      [true, env, eCode <+> label(eLab, eLabUsed) <+ CJMP("e", s2Lab) <+> tcode <+ JMP(lab) <+> label (s2Lab, true) <+> fcode]
    | While (e, rt) ->
      let [eLab, env] = env.genLabel in
      let [eLabUsed, env, eCode] = compile(eLab, env, e) in
      let [s2Lab, env] = env.genLabel in
      let [_, env, rcode] = compile(s2Lab, env, rt) in
      [true, env, label (s2Lab, true) <+> eCode <+> label(eLab, eLabUsed) <+ CJMP("e", lab) <+> rcode <+ JMP(s2Lab)]
    | DoWhile (rt, e) ->
      let [s2Lab, env] = env.genLabel in
      let [_, env, rcode] = compile(s2Lab, env, rt) in
      let [eLab, env] = env.genLabel in
      let [eLabUsed, env, eCode] = compile(eLab, env, e) in
      [false, env, label (s2Lab, true) <+> rcode <+> eCode <+> label(eLab, eLabUsed) <+ CJMP("ne", s2Lab)]
    | Binop (op, e1, e2) ->
      let [e1Lab, env] = env.genLabel in
      let [e1LabUsed, env, e1Code] = compile(e1Lab, env, e1) in
      let [e2Lab, env] = env.genLabel in
      let [e2LabUsed, env, e2Code] = compile(e2Lab, env, e2) in
      [false, env, e1Code <+> label(e1Lab, e1LabUsed) <+> e2Code <+> label(e2Lab, e2LabUsed) <+ BINOP(op)]
    | Ignore (e) ->
      let [eLab, env] = env.genLabel in
      let [eLabUsed, env, eCode] = compile(eLab, env, e) in
      [false, env, eCode <+> label(eLab, eLabUsed) <+ DROP]
    | _                 ->  failure ("compileSM not implemented\n")
    esac
  }

  case initCompEnv ().genLabel of
    [endLab, env] ->
       case compile (endLab, env, stmt) of
         [endLabUsed, _, code] -> getBuffer $ code <+> label (endLab, endLabUsed)
       esac
  esac
}
