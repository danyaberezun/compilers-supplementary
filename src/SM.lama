-- Stack machine.

import Array;
import List;
import Fun;
import Collection;
import World;
import State;
import Expr;
import Buffer;

-- Stack code printer. Takes a list of SM instructions, return its
-- string representation.
public fun showSMInsn (i) {
  case i of
    READ         -> "READ"
  | WRITE        -> "WRITE"
  | BINOP (s)    -> sprintf ("BINOP %s", s)
  | LD    (x)    -> sprintf ("LD %s", x)
  | LDA   (x)    -> sprintf ("LDA %s", x)
  | ST    (x)    -> sprintf ("ST %s", x)
  | STI          -> "STI"
  | CONST (n)    -> sprintf ("CONST %d", n)
  | LABEL (s)    -> sprintf ("LABEL %s", s)
  | JMP   (l)    -> sprintf ("JMP %s", l)
  | CJMP  (c, l) -> sprintf ("CJMP %s, %s", c, l)
  | DUP          -> "DUP"
  | DROP         -> "DROP"
  esac
}

public fun showSM (prg) {
  map (fun (i) {showSMInsn (i) ++ "\n"}, prg).stringcat
}

-- Evaluation environment: keeps a mapping between labels and (sub)programs
fun initEvalEnv (insns) {
  var map =
    fix (fun (rec) {
          fun ([m, insns]) {
            case insns of
              {}               -> m
            | LABEL (lab) : tl -> rec ([addMap (m, lab, insns), tl])
            | _ : tl           -> rec ([m, tl])
            esac
          }
        }) $ [emptyMap (compare), insns];
  
  [fun (l) {
     case findMap (map, l) of Some (insns) -> insns esac
  }]
}

-- Accessor function
fun fromLabel (env, lab) {
  env [0] (lab)
}

fun checkCond (cond, value) {
  case cond of
    "z"  -> value == 0
  | "nz" -> value != 0
  esac
}

-- Stack machine interpreter. Takes an environment, an SM-configuration and a program,
-- returns a final configuration
fun eval (env, c, insns) {
  case insns of
    {} -> c
  | last:ins ->
      let [st, s, w] = c in
      case last of
        READ ->
          let [el, w1] = readWorld (w) in
          eval (env, [el : st, s, w1], ins)
      | WRITE ->
          let el : tail = st in
          eval (env, [tail, s, writeWorld (el, w)], ins)
      | LD (x) ->
          eval (env, [s (x) : st, s, w], ins)
      | LDA (x) ->
          eval (env, [Addr (x) : st, s, w], ins)
      | ST (x) ->
          let el : tail = st in
          eval (env, [el : tail, s <- [x, el], w], ins)
      | STI ->
          let el : Addr (x) : tail = st in
          eval (env, [el : tail, s <- [x, el], w], ins)
      | CONST (n) ->
          eval (env, [n : st, s, w], ins)
      | BINOP (op) ->
          let y : x : tail = st in
          eval (env, [evalOp (op, x, y) : tail, s, w], ins)
      | LABEL (_) ->
          eval (env, c, ins)
      | JMP (lab) ->
          eval (env, c, fromLabel (env, lab))
      | CJMP (cond, lab) ->
          let value : tail = st in
          if checkCond (cond, value)
          then eval (env, [tail, s, w], fromLabel (env, lab))
          else eval (env, [tail, s, w], ins)
          fi
      | DUP ->
          let el : _ = st in
          eval (env, [el : st, s, w], ins)
      | DROP ->
          let _ : tail = st in
          eval (env, [tail, s, w], ins)
      esac
  esac
}

-- Runs a stack machine for a given input and a given program, returns an output
public fun evalSM (input, insns) {
  eval (initEvalEnv (insns), [{}, emptyState, createWorld (input)], insns)[2].getOutput
}

-- Compilation environment: generates labels
fun makeCompEnv (n) {
  [fun () {
     [sprintf ("L%d", n), makeCompEnv (n+1)]
  }]
}

fun initCompEnv () {
  makeCompEnv (0)
}

-- Accessor function: generates one label
fun genLabel (env) {
  env [0] ()
}

-- Utility function: generates n labels
fun genLabels (env, n) {
  fun inner (env, n) {
    if n == 0
    then {env}
    else case env.genLabel of
           [lab, env] -> lab : inner (env, n-1)
         esac
    fi
  }

  listArray (inner (env, n))
}

-- Compiles an expression into a stack machine code.
-- Takes an expression, returns a list of stack machine
-- instructions.
public fun compileSM (expr) {
  fun compile (env, expr) {
    case expr of
      Skip ->
        [env, emptyBuffer ()]
    | Const (n) ->
        [env, singletonBuffer (CONST (n))]
    | Var (x) ->
        [env, singletonBuffer (LD (x))]
    | Ref (x) ->
        [env, singletonBuffer (LDA (x))]
    | Ignore (e) ->
        case compile (env, e) of
          [env, code] -> [env, code <+ DROP]
        esac
    | Seq (e1, e2) ->
        case compile (env, e1) of
          [env, code1] ->
            case compile (env, e2) of
              [env, code2] -> [env, code1 <+> code2]
            esac
        esac
    | Read (x) ->
        [env, singletonBuffer (READ) <+ ST (x) <+ DROP]
    | Write (e) ->
        case compile (env, e) of
          [env, code] -> [env, code <+ DUP <+ WRITE]
        esac
    | Binop (op, l, r) ->
        case compile (env, l) of
          [env, lcode] ->
            case compile (env, r) of
              [env, rcode] -> [env, lcode <+> rcode <+ BINOP (op)]
            esac
        esac
    | Assn (l, r) ->
        case compile (env, l) of
          [env, lcode] ->
            case compile (env, r) of
              [env, rcode] -> [env, lcode <+> rcode <+ STI]
            esac
        esac
    | If (cond, thenExpr, elseExpr) ->
        case genLabels (env, 2) of
          [elseLab, endLab, env] ->
            case compile (env, cond) of
              [env, ccode] ->
                case compile (env, thenExpr) of
                  [env, tcode] ->
                    case compile (env, elseExpr) of
                      [env, ecode] ->
                        [env,
                         ccode <+ CJMP ("z", elseLab) <+>
                         tcode <+ JMP (endLab) <+ LABEL (elseLab) <+>
                         ecode <+ LABEL (endLab)]
                    esac
                esac
            esac
        esac
    | While (cond, body) ->
        case genLabels (env, 2) of
          [loopLab, endLab, env] ->
            case compile (env, cond) of
              [env, ccode] ->
                case compile (env, body) of
                  [env, bcode] ->
                    [env,
                     singletonBuffer (LABEL (loopLab)) <+>
                     ccode <+ CJMP ("z", endLab) <+>
                     bcode <+ JMP (loopLab) <+ LABEL (endLab)]
                esac
            esac
        esac
    | DoWhile (body, cond) ->
        case genLabel (env) of
          [loopLab, env] ->
            case compile (env, body) of
              [env, bcode] ->
                case compile (env, cond) of
                  [env, ccode] ->
                    [env,
                     singletonBuffer (LABEL (loopLab)) <+>
                     bcode <+> ccode <+ CJMP ("nz", loopLab)]
                esac
            esac
        esac
    esac
  }

  case compile (initCompEnv (), expr) of
    [_, code] -> getBuffer (code)
  esac
}
