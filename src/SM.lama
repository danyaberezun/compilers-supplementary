-- Stack machine.

import Array;
import List;
import Fun;
import Collection;
import World;
import State;
import Expr;
import Buffer;

-- Stack code printer. Takes a list of SM instructions, return its
-- string representation.
public fun showSMInsn (i) {
  case i of
    READ         -> sprintf ("READ")
  | WRITE        -> sprintf ("WRITE")
  | BINOP (s)    -> sprintf ("BINOP %s", s)
  | LD    (x)    -> sprintf ("LD %s", x)
  | ST    (x)    -> sprintf ("ST %s", x)
  | CONST (n)    -> sprintf ("CONST %d", n)
  | LABEL (s)    -> sprintf ("LABEL %s", s)
  | JMP   (l)    -> sprintf ("JMP %s", l)
  | CJMP  (c, l) -> sprintf ("CJMP %s, %s", c, l)
  esac
}

public fun showSM (prg) {
  map (fun (i) {showSMInsn (i) ++ "\n"}, prg).stringcat
}

-- Evaluation environment: keeps a mapping between labels and (sub)programs
fun initEvalEnv (insns) {
  var map =
    fix (fun (rec) {
          fun ([m, insns]) {
            case insns of
              {}               -> m
            | LABEL (lab) : tl -> rec ([addMap (m, lab, insns), tl])
            | _ : tl           -> rec ([m, tl])
            esac
          }
        }) $ [emptyMap (compare), insns];
  
  [fun (l) {
     case findMap (map, l) of Some (insns) -> insns esac
  }]
}

-- Accessor function
fun fromLabel (env, lab) {
  env [0] (lab)
}

fun smStep (env, c@[stack, st, w], insn, rest) {
  case insn of
    READ      ->
      case readWorld (w) of [v, w1] -> [[v : stack, st, w1], rest] esac
  | WRITE     ->
      case stack of
        x : stack1 -> [[stack1, st, writeWorld (x, w)], rest]
      esac
  | CONST (n) -> [[n : stack, st, w], rest]
  | LD    (x) -> [[st (x) : stack, st, w], rest]
  | ST    (x) ->
      case stack of
        v : stack1 -> [[stack1, st <- [x, v], w], rest]
      esac
  | BINOP (op) ->
      case stack of
        y : x : stack1 ->
          [[binop (op) (x, y) : stack1, st, w], rest]
      esac
  | LABEL (_) -> [c, rest]
  | JMP   (l) -> [c, fromLabel (env, l)]
  | CJMP  (cond, l) ->
      case stack of
        v : stack1 ->
          var c2 = [stack1, st, w];
          var go =
            case cond of
              "z"  -> v == 0
            | "nz" -> v != 0
            esac;
          if go then [c2, fromLabel (env, l)]
          else [c2, rest]
          fi
      esac
  esac
}

fun eval (env, c, insns) {
  case insns of
    {} -> c
  | insn : rest ->
      case smStep (env, c, insn, rest) of
        [c2, insns2] -> eval (env, c2, insns2)
      esac
  esac
}

-- Runs a stack machine for a given input and a given program, returns an output
public fun evalSM (input, insns) {
  eval (initEvalEnv (insns), [{}, emptyState, createWorld (input)], insns)[2].getOutput
}

-- Compilation environment: generates labels
fun makeCompEnv (n) {
  [fun () {
     [sprintf ("L%d", n), makeCompEnv (n+1)]
  }]
}

fun initCompEnv () {
  makeCompEnv (0)
}

-- Accessor function: generates one label
fun genLabel (env) {
  env [0] ()
}

-- Utility function: generates n labels
fun genLabels (env, n) {
  fun inner (env, n) {
    if n == 0
    then {}
    else case env.genLabel of
           [lab, env] -> lab : inner (env, n-1)
         esac
    fi
  }

  listArray (inner (env, n))
}

-- Compiles an expression into a stack machine code.
-- Takes an expression, returns a list of stack machine instructions
fun compileExpr (expr) {
  case expr of
    Const (n)        -> singletonBuffer (CONST (n))
  | Var   (x)        -> singletonBuffer (LD (x))
  | Binop (op, l, r) -> compileExpr (l) <+> compileExpr (r) <+> singletonBuffer (BINOP (op))
  esac
}

-- Compiles a statement into a stack machine code.
-- Takes a statement, returns a list of stack machine
-- instructions.
public fun compileSM (stmt) {
  -- Generates a buffer with an optional label
  --    lab     --- the name of the label
  --    labUsed --- a flag if the lebel is needed
  fun label (lab, labUsed) {
    if labUsed
    then singletonBuffer (LABEL (lab))
    else emptyBuffer ()
    fi
  }

  -- Generates SM code for a given statement
  --    lab  --- a label th go to after the statement is executed
  --    env  --- compilation environment
  --    stmt --- a statement to generate SM code for
  -- Returns a triple:
  --    boolean flag indicating if "lab" was used
  --    updated environment
  --    code buffer  
  fun compile (lab, env, stmt) {
    case stmt of
      Skip           -> [false, env, emptyBuffer ()]
    | Read  (x)      -> [false, env, singletonBuffer (READ) <+ ST (x)]
    | Write (e)      -> [false, env, compileExpr (e) <+ WRITE]
    | Assn  (x, e)   -> [false, env, compileExpr (e) <+ ST (x)]
    | Seq   (s1, s2) ->
        case env.genLabel of
          [s2Lab, env] ->
             case compile (s2Lab, env, s1) of
               [s2LabUsed, env, s1Code] ->
                  case compile (lab, env, s2) of
                    [labUsed, env, s2Code] -> [labUsed, env, s1Code <+> label (s2Lab, s2LabUsed) <+> s2Code]
                  esac
             esac
        esac
    | If (e, s1, s2) ->
        case env.genLabel of
          [lElse, env] ->
             case compile (lab, env, s2) of
               [u2, env, c2] ->
                  case compile (lab, env, s1) of
                    [_, env, c1] ->
                       [true, env,
                        compileExpr (e) <+ CJMP ("z", lElse) <+> c1 <+ JMP (lab) <+>
                        label (lElse, true) <+> c2]
                  esac
             esac
        esac
    | While (e, body) ->
        case env.genLabel of
          [lStart, env] ->
             case env.genLabel of
               [lCont, env] ->
                  case compile (lCont, env, body) of
                    [uB, env, cBody] ->
                       [true, env,
                        label (lStart, true) <+> compileExpr (e) <+ CJMP ("z", lab) <+> cBody <+>
                        label (lCont, uB) <+ JMP (lStart)]
                  esac
             esac
        esac
    | DoWhile (body, e) ->
        case env.genLabel of
          [lStart, env] ->
             case env.genLabel of
               [lGuard, env] ->
                  case compile (lGuard, env, body) of
                    [uG, env, cBody] ->
                       [false, env,
                        label (lStart, true) <+> cBody <+> label (lGuard, uG) <+> compileExpr (e) <+ CJMP ("nz", lStart)]
                  esac
             esac
        esac
    | For (init, cond, step, body) ->
        case env.genLabel of
          [lLoop, env] ->
             case env.genLabel of
               [lStep, env] ->
                  case env.genLabel of
                    [dummy, env] ->
                       case compile (dummy, env, init) of
                         [_, env, cInit] ->
                            case compile (lStep, env, body) of
                              [uB, env, cBody] ->
                                 case compile (lLoop, env, step) of
                                   [_, env, cStep] ->
                                      [true, env,
                                       cInit <+> label (lLoop, true) <+> compileExpr (cond) <+ CJMP ("z", lab) <+>
                                       cBody <+> label (lStep, uB) <+> cStep <+ JMP (lLoop)]
                                 esac
                            esac
                       esac
                  esac
             esac
        esac
    esac
  }  

  case initCompEnv ().genLabel of
    [endLab, env] ->
       case compile (endLab, env, stmt) of
         [endLabUsed, _, code] -> getBuffer $  code <+> label (endLab, endLabUsed)
       esac
  esac
}
