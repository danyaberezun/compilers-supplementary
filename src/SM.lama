-- Stack machine.

import Array;
import List;
import Fun;
import Collection;
import World;
import State;
import Expr;
import Buffer;
import Fun;

-- Stack code printer. Takes a list of SM instructions, return its
-- string representation.
public fun showSMInsn (i) {
  case i of
    READ         -> "READ"
  | WRITE        -> "WRITE"
  | BINOP (s)    -> sprintf ("BINOP %s", s)
  | LD    (x)    -> sprintf ("LD %s", x)
  | LDA   (x)    -> sprintf ("LDA %s", x)
  | ST    (x)    -> sprintf ("ST %s", x)
  | STI          -> "STI"
  | CONST (n)    -> sprintf ("CONST %d", n)
  | LABEL (s)    -> sprintf ("LABEL %s", s)
  | JMP   (l)    -> sprintf ("JMP %s", l)
  | CJMP  (c, l) -> sprintf ("CJMP %s, %s", c, l)
  | DUP          -> "DUP"
  | DROP         -> "DROP"  
  esac
}

public fun showSM (prg) {
  map (fun (i) {showSMInsn (i) ++ "\n"}, prg).stringcat
}

-- Evaluation environment: keeps a mapping between labels and (sub)programs
fun initEvalEnv (insns) {
  var map =
    fix (fun (rec) {
          fun ([m, insns]) {
            case insns of
              {}               -> m
            | LABEL (lab) : tl -> rec ([addMap (m, lab, insns), tl])
            | _ : tl           -> rec ([m, tl])
            esac
          }
        }) $ [emptyMap (compare), insns];
  
  [fun (l) {
     case findMap (map, l) of Some (insns) -> insns esac
  }]
}

-- Accessor function
fun fromLabel (env, lab) {
  env [0] (lab)
}

-- Stack machine interpreter. Takes an environment, an SM-configuration and a program,
-- returns a final configuration
fun eval (env, c@[stack, st, w], insns) {
   case insns of
        {} -> c
      | i:rest ->
         case i of
              READ        -> let [z, w1] = readWorld(w) in eval (env, [z:stack, st, w1], rest)
            | WRITE       -> let top:stack2 = stack in eval (env, [stack2, st, writeWorld(top, w)], rest)
            | BINOP(s)    -> let a:b:stack2 = stack in eval (env, [evalBinop(s, b, a):stack2, st, w], rest)
            | LD(x)       -> eval (env, [st(x):stack, st, w], rest)
            | LDA(x)      -> eval (env, [x:stack, st, w], rest)
            | ST(x)       -> let top:stack2 = stack in eval (env, [stack2, st <- [x, top], w], rest)
            | STI         -> let v:r:stack2 = stack in eval (env, [v:stack2, st <- [r, v], w], rest)
            | DROP        -> let _:stack2 = stack in eval (env, [stack2, st, w], rest)
            | DUP         -> let top:_ = stack in eval (env, [top:stack, st, w], rest)
            | CONST(n)    -> eval (env, [n:stack, st, w], rest)
            | LABEL (s)   -> eval (env, c, rest)
            | JMP   (l)   -> eval (env, c, fromLabel(env, l))
            | CJMP (cond, l) ->
                let top:stack2 = stack in
                eval (env, [stack2, st, w],
                  case cond of
                    "z"  -> if top == 0 then fromLabel(env, l) else rest fi
                  | "nz" -> if top != 0 then fromLabel(env, l) else rest fi
                  esac
                )
         esac
   esac
}

-- Runs a stack machine for a given input and a given program, returns an output
public fun evalSM (input, insns) {
  eval (initEvalEnv (insns), [{}, emptyState, createWorld (input)], insns)[2].getOutput
}

-- Compilation environment: generates labels
fun makeCompEnv (n) {
  [fun () {
     [sprintf ("L%d", n), makeCompEnv (n+1)]
  }]
}

fun initCompEnv () {
  makeCompEnv (0)
}

-- Accessor function: generates one label
fun genLabel (env) {
  env [0] ()
}

-- Utility function: generates n labels
fun genLabels (env, n) {
  fun inner (env, n) {
    if n == 0
    then {env}
    else case env.genLabel of
           [lab, env] -> lab : inner (env, n-1)
         esac
    fi
  }

  listArray (inner (env, n))
}

-- Compiles an expression into a stack machine code.
-- Takes an expression, returns a list of stack machine
-- instructions.
public fun compileSM (stmt) {
  fun label (lab, labUsed) {
    if labUsed
    then singletonBuffer (LABEL (lab))
    else emptyBuffer ()
    fi
  }
  
  fun compile (lab, env, stmt) {
    case stmt of
      Skip           -> [false, env, emptyBuffer ()]
    | Const (n)      -> [false, env, singletonBuffer (CONST (n))]
    | Var   (x)      -> [false, env, singletonBuffer (LD (x))]
    | Ref   (x)      -> [false, env, singletonBuffer (LDA (x))]
    | Read  (x)      -> [false, env, singletonBuffer (READ) <+ ST (x)]
    | Write (e)      ->
        case compile (lab, env, e) of
          [_, env, eCode] -> [false, env, eCode <+ WRITE]
        esac
    | Binop (op, a, b) ->
        case compile (lab, env, a) of
          [_, env, aCode] ->
            case compile (lab, env, b) of
              [_, env, bCode] -> [false, env, aCode <+> bCode <+ BINOP (op)]
            esac
        esac
    | Assn  (l, r) ->
        case compile (lab, env, l) of
          [_, env, lCode] ->
            case compile (lab, env, r) of
              [_, env, rCode] -> [false, env, lCode <+> rCode <+ STI]
            esac
        esac
    | Ignore (e) ->
        case compile (lab, env, e) of
          [_, env, eCode] -> [false, env, eCode <+ DROP]
        esac
    | Seq   (s1, s2) ->
        case env.genLabel of
          [s2Lab, env] ->
             case compile (s2Lab, env, s1) of
               [s2LabUsed, env, s1Code] ->
                  case compile (lab, env, s2) of
                    [labUsed, env, s2Code] -> [labUsed, env, s1Code <+> label (s2Lab, s2LabUsed) <+> s2Code]
                  esac
             esac
        esac
    | If (e, s1, s2) ->
        case env.genLabel of
          [elseLabel, env] ->
            case env.genLabel of
              [endLabel, env] ->
                case compile (endLabel, env, e) of
                  [_, env, eCode] ->
                    case compile (endLabel, env, s1) of
                      [_, env, s1Code] ->
                        case compile (endLabel, env, s2) of
                          [_, env, s2Code] ->
                            [false, env,
                             eCode <+ CJMP ("z", elseLabel)
                             <+> s1Code <+ JMP (endLabel)
                             <+ LABEL (elseLabel) <+> s2Code
                             <+ LABEL (endLabel)]
                        esac
                    esac
                esac
            esac
        esac
    | While (e, s) ->
        case env.genLabel of
          [loopLabel, env] ->
            case env.genLabel of
              [bodyEnd, env] ->
                case compile (bodyEnd, env, e) of
                  [_, env, eCode] ->
                    case compile (bodyEnd, env, s) of
                      [bodyEndUsed, env, bodyCode] ->
                        [true, env,
                         singletonBuffer (LABEL (loopLabel))
                         <+> eCode <+ CJMP ("z", lab)
                         <+> bodyCode <+> label (bodyEnd, bodyEndUsed) <+ JMP (loopLabel)]
                    esac
                esac
            esac
        esac
    | DoWhile (s, e) ->
        case env.genLabel of
          [loopLabel, env] ->
            case env.genLabel of
              [bodyEnd, env] ->
                case compile (bodyEnd, env, s) of
                  [bodyEndUsed, env, bodyCode] ->
                    case compile (bodyEnd, env, e) of
                      [_, env, eCode] ->
                        [false, env,
                         singletonBuffer (LABEL (loopLabel))
                         <+> bodyCode <+> label (bodyEnd, bodyEndUsed)
                         <+> eCode <+ CJMP ("nz", loopLabel)]
                    esac
                esac
            esac
        esac
    esac
  }

  case initCompEnv ().genLabel of
    [endLab, env] ->
       case compile (endLab, env, stmt) of
         [endLabUsed, _, code] -> getBuffer $ code <+> label (endLab, endLabUsed) 
       esac
  esac
}
