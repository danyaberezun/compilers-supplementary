-- Stack machine.

import List;
import World;
import State;
import Expr;
import Buffer;
import Fun;

-- Stack code printer. Takes a list of SM instructions, return its
-- string representation.
public fun showSMInsn (i) {
  case i of
    READ      -> sprintf ("READ")
  | WRITE     -> sprintf ("WRITE")
  | BINOP (s) -> sprintf ("BINOP %s", s)
  | LD    (x) -> sprintf ("LD %s", x)
  | ST    (x) -> sprintf ("ST %s", x)
  | CONST (n) -> sprintf ("CONST %d", n)
  | LABEL (n) -> sprintf ("LABEL %d", n)
  | JUMP  (n) -> sprintf ("JUMP %d", n)
  | JZ    (n) -> sprintf ("JZ %d", n)
  esac
}

public fun showSM (prg) {
  map (fun (i) {showSMInsn (i) ++ "\n"}, prg).stringcat
}

-- Stack machine interpreter. Takes an SM-configuration and a program,
-- returns a final configuration
fun findLabel (label, code) {
  case code of
    LABEL (n) : rest ->
      if n == label
      then rest
      else findLabel (label, rest)
      fi
  | _ : rest -> findLabel (label, rest)
  esac
}

fun eval (code, c, insns) {
   let [stack, st, w] = c in
      case insns of
        {}              -> c
      | LABEL (_): rest -> eval(code, c, rest)
      | JUMP (n): _     -> eval(code, c, findLabel (n, code))
      | JZ (n): rest    -> let v: stack1 = stack in
                              if v == 0
                              then eval(code, [stack1, st, w], findLabel (n, code))
                              else eval(code, [stack1, st, w], rest)
                              fi
      | READ: rest      -> let [n, w1] = readWorld(w) in eval(code, [n : stack, st, w1], rest)
      | WRITE: rest     -> let n: stack1 = stack in eval(code, [stack1, st, writeWorld(n, w)], rest)
      | BINOP(op): rest -> let r: l: stack1 = stack in eval(code, [evalBinop(op, l, r) : stack1, st, w], rest)
      | LD(x): rest     -> eval(code, [st(x) : stack, st, w], rest)
      | ST(x): rest     -> let n: stack1 = stack in eval(code, [stack1, st <- [x, n], w], rest)
      | CONST(n): rest  -> eval(code, [n : stack, st, w], rest)
      esac
}

-- Runs a stack machine for a given input and a given program, returns an output
public fun evalSM (input, insns) {
  eval (insns, [{}, emptyState, createWorld (input)], insns)[2].getOutput
}

-- Compiles an expression into a stack machine code.
-- Takes an expression, returns a list 
-- of stack machine instructions
fun compileExpr (expr) {
   case expr of
     Var(x)          -> {LD(x)}
   | Const(n)        -> {CONST(n)}
   | Binop(op, l, r) -> compileExpr(l) +++ compileExpr(r) +++ {BINOP(op)}
   esac
}

fun compileStmt (stmt, nextLabel) {
   case stmt of
     Assn(x, e)  -> [compileExpr(e) +++ {ST(x)}, nextLabel]
   | Seq(s1, s2) -> case compileStmt (s1, nextLabel) of
                      [code1, nextLabel1] ->
                        case compileStmt (s2, nextLabel1) of
                          [code2, nextLabel2] -> [code1 +++ code2, nextLabel2]
                        esac
                    esac
   | Skip        -> [{}, nextLabel]
   | Read(x)     -> [{READ, ST(x)}, nextLabel]
   | Write(e)    -> [compileExpr(e) +++ {WRITE}, nextLabel]
   | If(e, s1, s2) ->
       var elseLabel = nextLabel,
           exitLabel = nextLabel + 1;
       case compileStmt (s1, nextLabel + 2) of
         [thenCode, nextLabel1] ->
           case compileStmt (s2, nextLabel1) of
             [elseCode, nextLabel2] -> [compileExpr(e) +++ {JZ (elseLabel)} +++ thenCode +++ {JUMP (exitLabel), LABEL (elseLabel)} +++ elseCode +++ {LABEL (exitLabel)}, nextLabel2]
           esac
       esac
   | While(e, body) ->
       var loopLabel = nextLabel,
           exitLabel = nextLabel + 1;
       case compileStmt (body, nextLabel + 2) of
         [bodyCode, nextLabel1] -> [{LABEL (loopLabel)} +++ compileExpr(e) +++ {JZ (exitLabel)} +++ bodyCode +++ {JUMP (loopLabel), LABEL (exitLabel)}, nextLabel1]
       esac
   esac
}

-- Compiles a statement into a stack machine code.
-- Takes a statement, returns a list of stack machine
-- instructions.
public fun compileSM (stmt) {
   case compileStmt (stmt, 0) of
     [code, _] -> code
   esac
}
