-- Stack machine.

import Array;
import List;
import Fun;
import Collection;
import World;
import State;
import Expr;
import Buffer;

-- Stack code printer. Takes a list of SM instructions, return its
-- string representation.
fun myReverse2(code,tw){
	case code of
		[]->tw
		|x:y->myReverse2(y,x:tw)
	esac
}
fun myReverse(code){
	myReverse2(code,[])
}
public fun showSMInsn (i) {
  case i of
    READ         -> sprintf ("READ")
  | WRITE        -> sprintf ("WRITE")
  | BINOP (s)    -> sprintf ("BINOP %s", s)
  | LD    (x)    -> sprintf ("LD %s", x)
  | ST    (x)    -> sprintf ("ST %s", x)
  | CONST (n)    -> sprintf ("CONST %d", n)
  | LABEL (s)    -> sprintf ("LABEL %s", s)
  | JMP   (l)    -> sprintf ("JMP %s", l)
  | CJMP  (c, l) -> sprintf ("CJMP %s, %s", c, l)
  esac
}
public fun showSM (prg) {
	case prg of
		[]->""
		|x:y->showSM(y)++showSMInsn(x)++"\n"
	esac
}
-- Evaluation environment: keeps a mapping between labels and (sub)programs
fun initEvalEnv (insns) {
  var map =
    fix (fun (rec) {
          fun ([m, insns]) {
            case insns of
              []               -> m
            | LABEL (lab) : tl -> rec ([addMap (m, lab, insns), tl])
            | _ : tl           -> rec ([m, tl])
            esac
          }
        }) $ [emptyMap (compare), insns];
  
  [fun (l) {
     case findMap (map, l) of Some (insns) -> insns esac
  }]
}

-- Accessor function
fun fromLabel (env, lab) {
  env [0] (lab)
}

-- Stack machine interpreter. Takes an environment, an SM-configuration and a program,
-- returns a final configuration
fun eval (env, [stack,state,[i,o]], insns) {
	var debug=0;
	--printf(insns.string);
	--printf("\n");
	--write(state("res"));
	--printf("\n");
	--write(state("n"));
	--printf("\n");
	--write(state("k"));
	--printf("\n");
	case insns of
		[]->[stack,state,[i,o]]
		|x:y-> case x of
			READ->case i of
				f:r->
				if debug then printf("READING\n") else Nop fi;
				eval(env,[f:stack,state,[r,o]],y)
				esac
			|WRITE->case stack of
				f:r->
				if debug then printf("WRITING\n") else Nop fi;
				eval(env,[r,state,[i,f:o]],y)
				esac
			|LD(v)->
				if debug then printf("LOADING %s\n",v) else Nop fi;
				eval(env,[state(v):stack,state,[i,o]],y)
			|ST(v)->
				if debug then printf("STORING %s\n",v) else Nop fi;
				case stack of
				f:r->eval(env,[r,state<-[v,f],[i,o]],y)
				esac
			|CONST(n)->
				if debug then printf("CONSTING %i\n",n) else Nop fi;
				eval(env,[n:stack,state,[i,o]],y)
			|BINOP(a)->
				if debug then printf("BINOPING %s\n",a) else Nop fi;
				case stack of
					s:f:r->eval(env,[opEval(a,f,s):r,state,[i,o]],y)
				esac
			|JMP(l)->
				if debug then printf("JUMPING %s\n",l) else Nop fi;
				eval(env,[stack,state,[i,o]],env.fromLabel(l))
			|CJMP(h,l)->
				if debug then printf("CHECKING %s\n",h) else Nop fi;
				case stack of
				f:r->
					if f
					then
						if debug then printf("NOTJUMPING %s\n",l) else Nop fi;
						eval(env,[stack,state,[i,o]],y)
					else
						if debug then printf("JUMPING %s\n",l) else Nop fi;
						eval(env,[stack,state,[i,o]],env.fromLabel(l))
					fi
				esac
			|LABEL(l)->
				if debug then printf("MARKING %s\n",l) else Nop fi;
				eval(env,[stack,state,[i,o]],y)
		esac
	esac
}

-- Runs a stack machine for a given input and a given program, returns an output
public fun evalSM (input, insns) {
	var r=myReverse(insns);
	case eval (initEvalEnv (r), [{}, emptyState, createWorld (input)], r) of [stack,state,[i,o]] -> reverse(o) esac
}

-- Compilation environment: generates labels
fun makeCompEnv (n) {
  [fun () {
     [sprintf ("L%d", n), makeCompEnv (n+1)]
  }]
}

fun initCompEnv () {
  makeCompEnv (0)
}

-- Accessor function: generates one label
fun genLabel (env) {
  env [0] ()
}

-- Utility function: generates n labels
fun genLabels (env, n) {
  fun inner (env, n) {
    if n == 0
    then {env}
    else case env.genLabel of
           [lab, env] -> lab : inner (env, n-1)
         esac
    fi
  }

  listArray (inner (env, n))
}

-- Compiles an expression into a stack machine code.
-- Takes an expression, returns a list of stack machine instructions
fun merge(a,b){
	case a of
		[]->b
		|x:y->x:merge(y,b)
	esac
}
fun doCompileExpr(expr,tw){
	case expr of
		Var(a)->LD(a):tw
		|Const(a)->CONST(a):tw
		|Binop(a,b,c)->
			BINOP(a):doCompileExpr(c,doCompileExpr(b,tw))
	esac
}
fun compileExpr (expr) {
	doCompileExpr(expr,[])
}
-- Compiles a statement into a stack machine code.
-- Takes a statement, returns a list of stack machine
-- instructions.
public fun compileSM (stmt) {
  -- Generates SM code for a given statement
  --    lab  --- a label th go to after the statement is executed
  --    env  --- compilation environment
  --    stmt --- a statement to generate SM code for
  -- Returns a triple:
  --    boolean flag indicating if "lab" was used
  --    updated environment
  --    code buffer  
	fun compile (lab, env, stmt) {
		case stmt of
			Skip->[false,env,[]]
			|Read(x)->[false,env,ST(x):READ:[]]
			|Write(e)->[false,env,WRITE:compileExpr(e)]
			|Assn(x, e)->[false,env,ST(x):compileExpr(e)]
			|Seq(s1, s2)->
				case env.genLabel of [s2Lab, env] ->
					case compile (s2Lab, env, s1) of [s2LabUsed, env, s1Code] ->
						case compile (lab, env, s2) of [labUsed, env, s2Code]->
							if s2LabUsed then
								[labUsed, env, merge(s2Code,LABEL(s2Lab):s1Code)]
							else
								[labUsed, env, merge(s2Code,s1Code)]
							fi
						esac
					esac
				esac
			|While(a,b)->
				case env.genLabel of [start, env] ->
					case compile (lab, env, b) of [_, env, code] ->
						[true,env,JMP(start):merge(code,CJMP("z",lab):doCompileExpr(a,LABEL(start):[]))]
					esac
				esac
			|If(a,b,c)->
				case env.genLabel of [ifbad,env]->
					case compile(lab,env,b) of [needB,env,codeB]->
					case compile(lab,env,c) of [needC,env,codeC]->
						[true,env,merge(codeC,merge(LABEL(ifbad):JMP(lab):codeB,CJMP("z",ifbad):compileExpr(a)))]
					esac
					esac
				esac
			|DoWhile(a,b)->
				case env.genLabel of [start,env]->
					case compile(lab,env,a) of [_,env,code]->
						[true,env,JMP(start):merge(code,CJMP("z",lab):doCompileExpr(b,LABEL(start):[]))]
					esac
				esac
		esac
	}
	case initCompEnv ().genLabel of [endLab, env] ->
		case compile (endLab, env, stmt) of [endLabUsed, _, code] ->
			--printf(code.string);
			if endLabUsed
				then LABEL(endLab):code
				else code
			fi
		esac
	esac
}
