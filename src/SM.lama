-- Stack machine.

import Array;
import List;
import Fun;
import Collection;
import World;
import State;
import Expr;
import Buffer;
import Fun;

-- Stack code printer. Takes a list of SM instructions, return its
-- string representation.
public fun showSMInsn (i) {
  case i of
    READ         -> "READ"
  | WRITE        -> "WRITE"
  | BINOP (s)    -> sprintf ("BINOP %s", s)
  | LD    (x)    -> sprintf ("LD %s", x)
  | LDA   (x)    -> sprintf ("LDA %s", x)
  | ST    (x)    -> sprintf ("ST %s", x)
  | STI          -> "STI"
  | CONST (n)    -> sprintf ("CONST %d", n)
  | LABEL (s)    -> sprintf ("LABEL %s", s)
  | JMP   (l)    -> sprintf ("JMP %s", l)
  | CJMP  (c, l) -> sprintf ("CJMP %s, %s", c, l)
  | DUP          -> "DUP"
  | DROP         -> "DROP"  
  esac
}

public fun showSM (prg) {
  map (fun (i) {showSMInsn (i) ++ "\n"}, prg).stringcat
}

-- Evaluation environment: keeps a mapping between labels and (sub)programs
fun initEvalEnv (insns) {
  var map =
    fix (fun (rec) {
          fun ([m, insns]) {
            case insns of
              {}               -> m
            | LABEL (lab) : tl -> rec ([addMap (m, lab, insns), tl])
            | _ : tl           -> rec ([m, tl])
            esac
          }
        }) $ [emptyMap (compare), insns];
  
  [fun (l) {
     case findMap (map, l) of Some (insns) -> insns esac
  }]
}

-- Accessor function
fun fromLabel (env, lab) {
  env [0] (lab)
}

-- Stack machine interpreter. Takes an environment, an SM-configuration and a program,
-- returns a final configuration
fun eval (env, c, insns) {
  let [stack, state, w] = c in
    case insns of
      {}           -> c
    | ins : tail   -> 
      case ins of
        CONST (n)     -> eval(env, [n : stack, state, w], tail)
      | READ          -> let [n, new_w] = readWorld(w) in eval(env, [n : stack, state, new_w], tail)
      | WRITE         -> let n : tail_s = stack in eval(env, [tail_s, state, writeWorld(n, w)], tail)
      | LD (x)        -> eval(env, [state(x) : stack, state, w], tail)
      | ST (x)        -> let n : tail_s = stack in eval(env, [tail_s, state <- [x, n], w], tail)
      | BINOP (op)    -> let y : x : tail_s = stack in eval(env, [evalOp(op, x, y):tail_s, state, w], tail)
      | LABEL (s)     -> eval(env, c, tail)
      | JMP   (l)     -> eval(env, c, fromLabel(env, l))
      | CJMP  (c, l)  -> let x : tail_s = stack in 
          case c of 
            "nz"  -> if x != 0 then eval(env, [tail_s, state, w], fromLabel(env, l)) else eval(env, [tail_s, state, w], tail) fi
          | "z"   -> if x == 0 then eval(env, [tail_s, state, w], fromLabel(env, l)) else eval(env, [tail_s, state, w], tail) fi
          esac
      | LDA(x) -> eval(env, [x : stack, state, w], tail)
      | STI -> let x : ref : tail_s = stack in eval(env, [x : tail_s, state <- [ref, x], w], tail)
      | DROP -> let x : tail_s = stack in eval(env, [tail_s, state, w], tail)
      | DUP -> let x : tail_s = stack in eval(env, [x : x : tail_s, state, w], tail)
      esac
    esac
}

-- Runs a stack machine for a given input and a given program, returns an output
public fun evalSM (input, insns) {
  eval (initEvalEnv (insns), [{}, emptyState, createWorld (input)], insns)[2].getOutput
}

-- Compilation environment: generates labels
fun makeCompEnv (n) {
  [fun () {
     [sprintf ("L%d", n), makeCompEnv (n+1)]
  }]
}

fun initCompEnv () {
  makeCompEnv (0)
}

-- Accessor function: generates one label
fun genLabel (env) {
  env [0] ()
}

-- Utility function: generates n labels
fun genLabels (env, n) {
  fun inner (env, n) {
    if n == 0
    then {env}
    else case env.genLabel of
           [lab, env] -> lab : inner (env, n-1)
         esac
    fi
  }

  listArray (inner (env, n))
}

-- Compiles an expression into a stack machine code.
-- Takes an expression, returns a list of stack machine
-- instructions.
public fun compileSM (stmt) {
  fun label (lab, labUsed) {
    if labUsed
    then singletonBuffer (LABEL (lab))
    else emptyBuffer ()
    fi
  }
  
  fun compile (lab, env, stmt) {
    case stmt of
      Skip              -> [false, env, emptyBuffer ()]
    | Var    (x)        -> [false, env, singletonBuffer (LD (x))]
    | Ref    (x)        -> [false, env, singletonBuffer (LDA (x))]
    | Const  (n)        -> [false, env, singletonBuffer (CONST (n))]
    | Read  (x)      -> [false, env, singletonBuffer (READ) <+ ST (x)]
    | Write (e)      -> case genLabel(env) of 
                          [lab, env] -> 
                            case compile(lab, env, e) of
                              [labUsed, env, code1] -> [false, env, code1 <+> label (lab, labUsed) <+ WRITE]
                            esac
                        esac
    | Assn  (x, e)   -> case  genLabel(env) of
                          [lab1, env] -> 
                            case genLabel(env) of
                              [lab2, env] -> 
                                case compile(lab1, env, x) of
                                  [labUsed1, env, code1] -> 
                                    case compile(lab2, env, e) of
                                      [labUsed2, env, code2] -> [false, env, code1 <+> label(lab1, labUsed1) <+> code2 <+> label(lab2, labUsed2) <+ STI]
                                    esac
                                esac
                            esac
                        esac
    | Seq   (s1, s2) ->
        case env.genLabel of
          [s2Lab, env] ->
             case compile (s2Lab, env, s1) of
               [s2LabUsed, env, s1Code] ->
                  case compile (lab, env, s2) of
                    [labUsed, env, s2Code] -> [labUsed, env, s1Code <+> label (s2Lab, s2LabUsed) <+> s2Code]
                  esac
             esac
        esac
    | If  (e, s1, s2) -> 
        case env.genLabel of
          [falseLabel, env] -> 
            case compile(lab, env, s1) of 
              [labUsedTrue, env, trueCode] -> 
                case compile(lab, env, s2) of
                  [labUsedFalse, env, falseCode] ->
                    case compile(lab, env, e) of
                      [_, env, expCode] -> [true, env, expCode <+ CJMP("z", falseLabel) <+> trueCode <+ JMP(lab) <+> singletonBuffer(LABEL(falseLabel)) <+> falseCode]
                    esac
                esac
            esac
        esac
      
    | While (e, s1) -> 
        case env.genLabel of
          [condLabel, env] ->
            case env.genLabel of
              [loopLabel, env] -> 
                case compile(condLabel, env, s1) of 
                  [_, env, code] ->
                    case compile(condLabel, env, e) of
                      [_, env, expCode] -> [false, env, singletonBuffer(JMP(condLabel)) <+> singletonBuffer(LABEL(loopLabel)) <+> code <+> singletonBuffer(LABEL(condLabel)) <+> expCode <+ CJMP("nz", loopLabel)]
                    esac
                esac
            esac
        esac
    | DoWhile (s1, e) -> 
        case env.genLabel of
          [condLabel, env] ->
            case env.genLabel of
              [loopLabel, env] -> 
                case compile(condLabel, env, s1) of 
                  [_, env, code] ->
                    case compile(condLabel, env, e) of
                      [_, env, expCode] -> [false, env, singletonBuffer(LABEL(loopLabel)) <+> code <+> singletonBuffer(LABEL(condLabel)) <+> expCode <+ CJMP("nz", loopLabel)]
                    esac
                esac
            esac
        esac
    | Binop (op, l, r) -> case genLabel(env) of
                            [lab1, env] ->
                              case genLabel(env) of
                                [lab2, env] ->
                                  case compile(lab1, env, l) of
                                    [labUsed1, env, code1] ->
                                      case compile(lab2, env, r) of
                                        [labUsed2, env, code2] -> [false, env, code1 <+> label(lab1, labUsed1) <+> code2 <+> label(lab2, labUsed2) <+ BINOP (op)]
                                      esac
                                  esac
                              esac
                          esac
    | Ignore (e) -> case genLabel(env) of
                      [lab1, env] -> 
                        case compile(lab1, env, e) of
                          [labUsed1, env, code1] -> [false, env, code1 <+> label(lab1, labUsed1) <+ DROP]
                        esac
                    esac
    esac
  }

  case initCompEnv ().genLabel of
    [endLab, env] ->
       case compile (endLab, env, stmt) of
         [endLabUsed, _, code] -> getBuffer $ code <+> label (endLab, endLabUsed) 
       esac
  esac
}
