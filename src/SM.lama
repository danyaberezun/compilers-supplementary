-- Stack machine.

import Array;
import List;
import Fun;
import Collection;
import World;
import State;
import Expr;
import Buffer;
import Fun;

-- Stack code printer. Takes a list of SM instructions, return its
-- string representation.
public fun showSMInsn (i) {
  case i of
    READ         -> "READ"
  | WRITE        -> "WRITE"
  | BINOP (s)    -> sprintf ("BINOP %s", s)
  | LD    (x)    -> sprintf ("LD %s", x)
  | LDA   (x)    -> sprintf ("LDA %s", x)
  | ST    (x)    -> sprintf ("ST %s", x)
  | STI          -> "STI"
  | CONST (n)    -> sprintf ("CONST %d", n)
  | LABEL (s)    -> sprintf ("LABEL %s", s)
  | JMP   (l)    -> sprintf ("JMP %s", l)
  | CJMP  (c, l) -> sprintf ("CJMP %s, %s", c, l)
  | DUP          -> "DUP"
  | DROP         -> "DROP"  
  esac
}

public fun showSM (prg) {
  map (fun (i) {showSMInsn (i) ++ "\n"}, prg).stringcat
}

-- Evaluation environment: keeps a mapping between labels and (sub)programs
fun initEvalEnv (insns) {
  var map =
    fix (fun (rec) {
          fun ([m, insns]) {
            case insns of
              {}               -> m
            | LABEL (lab) : tl -> rec ([addMap (m, lab, insns), tl])
            | _ : tl           -> rec ([m, tl])
            esac
          }
        }) $ [emptyMap (compare), insns];
  
  [fun (l) {
     case findMap (map, l) of Some (insns) -> insns esac
  }]
}

-- Accessor function
fun fromLabel (env, lab) {
  env [0] (lab)
}

fun evalBINOP(op, x, y) {
   case op of
     "+" -> x + y
   | "-" -> x - y
   | "*" -> x * y
   | "/" -> x / y
   | "%" -> x % y
   | "<" -> x < y
   | ">" -> x > y
   | "<=" -> x <= y
   | ">=" -> x >= y
   | "==" -> x = y
   | "!=" -> x != y
   | "&&" -> x && y
   | "!!" -> if (x != 0) then 1
             else if (y != 0) then 1 else 0 fi
             fi
   esac
}

-- Stack machine interpreter. Takes an environment, an SM-configuration and a program,
-- returns a final configuration
fun eval (env, c, insns) {
  case insns of
     {} -> c
   | head:tail ->
      var s = c[0]; 
      var st = c[1];
      var w = c[2];
      case head of
        READ -> 
            var rw = readWorld(w);
            var read_v = fst(rw);
            var new_w = snd(rw);
            eval(env, [read_v:s, st, new_w], tail)
      | WRITE ->
            let z:stail = s in
            (var new_w = writeWorld(z, w);
            eval(env, [stail, st, new_w], tail))
      | BINOP(op) ->
            let y:x:stail = s in
            eval(env, [evalOp(op, y, x):stail, st, w], tail)
      | LD(x) -> 
            eval(env, [st(x):s, st, w], tail)
      | ST(x) ->
            let z:stail = s in
            (var new_st = st <- [x, z];
            eval(env, [z:stail, new_st, w], tail))
      | CONST(n) -> 
            eval(env, [n:s, st, w], tail)
      | LABEL(l) ->
            eval(env, [s, st, w], tail)
      | JMP(l) ->
            eval(env, [s, st, w], env.fromLabel(l))
      | CJMP(cc, l) ->
            let hd:tl = s in 
            case cc of
              "z" ->  if hd == 0 then
                        eval(env, [tl, st, w], env.fromLabel(l))
                      else 
                        eval(env, [tl, st, w], tail)
                      fi
            | "nz" -> if hd != 0 then
                        eval(env, [tl, st, w], env.fromLabel(l))
                      else 
                        eval(env, [tl, st, w], tail)
                      fi
            esac
      | LDA(x) ->
            eval(env, [x:s, st, w], tail)
      | STI -> 
            let v:x:tl = s in
            eval(env, [v:tl, st <- [x, v], w], tail)
      | DROP ->
            let x:tl = s in
            eval(env, [tl, st, w], tail)
      | DUP -> 
            let x:tl = s in
            eval(env, [x:x:tl, st, w], tail)
      esac
   esac
}

-- Runs a stack machine for a given input and a given program, returns an output
public fun evalSM (input, insns) {
  eval (initEvalEnv (insns), [{}, emptyState, createWorld (input)], insns)[2].getOutput
}

-- Compilation environment: generates labels
fun makeCompEnv (n) {
  [fun () {
     [sprintf ("L%d", n), makeCompEnv (n+1)]
  }]
}

fun initCompEnv () {
  makeCompEnv (0)
}

-- Accessor function: generates one label
fun genLabel (env) {
  env [0] ()
}

-- Utility function: generates n labels
fun genLabels (env, n) {
  fun inner (env, n) {
    if n == 0
    then {env}
    else case env.genLabel of
           [lab, env] -> lab : inner (env, n-1)
         esac
    fi
  }

  listArray (inner (env, n))
}

-- Compiles an expression into a stack machine code.
-- Takes an expression, returns a list of stack machine
-- instructions.
public fun compileSM (stmt) {
  fun label (lab, labUsed) {
    if labUsed
    then singletonBuffer (LABEL (lab))
    else emptyBuffer ()
    fi
  }
  
  fun compile (lab, env, stmt) {
    case stmt of
      Skip              -> [false, env, emptyBuffer ()]
    | Var    (x)        -> [false, env, singletonBuffer (LD (x))]
    | Ref    (x)        -> [false, env, singletonBuffer (LDA (x))]
    | Const  (n)        -> [false, env, singletonBuffer (CONST (n))]
    | Assn  (name, value) ->  
          let [lab, env, buff] = compile(lab, env, Seq(name, value)) in
          [lab, env, buff <+ STI]
    | Seq(s1, s2) -> 
          let [s2Lab, env] = env.genLabel in
          let [s2LabUsed, env, s1Code] = compile(s2Lab, env, s1) in
          let [labUsed, env, s2Code] = compile(lab, env, s2) in
          [labUsed, env, s1Code <+> label(s2Lab, s2LabUsed) <+> s2Code]
    | Binop (op, x, y) -> 
          let [lab, env, buff] = compile(lab, env, Seq(y, Seq(x, Skip))) in
          [false, env, buff <+ BINOP(op)]
    | Ignore (x) -> 
          let  [lab, env, buff] = compile(lab, env, Seq(x, Skip)) in [false, env, buff <+ DROP]
    | Read(x) -> 
          let [labUsed, env, buff] = compile(lab, env, x) in [false, env, buff <+>label(lab, labUsed)<+ READ <+ STI <+ DROP]   
    | Write(e) -> 
          let [labUsed, env, buff] = compile(lab, env, e) in [false, env,  buff <+>label(lab, labUsed)<+ WRITE] 
    | If (e, stmt1, stmt2) -> 
          let [_, env, cond] = compile(lab, env, e) in
          let [elseLabel, env] = env.genLabel  in
            let [labUsedThen, env, thenCode] = compile (lab, env, stmt1) in
                let [labUsedElse, env, elseCode] = compile (lab, env, stmt2) in
                    [true, env,
                     cond <+ CJMP ("z", elseLabel)
                     <+> thenCode <+ JMP (lab)
                     <+ LABEL (elseLabel)
                     <+> elseCode]
    | While (e, stmt) ->
          let [_, env, cond] = compile(lab, env, e) in
          case env.genLabel of
            [condLabel, env] ->
              case env.genLabel of
                [loopLabel, env] ->
                  case compile (condLabel, env, stmt) of
                    [_, env, stmtCode] ->
                      [false, env,
                      singletonBuffer (JMP (condLabel))
                      <+> singletonBuffer (LABEL (loopLabel))
                      <+> stmtCode
                      <+> singletonBuffer (LABEL (condLabel))
                      <+> cond <+ CJMP ("nz", loopLabel)]
                  esac
              esac
          esac
    | DoWhile (e, stmt) -> compile(lab, env, Seq(stmt, While(e, stmt)))
    esac
  }

  case initCompEnv ().genLabel of
    [endLab, env] ->
       case compile (endLab, env, stmt) of
         [endLabUsed, _, code] -> getBuffer $ code <+> label (endLab, endLabUsed) 
       esac
  esac
}
