-- Stack machine.

import Array;
import Binop;
import List;
import Fun;
import Collection;
import World;
import State;
import Expr;
import Buffer;

-- Stack machine.
-- Stack code printer. Takes a list of SM instructions, return its
-- string representation.
public fun showSMInsn (i) {
  case i of
    READ         -> "READ"
  | WRITE        -> "WRITE"
  | BINOP (s)    -> sprintf ("BINOP %s", s)
  | LD    (x)    -> sprintf ("LD %s", x)
  | LDA   (x)    -> sprintf ("LDA %s", x)
  | ST    (x)    -> sprintf ("ST %s", x)
  | STI          -> "STI"
  | CONST (n)    -> sprintf ("CONST %d", n)
  | LABEL (s)    -> sprintf ("LABEL %s", s)
  | JMP   (l)    -> sprintf ("JMP %s", l)
  | CJMP  (c, l) -> sprintf ("CJMP %s, %s", c, l)
  | DUP          -> "DUP"
  | DROP         -> "DROP"
  esac
}
public fun showSM (prg) {
   map(fun (i) {showSMInsn(i) ++ "\n"}, prg).stringcat
}
-- Evaluation environment: keeps a mapping between labels and (sub)programs
fun initEvalEnv (insns) {
   var map = fix(fun (rec) {
                           fun ([m, insns]) {
                              case insns of
                                {}             -> m
                              | LABEL(lab): tl -> rec([addMap(m, lab, insns), tl])
                              | _: tl          -> rec([m, tl])
                              esac
                           }
                        }) $ [emptyMap(compare), insns];
   
   [fun (l) {
       case findMap(map, l) of
         Some(insns) -> insns
       esac
    }]
}
-- Accessor function
fun fromLabel (env, lab) {
   env[0](lab)
}
-- Stack machine interpreter. Takes an environment, an SM-configuration and a program,
-- returns a final configuration
fun eval (env, c@[stack, state, world], insns) {
  case insns of
    {}               -> c
  | READ: rest       -> let inputWorld = readWorld(world) in
                        world := snd(inputWorld);
                        stack := {fst(inputWorld)} +++ stack;
                        eval(env, [stack, state, world], rest)
  | WRITE: rest      -> world := writeWorld(hd(stack), world);
                        stack := tl(stack);
                        eval(env, [stack, state, world], rest)
  | BINOP(s): rest   -> var a, b;
                        
                        b := hd(stack);
                        stack := tl(stack);
                        a := hd(stack);
                        stack := tl(stack);
                        stack := {evalBinop(s, a, b)} +++ stack;
                        eval(env, [stack, state, world], rest)
  | LD(x): rest      -> stack := {state(x)} +++ stack;
                        eval(env, [stack, state, world], rest)
  | LDA(x): rest     -> stack := {x} +++ stack; 
                        eval(env, [stack, state, world], rest)
  | ST(x): rest      -> state := state <- [x, hd(stack)];
                        eval(env, [stack, state, world], rest)
  | STI: rest        -> var v, stack2, r;
                        v := hd(stack);
                        stack2 := tl(stack);
                        r := hd(stack2);
                        eval(env, [{v} +++ tl(stack2), state <- [r, v], world], rest)
  | DROP: rest       -> eval(env, [tl(stack), state, world], rest)
  | DUP: rest        -> stack := {hd(stack)} +++ stack; 
                        eval(env, [stack, state, world], rest)
  | CONST(n): rest   -> stack := {n} +++ stack;
                        eval(env, [stack, state, world], rest)
  | LABEL(s): rest   -> eval(env, c, rest)
  | JMP(l): _        -> eval(env, c, fromLabel(env, l))
  | CJMP("z", l): rest -> var a;
                          a := hd(stack);
                          stack := tl(stack);
                          if a == 0 
                          then eval(env, [stack, state, world], fromLabel(env, l))
                          else eval(env, [stack, state, world], rest)
                          fi
  | CJMP("nz", l): rest -> var a;
                           a := hd(stack);
                           stack := tl(stack);
                           if a != 0 
                           then eval(env, [stack, state, world], fromLabel(env, l)) 
                           else eval(env, [stack, state, world], rest) 
                           fi
  esac
}

-- Runs a stack machine for a given input and a given program, returns an output
public fun evalSM (input, insns) {
   eval(initEvalEnv(insns), [{}, emptyState, createWorld(input)], insns)[2].getOutput
}

-- Compilation environment: generates labels
fun makeCompEnv (n) {
   [fun () {[sprintf("L%d", n), makeCompEnv(n + 1)]}]
}

fun initCompEnv () {
   makeCompEnv(0)
}

-- Accessor function: generates one label
fun genLabel (env) {
  env[0]()
}

-- Utility function: generates n labels
fun genLabels (env, n) {
   fun inner (env, n) {
      if n == 0 then {env}
      else case env.genLabel of
             [lab, env] -> lab : inner(env, n - 1)
           esac
      fi
   }
   
   listArray(inner(env, n))
}

-- Compiles a statement into a stack machine code.
-- Takes a statement, returns a list of stack machine
-- instructions.
public fun compileSM (stmt) {
   -- Generates a buffer with an optional label
   --    lab     --- the name of the label
   --    labUsed --- a flag if the lebel is needed
   fun label (lab, labUsed) {
      if labUsed then singletonBuffer(LABEL(lab)) else emptyBuffer() fi
   }

   fun compile (lab, env, stmt) {
      case stmt of
        Assn(x, e)    -> var xLab, xLabUsed, xCode, eLab, eLabUsed, eCode;
                         let [xLab, env] = env.genLabel in
                         let [eLab, env] = env.genLabel in
                         let [xLabUsed, env, xCode] = compile(xLab, env, x) in
                         let [eLabUsed, env, eCode] = compile(eLab, env, e) in
                         [false, env, xCode <+> label(xLab, xLabUsed) <+> eCode <+> label(eLab, eLabUsed) <+ STI]
      | Seq(s1, s2)   -> var s2Lab, s2LabUsed, s1Code, labUsed, s2Code;
                         let [s2Lab, env] = env.genLabel in
                         let [s2LabUsed, env, s1Code] = compile(s2Lab, env, s1) in
                         let [labUsed, env, s2Code] = compile(lab, env, s2) in
                         [labUsed, env, s1Code <+> label(s2Lab, s2LabUsed) <+ DROP <+> s2Code]
      | Skip          -> [false, env, singletonBuffer(CONST(0))]
      | Read(x)       -> [false, env, singletonBuffer(READ) <+ ST(x) <+ DROP <+ CONST(0)]
      | Write(e)      -> var eLab, eLabUsed, eCode; 
                         let [eLab, env] = env.genLabel in
                         let [eLabUsed, env, eCode] = compile(eLab, env, e) in
                         [false, env, eCode <+> label(eLab, eLabUsed) <+ WRITE <+ CONST(0)]
      | If(e, s1, s2) -> var eLab, eLabUsed, eCode, s2Lab, s2Code, s1Code, labUsed1, labUsed2;
                         let [eLab, env] = env.genLabel in 
                         let [s2Lab, env] = env.genLabel in 
                         let [eLabUsed, env, eCode] = compile(eLab, env, e) in
                         let [labUsed1, env, s1Code] = compile(lab, env, s1) in 
                         let [labUsed2, env, s2Code] = compile(lab, env, s2) in
                         [true, env, eCode <+> label(eLab, eLabUsed) <+ CJMP("z", s2Lab) <+> s1Code <+ JMP(lab) <+> label(s2Lab, true) <+> s2Code]
      | While(e, s)   -> var eStartLab, bStartLab, sLab, eLab, eCode, sCode, eLabUsed, sLabUsed;
                         let [eStartLab, env] = env.genLabel in 
                         let [bStartLab, env] = env.genLabel in 
                         let [sLab, env] = env.genLabel in 
                         let [eLab, env] = env.genLabel in
                         let [eLabUsed, env, eCode] = compile(eLab, env, e) in 
                         let [sLabUsed, env, sCode] = compile(sLab, env, s) in
                         [false, env, singletonBuffer(JMP(eStartLab)) <+> label(bStartLab, true) <+> sCode <+> label(sLab, sLabUsed) <+ DROP <+> 
                                      label(eStartLab, true) <+> eCode <+> label(eLab, eLabUsed) <+ CJMP("nz", bStartLab) <+ CONST(0)]
      | DoWhile(s, e) -> var bStartLab, sLab, eLab, sCode, eCode, sLabUsed, eLabUsed;
                         let [bStartLab, env] = env.genLabel in 
                         let [sLab, env] = env.genLabel in 
                         let [eLab, env] = env.genLabel in
                         let [sLabUsed, env, sCode] = compile(sLab, env, s) in 
                         let [eLabUsed, env, eCode] = compile(eLab, env, e) in
                         [false, env, label(bStartLab, true) <+> sCode <+> label(sLab, sLabUsed) <+ DROP <+> 
                                      eCode <+> label(eLab, eLabUsed) <+ CJMP("nz", bStartLab) <+ CONST(0)]
      | Var(x)        -> [false, env, singletonBuffer (LD (x))]
      | Ref(x)        -> [false, env, singletonBuffer (LDA (x))]
      | Const(n)      -> [false, env, singletonBuffer (CONST (n))]
      | Binop(op, l, r) -> var lLab, rLab, lCode, rCode, lLabUsed, rLabUsed;
                         let [lLab, env] = env.genLabel in 
                         let [rLab, env] = env.genLabel in 
                         let [lLabUsed, env, lCode] = compile(lLab, env, l) in
                         let [rLabUsed, env, rCode] = compile(rLab, env, r) in
                         [false, env, lCode <+> label(lLab, lLabUsed) <+> rCode <+> label(rLab, rLabUsed) <+ BINOP(op)]
      | Ignore(e)     -> var eLab, eLabUsed, eCode;
                         let [eLab, env] = env.genLabel in 
                         let [eLabUsed, env, eCode] = compile(eLab, env, e) in
                         [false, env, eCode <+> label(eLab, eLabUsed) <+ DROP <+ CONST(0)]
      | _             -> failure("compileSM not implemented\n")
      esac
   }
   
   case initCompEnv().genLabel of
     [endLab, env] -> case compile(endLab, env, stmt) of
                        [endLabUsed, _, code] -> getBuffer $ code <+> label(endLab, endLabUsed)
                      esac
   esac
}
