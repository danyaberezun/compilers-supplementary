-- Stack machine.

import Array;
import List;
import Fun;
import Collection;
import World;
import State;
import Expr;
import Buffer;

-- Stack code printer. Takes a list of SM instructions, return its
-- string representation.
public fun showSMInsn (i) {
  case i of
    READ         -> sprintf ("READ")
  | WRITE        -> sprintf ("WRITE")
  | BINOP (s)    -> sprintf ("BINOP %s", s)
  | LD    (x)    -> sprintf ("LD %s", x)
  | ST    (x)    -> sprintf ("ST %s", x)
  | CONST (n)    -> sprintf ("CONST %d", n)
  | LABEL (s)    -> sprintf ("LABEL %s", s)
  | JMP   (l)    -> sprintf ("JMP %s", l)
  | CJMP  (c, l) -> sprintf ("CJMP %s, %s", c, l)
  esac
}

public fun showSM (prg) {
  map (fun (i) {showSMInsn (i) ++ "\n"}, prg).stringcat
}

-- Evaluation environment: keeps a mapping between labels and (sub)programs
fun initEvalEnv (insns) {
  var map =
    fix (fun (rec) {
          fun ([m, insns]) {
            case insns of
              {}               -> m
            | LABEL (lab) : tl -> rec ([addMap (m, lab, insns), tl])
            | _ : tl           -> rec ([m, tl])
            esac
          }
        }) $ [emptyMap (compare), insns];
  
  [fun (l) {
     case findMap (map, l) of Some (insns) -> insns esac
  }]
}

-- Accessor function
fun fromLabel (env, lab) {
  env [0] (lab)
}

-- Stack machine interpreter. Takes an environment, an SM-configuration and a program,
-- returns a final configuration
fun eval (env, c, insns) {
  let [stack, state, world] = c in
  case insns of
    READ : others ->
      let [value, world] = readWorld (world) in
      eval (env, [value : stack, state, world], others)
  | WRITE : others ->
      let value : stack = stack in
      let world = writeWorld (value, world) in
      eval (env, [stack, state, world], others)
  | BINOP (op) : others ->
      let right : left : stack = stack in
      eval (env, [evalOperator (op, left, right) : stack, state, world], others)
  | LD (name) : others ->
      eval (env, [state (name) : stack, state, world], others)
  | ST (name) : others ->
      let value : stack = stack in
      eval (env, [stack, state <- [name, value], world], others)
  | CONST (value) : others ->
      eval (env, [value : stack, state, world], others)
  | LABEL (_) : others ->
      eval (env, c, others)
  | JMP (lab) : _ ->
      eval (env, c, env.fromLabel (lab))
  | CJMP (cond, lab) : others ->
      let value : stack = stack in
      let next =
        case cond of
          "z"  -> if value == 0 then env.fromLabel (lab) else others fi
        | "nz" -> if value != 0 then env.fromLabel (lab) else others fi
        esac
      in
      eval (env, [stack, state, world], next)
  | {} -> c
  esac
}

-- Runs a stack machine for a given input and a given program, returns an output
public fun evalSM (input, insns) {
  eval (initEvalEnv (insns), [{}, emptyState, createWorld (input)], insns)[2].getOutput
}

-- Compilation environment: generates labels
fun makeCompEnv (n) {
  [fun () {
     [sprintf ("L%d", n), makeCompEnv (n+1)]
  }]
}

fun initCompEnv () {
  makeCompEnv (0)
}

-- Accessor function: generates one label
fun genLabel (env) {
  env [0] ()
}

-- Utility function: generates n labels
fun genLabels (env, n) {
  fun inner (env, n) {
    if n == 0
    then {env}
    else case env.genLabel of
           [lab, env] -> lab : inner (env, n-1)
         esac
    fi
  }

  listArray (inner (env, n))
}

-- Compiles an expression into a stack machine code buffer.
fun compileExpr (expr) {
  case expr of
    Var (name)              -> singletonBuffer (LD (name))
  | Const (value)           -> singletonBuffer (CONST (value))
  | Binop (op, left, right) -> compileExpr (left) <+> compileExpr (right) <+ BINOP (op)
  esac
}

-- Compiles a statement into a stack machine code.
-- Takes a statement, returns a list of stack machine
-- instructions.
public fun compileSM (stmt) {
  -- Generates SM code for a given statement
  --    env  --- compilation environment
  --    stmt --- a statement to generate SM code for
  -- Returns a pair:
  --    updated environment
  --    code buffer
  fun compile (env, stmt) {
    case stmt of
      Skip           -> [env, emptyBuffer ()]
    | Read  (x)      -> [env, singletonBuffer (READ) <+ ST (x)]
    | Write (e)      -> [env, compileExpr (e) <+ WRITE]
    | Assn  (x, e)   -> [env, compileExpr (e) <+ ST (x)]
    | Seq   (s1, s2) ->
        let [env, s1Code] = compile (env, s1) in
        let [env, s2Code] = compile (env, s2) in
        [env, s1Code <+> s2Code]
    | If(cond, body, elses) ->
        let [elseLabel, endLabel, env] = env.genLabels(2) in
        let [env, bodyCode] = compile (env, body) in
        let [env, elseCode] = compile (env, elses) in
        [env,
         compileExpr (cond)
         <+ CJMP ("z", elseLabel)
         <+> bodyCode
         <+ JMP (endLabel)
         <+ LABEL (elseLabel)
         <+> elseCode
         <+ LABEL (endLabel)]
    | While(cond, body) ->
        let [condLabel, bodyLabel, env] = env.genLabels(2) in
        let [env, bodyCode] = compile (env, body) in
        [env,
         singletonBuffer (JMP (condLabel))
         <+ LABEL (bodyLabel)
         <+> bodyCode
         <+ LABEL (condLabel)
         <+> compileExpr (cond)
         <+ CJMP ("nz", bodyLabel)]
    | DoWhile(body, cond) ->
        let [bodyLabel, env] = env.genLabel in
        let [env, bodyCode] = compile (env, body) in
        [env,
         singletonBuffer (LABEL (bodyLabel))
         <+> bodyCode
         <+> compileExpr (cond)
         <+ CJMP ("nz", bodyLabel)]
    esac
  }

  case compile (initCompEnv (), stmt) of
    [_, code] -> getBuffer (code)
  esac
}
