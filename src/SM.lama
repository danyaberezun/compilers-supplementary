-- Stack machine.
import List;
import World;
import State;
import Expr;
import Buffer;
import Fun;

-- Stack code printer. Takes a list of SM instructions, return its
-- string representation.
public fun showSMInsn (i) {
   case i of
     READ     -> sprintf("READ")
   | WRITE    -> sprintf("WRITE")
   | BINOP(s) -> sprintf("BINOP %s", s)
   | ST(x)    -> sprintf("ST %s", x)
   | LD(x)    -> sprintf("LD %s", x)
   | CONST(n) -> sprintf("CONST %d", n)
   esac
}
public fun showSM (prg) {
   printf("fghjk");
   map(fun (i) {showSMInsn(i) ++ "\n"}, prg).stringcat
}
-- Stack machine interpreter. Takes an SM-configuration and a program,
-- returns a final configuration
fun eval ([stack, state, world], inses) {
   -- printf("|%s\t|%s\t|%s\n", stack.string, state.string, world.string);
   case inses of
     instruction: ins -> 
                           case instruction of
                           READ     -> let [word, world1] = readWorld(world) in eval([word : stack, state, world1], ins)
                         | WRITE    -> let word: tail = stack in
                                           let world1 = writeWorld(word, world) in eval([tail, state, world1], ins)
                         | BINOP(s) -> let w1: w2: tail = stack in
                                           let stack1 = evalOp(s, w1, w2) : tail in eval([stack1, state, world], ins)
                         | ST(x)    -> let word: tail = stack in
                                           let state1 = state <- [x, word] in eval([tail, state1, world], ins)
                         | LD(x)    -> let word = state(x) in eval([word : stack, state, world], ins)
                         | CONST(n) -> eval([n : stack, state, world], ins)
                         esac
      | {}                ->  [stack, state, world]
   esac
}
-- Runs a stack machine for a given input and a given program, returns an output
public fun evalSM (input, insns) {
   -- printf("%s \n%s\n", input.string, insns.string);
   let a = eval([{}, emptyState, createWorld(input)], insns)[2] in
   -- printf("eeeeee %s\n", a.string);
   a.getOutput
}
-- Compiles an expression into a stack machine code.
-- Takes an expression, returns a list (of, possibly, lists)
-- of stack machine instructions
fun compileExpr (expr) {
   -- printf("          %s\n", expr.string);
   let res = case expr of
               Var(s)                  -> {LD(s)}
             | Const(x)                -> {CONST(x)}
             | Binop(op, expr1, expr2) -> compileExpr(expr2) +++ compileExpr(expr1) +++ {BINOP(op)}
             esac in
      -- printf("result -> %s\n", res.string);
      res
}
-- Compiles a statement into a stack machine code.
-- Takes a statement, returns a list of stack machine
-- instructions.
public fun compileSM (stmt) {
   let res = case stmt of
               Assn(string, expr) -> compileExpr(expr) +++ {ST(string)}
             | Seq(stmt1, stmt2)  -> compileSM(stmt1) +++ compileSM(stmt2)
             | Skip               -> {}
             | Read(string)       -> {READ} +++ {ST(string)}
             | Write(expr)        -> compileExpr(expr) +++ {WRITE}
             esac in
      -- printf("%s --> %s\n", stmt.string, res.string);
      res
}