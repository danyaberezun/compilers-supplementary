-- Stack machine.

import Ref;
import Array;
import List;
import Fun;
import Collection;
import World;
import State;
import Parser;
import Lexer;
import Expr;
import Buffer;

-- Stack code printer. Takes a list of SM instructions, return its
-- string representation.
public fun showSMInsn (i) {
  -- Shows a location (a reference to function argument, local or global variable)
  fun showLoc (d) {
    case d of
      Arg (i) -> sprintf ("arg[%d]", i)
    | Loc (i) -> sprintf ("loc[%d]", i)
    | Glb (x) -> x
    esac
  }

  case i of
    READ             -> "READ"
  | WRITE            -> "WRITE"
  | BINOP  (s)       -> sprintf ("BINOP %s", s)
  | LD     (x)       -> sprintf ("LD %s", showLoc (x))
  | LDA    (x)       -> sprintf ("LDA %s", showLoc (x))
  | ST     (x)       -> sprintf ("ST %s", showLoc (x))
  | STI              -> "STI"
  | CONST  (n)       -> sprintf ("CONST %d", n)
  | LABEL  (s)       -> sprintf ("LABEL %s", s)
  | JMP    (l)       -> sprintf ("JMP %s", l)
  | CJMP   (c, l)    -> sprintf ("CJMP %s, %s", c, l)
  | CALL   (f, n)    -> sprintf ("CALL %s, %d", f, n)
  | BEGIN  (f, a, l) -> sprintf ("BEGIN %s, %d, %d", f, a, l)
  | GLOBAL (x)       -> sprintf ("GLOBAL %s", x)
  | END              -> sprintf ("END")
  | DUP              -> "DUP"
  | DROP             -> "DROP"
  esac
}

public fun showSM (prg) {
  map (fun (i) {showSMInsn (i) ++ "\n"}, prg).stringcat
}

-- Evaluation environment: keeps a mapping between labels and (sub)programs
fun initEvalEnv (insns) {
  var map =
    fix (fun (rec) {
          fun ([m, insns]) {
            case insns of
              {}               -> m
            | LABEL (lab) : tl -> rec ([addMap (m, lab, insns), tl])
            | _ : tl           -> rec ([m, tl])
            esac
          }
        }) $ [emptyMap (compare), insns];

  [fun (l) {
     case findMap (map, l) of Some (insns) -> insns esac
  }]
}

-- Accessor function
fun fromLabel (env, lab) {
  env [0] (lab)
}

-- Takes n positions from the list, returns a pair: the remaining list and the taken
-- sublist, reversed
public fun take (list, n) {
  fun inner (n, acc, list) {
    if n == 0
    then [list, acc]
    else inner (n-1, list.hd : acc, list.tl)
    fi
  }

  inner (n, {}, list)
}

-- Stack machine interpreter. Takes an environment, a world and a program,
-- returns a final output
fun eval (env, w, insns) {
  -- Global state maps names of global variables to values
  var globalState = ref (fun (x) {error (sprintf ("name ""%s"" is undefined", x), getLoc (x))});

  -- Make a fresh local state: a pair of arrays for arguments and local variables;
  -- takes the numbers of arguments and local variables respectively
  fun makeState (a, l) {
    [initArray (a, fun (_) {0}), initArray (l, fun (_) {0})]
  }

  -- Lookups a location in local/global states
  fun lookup ([args, locs], loc) {
    case loc of
      Arg (i) -> args[i]
    | Loc (i) -> locs[i]
    | Glb (x) -> deref (globalState) (x)
    esac
  }

  -- Assigns a value to a location
  fun assign ([args, locs], loc, v) {
    case loc of
      Arg (i) -> args[i] := v
    | Loc (i) -> locs[i] := v
    | Glb (x) -> var g = deref (globalState);
                 globalState ::= fun (y) {if compare (x, y) == 0 then v else g (y) fi}
    esac
  }

  -- Core interpreter: takes a configuration and a program, returns a configuration
  (* Assignment *)
  fun eval (c, insns) {
    let impl = fix (fun (rec) {
        fun ([c, insns]) {
          case insns of
            {} -> c
          | i : tl ->
            let [c, insnsNext] = evalInsn (c, i, tl) in rec ([c, insnsNext])
          esac
        }
    }) in impl ([c, insns])
  }

  fun toInt (s, v) {
    case v of
      Const (n) -> n
    | Ref (loc) -> lookup (s, loc)
    esac
  }

  -- Returns [new_stack, local_state]
  fun makeStateFromStack (s, st, n_args, n_locals) {
    let [st, args] = take (st, n_args) in
    let s = [listArray $ map (fun (v) {toInt (s, v)}, args), initArray (n_locals, fun (_) {0})] in
    [st, s]
  }

  -- SM program structure:
  -- for each function f:
  --     LABEL (f)
  --     BEGIN (f, n_args, n_locals)    -- n_locals: how many locals will be used
  --         <f code>
  --     END

  -- env: maps var names to loc
  -- s: maps (local) loc to val
  -- globalState: maps var names to val

  -- loc := global x | local n | arg n    -- operand location
  -- val := Const n | Ref loc    -- stack element
  -- s := [(N -> val), (N -> val)]    -- local state: function args + local vars

  -- st: stack of val
  -- cst: control stack of [state, program]
  -- s: current state
  -- world = [input, output]: world
  --     -> [c, rest]    -- rest of the program
  fun evalInsn (c@[st, cst, s, world], insn, rest) {
    fun noJmp (c) {
      [c, rest]
    }

    fun jmp (c, label) {
      [c, fromLabel (env, label)]
    }

    -- printf ("Stack state: %s\n", string (st));
    -- printf ("Evaluating %s\n", string (insn));
    case insn of
      READ ->
        let [n, world] = world.readWorld in
        [Const (n) : st, cst, s, world].noJmp
    | WRITE ->
        let Const (n) : st = st in
        [st, cst, s, writeWorld (n, world)].noJmp
    | BINOP (op) ->
        let rhs : lhs : st = st in
        let res = evalOp (op, toInt (s, lhs), toInt (s, rhs)) in
        [Const (res) : st, cst, s, world].noJmp
    | LD (loc) ->
        [Const (lookup (s, loc)) : st, cst, s, world].noJmp
    | LDA (loc) ->
        [Ref (loc) : st, cst, s, world].noJmp
    | ST (loc) ->
        let Const (n) = st.hd in
        assign (s, loc, n);
        [st.tl, cst, s, world].noJmp
    | STI ->
        let v : Ref (loc) : st = st in
        assign (s, loc, toInt (s, v));
        [v : st, cst, s, world].noJmp
    | CONST (n) ->
        [Const (n) : st, cst, s, world].noJmp
    | LABEL (l) ->
        c.noJmp
    | JMP (l) ->
        c.jmp (l)
    | CJMP (cond, l) ->
        let Const (b) : st = st in
        let c = [st, cst, s, world] in
        case cond of
          "z"  -> if b == 0 then c.jmp (l) else c.noJmp fi
        | "nz" -> if b != 0 then c.jmp (l) else c.noJmp fi
        | _    -> failure ("Unknown condition '%s': expected 'z' or 'nz'\n", cond.string)
        esac
    | CALL (f, n_args) ->
        [st, [s, rest] : cst, makeState (0, 0), world].jmp (f)
    | BEGIN (f, n_args, n_locals) ->
        let [st, s] = makeStateFromStack (s, st, n_args, n_locals) in
        [st, cst, s, world].noJmp
    | GLOBAL (x) ->
        assign (s, Glb (x), 0);
        c.noJmp
    | END ->
        case cst of
          {} -> [c, {}]
        | [s, rest] : cst -> [[st, cst, s, world], rest]
        esac
    | DUP ->
        [st.hd : st.hd : st.tl, cst, s, world].noJmp
    | DROP ->
        [st.tl, cst, s, world].noJmp
    esac
  }
  (* End *)

  eval ([{}, {}, makeState (0, 0), w], insns) [3].getOutput
}

-- Runs a stack machine for a given input and a given program, returns an output
public fun evalSM (input, insns) {
  eval (initEvalEnv (insns), createWorld (input), insns)
}

-- Compilation environment: generates labels
fun makeCompEnv (nLabels, scopeDepth, state, nLocals, nArgs, functions) {
  -- Generates a new label
  fun genLabel () {
    [sprintf ("L%d", nLabels), makeCompEnv (nLabels+1, scopeDepth, state, nLocals, nArgs, functions)]
  }

  -- Adds a new function
  fun rememberFun (fLabel, args, body) {
    makeCompEnv (nLabels,
                 scopeDepth,
                 state,
                 nLocals,
                 nArgs,
                 Fun (fLabel, args, body, state) : functions)
  }

  -- Enters a local scope
  fun beginScope () {
    makeCompEnv (nLabels, scopeDepth+1, enterScope (state), nLocals, nArgs, functions)
  }

  -- Leaves a local scope
  fun endScope () {
    makeCompEnv (nLabels, scopeDepth-1, leaveScope (state), nLocals, nArgs, functions)
  }

  -- Adds an argument for the current function
  fun addArg (name) {
    makeCompEnv (nLabels, scopeDepth, addName (state, name, Arg (nArgs)), nLocals, nArgs+1, functions)
  }

  -- Adds a local variable for the current function
  fun addVar (name) {
    if scopeDepth == 1
    then makeCompEnv (nLabels, scopeDepth, addName (state, name, Glb (name)), nLocals, nArgs, functions)
    else makeCompEnv (nLabels, scopeDepth, addName (state, name, Loc (nLocals)), nLocals+1, nArgs, functions)
    fi
  }

  -- Adds a binding for a function
  fun addFun (name, fLabel, nargs) {
    makeCompEnv (nLabels, scopeDepth, addName (state, name, Fun (fLabel, nargs)), nLocals, nArgs, functions)
  }

  -- Enters a function
  fun beginFun (state) {
    makeCompEnv (nLabels, 1, enterFunction (state), 0, 0, functions)
  }

  -- Get functions and empty functions list
  fun getFuns () {
    [functions, makeCompEnv (nLabels, scopeDepth, state, nLocals, nArgs, {})]
  }

  -- Lookups a name of a variable
  fun lookupVar (name) {
    case lookup (state, name) of
      Fun (_, _) -> error (sprintf ("the name ""%s"" does not designate a variable", name), getLoc (name))
    | x          -> x
    esac
  }

  -- Lookups a name of a function
  fun lookupFun (name) {
    case lookup (state, name) of
      x@Fun (_, _) -> x
    | _            -> error (sprintf ("the name ""%s"" does not designate a function", name), getLoc (name))
    esac
  }

  -- Gets the number of local variables
  fun getLocals () {
    nLocals
  }

  -- Generates an intrinsic function name
  fun genFunLabel (name) {
     if scopeDepth == 1
     then [sprintf ("L%s", name),             makeCompEnv (nLabels  , scopeDepth, state, nLocals, nArgs, functions)]
     else [sprintf ("L%s_%d", name, nLabels), makeCompEnv (nLabels+1, scopeDepth, state, nLocals, nArgs, functions)]
     fi
  }

  -- Checks if the current scope is a global
  fun isGlobal () {
    scopeDepth == 1
  }

  [genLabel,
   rememberFun,
   beginScope,
   endScope,
   addArg,
   addVar,
   beginFun,
   getFuns,
   lookupVar,
   lookupFun,
   getLocals,
   genFunLabel,
   addFun,
   isGlobal
  ]
}

-- Initialize a new compilation environment
fun initCompEnv () {
  makeCompEnv (0, 0, emptyState (), 0, 0, {})
}

-- Accessor functions
fun genLabel (env) {
  env [0] ()
}

fun rememberFun (env, name, args, body) {
  env [1] (name, args, body)
}

fun beginScope (env) {
  env [2] ()
}

fun endScope (env) {
  env [3] ()
}

fun addArg (env, name) {
  env [4] (name)
}

fun addVar (env, name) {
  env [5] (name)
}

fun beginFun (env, state) {
  env [6] (state)
}

fun getFuns (env) {
  env [7] ()
}

fun lookupVar (env, name) {
  env [8] (name)
}

fun lookupFun (env, name) {
  env [9] (name)
}

fun getLocals (env) {
  env [10] ()
}

fun genFunLabel (env, name) {
  env [11] (name)
}

fun addFun (env, name, fLabel, nargs) {
  env [12] (name, fLabel, nargs)
}

fun isGlobal (env) {
  env [13] ()
}

-- Helper function: generates n labels
fun genLabels (env, n) {
  fun inner (env, n) {
    if n == 0
    then {env}
    else case genLabel (env) of
           [lab, env] -> lab : inner (env, n-1)
         esac
    fi
  }

  listArray (inner (env, n))
}

-- Helper function: adds a bunch of arguments
fun addArgs (env, names) {
  foldl (fun (env, name) {addArg (env, name)}, env, names)
}

-- Helper function: adds a bunch of locals
fun addVars (env, names) {
  foldl (fun (env, name) {addVar (env, name)}, env, names)
}

-- Compiles an expression into a stack machine code.
-- Takes an expression, returns a list of stack machine
-- instructions.

(* Assignment *)

-- Some guidelines for compiling functions and scopes.
--
-- 1. use env.beginScope/env.endScope properly;
-- 2. in each scope traverse the definitions twice:
--    a. first, add all bindings into symbolic state,
--       using end.addVar/env.addFun;
--    b. do not forget to generate GLOBAL instructions for
--       top-level variable declarations;
--    c. on the secord traversal add functions themselves for
--       future code generation (use env.rememberFun).
-- 3. the overall flow for code generation:
--    a. generate the code for the topmost expression (the program itself);
--    b. take list of nested functions definitions via env.getFuns and
--       generate the code for each function;
--    c. repeat b. until no function definitions appear.
-- 4. when compiling functions, do not forget to create proper
--    environment (use env.beginFun) and register arguments
--    (use env.addArg).

-- Compiles an expression into a stack machine code.
-- Takes an expression, returns a list of stack machine
-- instructions.
public fun compileSM (stmt) {
  fun label (lab, labUsed) {
    if labUsed
    then singletonBuffer (LABEL (lab))
    else emptyBuffer ()
    fi
  }
  
  fun compileMany (lab, env, exprs) {
    case exprs of
      {}     -> [false, env, emptyBuffer ()]
    | {e}    -> compile (lab, env, e)
    | e : es ->
        case env.genLabel of
          [eLab, env] ->
            case compile (eLab, env, e) of
              [eUsed, env, eCode] ->
                 case compileMany (lab, env, es) of
                   [labUsed, env, esCode] -> [labUsed, env, eCode <+> label (eLab, eUsed) <+> esCode]
                 esac
            esac
        esac
    esac
  }

  fun addDefs (env, defs) {
    foldl (
      fun (env, def) {
        case def of
          Var (names) -> env.addVars (names)
        | Fun (fname, arg_names, body) ->
            let [flab, env] = env.genFunLabel (fname) in
            env.addFun (fname, flab, arg_names.size)
        esac
      },
      env,
      defs
    )
  }

  fun extractVarNames (defs) {
    foldl (
      fun (acc, def) {
        case def of
          Var (names) -> names +++ acc
        | _           -> acc
        esac
      },
      {},
      defs
    )
  }

  fun genGlobals (defs) {
    foldl (
      fun (acc, name) {
        acc <+ GLOBAL (name)
      },
      emptyBuffer (),
      extractVarNames (defs)
    )
  }

  fun rememberFuns (env, defs) {
    foldl (
      fun (env, def) {
        case def of
          Fun (fname, arg_names, body) ->
            let Fun (flab, n_args) = env.lookupFun (fname) in
            env.rememberFun (flab, arg_names, body)
        | _ -> env
        esac
      },
      env,
      defs
    )
  }

  -- lab: label to jump to after program finishes
  -- env: compilation environment
  -- stmt: AST to be compiled
  --     -> [lab_used, env, SM program]
  --     note: if lab_used = false, code for it will not be generated
  fun compile (lab, env, stmt) {
    -- printf ("Compiling %s...\n", string (stmt));
    case stmt of
      Assn (l, r)       ->
        let [l_lab, r_lab, env] = env.genLabels (2) in
        let [l_used, env, l_code] = compile (l_lab, env, l) in
        let [r_used, env, r_code] = compile (r_lab, env, r) in
        let code = l_code <+> label (l_lab, l_used) <+> r_code <+> label (r_lab, r_used) <+ STI in
        [false, env, code]
    | Seq (e1, e2)      ->
        let [l1, l2, env] = env.genLabels (2) in
        let [used1, env, code1] = compile (l1, env, e1) in
        let [used2, env, code2] = compile (l2, env, e2) in
        let code = code1 <+> label (l1, used1) <+> code2 <+> label (l2, used2) in
        [false, env, code]
    | Skip              -> [false, env, emptyBuffer ()]
    | Read (Ref (x))    ->
        let loc = env.lookupVar (x) in
        [false, env, singletonBuffer (READ) <+ ST (loc)]
    | Write (e)         ->
        let [l, env] = env.genLabel in
        let [used, env, code] = compile (l, env, e) in
        -- printf ("Compiled %s\n", string (e));
        let code = code <+> label (l, used) <+ WRITE in
        -- printf ("Got %s\n", string (code));
        [false, env, code]
    | If (cond, t_body, e_body) ->
        let [cond_l, e_l, env] = env.genLabels (2) in
        let [c_used, env, c_code] = compile (cond_l, env, cond) in
        let [_, env, t_code] = compile (lab, env, t_body) in
        let [_, env, e_code] = compile (lab, env, e_body) in
        let code = c_code <+> label (cond_l, c_used) <+ CJMP ("z", e_l) <+>
          t_code <+ JMP (lab) <+ LABEL (e_l) <+> e_code in
        [true, env, code]
    | While (cond, body) ->
        let [start_l, cond_l, body_l, env] = env.genLabels (3) in
        let [c_used, env, c_code] = compile (cond_l, env, cond) in
        let [b_used, env, b_code] = compile (body_l, env, body) in
        let code = singletonBuffer (LABEL (start_l)) <+> c_code <+> label (cond_l, c_used) <+
          CJMP ("z", lab) <+> b_code <+> label (body_l, b_used) <+ JMP (start_l) in
        [true, env, code]
    | DoWhile (cond, body) ->
        let [start_l, body_l, cond_l, env] = env.genLabels (3) in
        let [c_used, env, c_code] = compile (cond_l, env, cond) in
        let [b_used, env, b_code] = compile (body_l, env, body) in
        let code = singletonBuffer (LABEL (start_l)) <+> b_code <+> label (body_l, b_used) <+>
          c_code <+> label (cond_l, c_used) <+ CJMP ("nz", start_l) in
        [false, env, code]
    | Var    (x)        ->
      let loc = env.lookupVar (x) in
      [false, env, singletonBuffer (LD (loc))]
    | Ref    (x)        ->
      let loc = env.lookupVar (x) in
      [false, env, singletonBuffer (LDA (loc))]
    | Const  (n)        -> [false, env, singletonBuffer (CONST (n))]
    | Binop  (op, lhs, rhs) ->
        let [lhs_l, rhs_l, env] = env.genLabels (2) in
        let [l_used, env, l_code] = compile (lhs_l, env, lhs) in
        let [r_used, env, r_code] = compile (rhs_l, env, rhs) in
        let code = l_code <+> label (lhs_l, l_used) <+> r_code <+> label (rhs_l, r_used) <+ BINOP (op) in
        [false, env, code]
    | Call (fname, args) ->
        let [args_l, env] = env.genLabel in
        let Fun (flab, n_args) = env.lookupFun (fname) in
        if n_args == args.size then
          let [a_used, env, a_code] = compileMany (args_l, env, args) in
          let code = a_code <+> label (args_l, a_used) <+ CALL (flab, n_args) in
          [false, env, code]
        else
          failure ("Unexpected number of arguments to %s: expected %d, got %d", fname, n_args, args.size)
        fi
    | Scope (defs, body) ->
        let env = env.beginScope in
        -- add defs to the scope, using addVars/addFun
        let env = env.addDefs (defs) in
        -- generate GLOBAL instructions
        let globals = if env.isGlobal then
            genGlobals (defs)
          else
            emptyBuffer ()
          fi in
        -- add functions using env.rememberFun
        let env = env.rememberFuns (defs) in
        -- compile body
        let [used, env, code] = compile (lab, env, body) in
        [used, env.endScope, globals <+> code]
    | Ignore (e) ->
        let [e_lab, env] = env.genLabel in
        let [e_used, env, e_code] = compile (e_lab, env, e) in
        let code = e_code <+> label (e_lab, e_used) <+ DROP in
        [false, env, code]
    esac
  }

  fun compileFunctions (env, main) {
    fun iterate (env, funList) {
      case funList of
        {}     -> case getFuns (env) of
                    [{}, env] -> emptyBuffer ()
                  | [fs, env] -> iterate (env, fs)
                  esac
      | Fun (f, args, body, state) : fs ->
          case genLabel (addArgs (beginFun (env, state), args)) of
            [endLab, env] ->
               case compile (endLab, env, body) of
                 [endUsed, env, code] -> 
                    singletonBuffer (LABEL (f)) <+
                    BEGIN (f, args.size, getLocals (env)) <+>
                    code <+>
                    label (endLab, endUsed) <+
                    END <+>
                    iterate (env, fs)
               esac
          esac          
      esac
    }
    
    main <+> iterate (env, {})
  }
    
  case initCompEnv ().genLabel of
    [endLab, env] ->
       case compile (endLab, env, stmt) of
         [endLabUsed, env, code] ->
            getBuffer $
            compileFunctions (env, 
                              singletonBuffer (LABEL ("main")) <+
                              BEGIN ("main", 0, getLocals (env)) <+>
                              code <+>
                              label (endLab, endLabUsed) <+
                              END 
                             )            
       esac
  esac
}

