-- Stack machine.
import Array;
import List;
import Fun;
import Collection;
import World;
import State;
import Expr;
import Buffer;

-- Stack code printer. Takes a list of SM instructions, return its
-- string representation.
public fun showSMInsn (i) {
   case i of
     READ       -> sprintf("READ")
   | WRITE      -> sprintf("WRITE")
   | BINOP(s)   -> sprintf("BINOP %s", s)
   | LD(x)      -> sprintf("LD %s", x)
   | ST(x)      -> sprintf("ST %s", x)
   | CONST(n)   -> sprintf("CONST %d", n)
   | LABEL(s)   -> sprintf("LABEL %s", s)
   | JMP(l)     -> sprintf("JMP %s", l)
   | CJMP(c, l) -> sprintf("CJMP %s, %s", c, l)
   | _ -> sprintf("bad")
   esac
}
public fun showSM (prg) {
   map(fun (i) {showSMInsn(i) ++ "\n"}, prg).stringcat
}
-- Evaluation environment: keeps a mapping between labels and (sub)programs
fun initEvalEnv (insns) {
   var map = fix(fun (rec) {
                           fun ([m, insns]) {
                              case insns of
                                {}             -> m
                              | LABEL(lab): tl -> rec([addMap(m, lab, insns), tl])
                              | _: tl          -> rec([m, tl])
                              esac
                           }
                        }) $ [emptyMap(compare), insns];
   
   [fun (l) {
       case findMap(map, l) of
         Some(insns) -> insns
       esac
    }]
}
-- Accessor function
fun fromLabel (env, lab) {
   env[0](lab)
}
-- Stack machine interpreter. Takes an environment, an SM-configuration and a program,
-- returns a final configuration
fun eval (env, c@[stack, state, world], insns) {
   case insns of
     x: xs -> case x of
                READ       -> let [result, newWorld] = readWorld(world) in eval(env, [result : stack, state, newWorld], xs)
              | WRITE      -> let s: ss = stack in eval(env, [ss, state, writeWorld(s, world)], xs)
              | BINOP(op)  -> let y: x: ss = stack in eval(env, [evalBinop(op, x, y) : ss, state, world], xs)
              | LD(vr)     -> eval(env, [state(vr) : stack, state, world], xs)
              | ST(vr)     -> let s: ss = stack in eval(env, [ss, state <- [vr, s], world], xs)
              | CONST(n)   -> eval(env, [n : stack, state, world], xs)
              | LABEL(s)   -> eval(env, c, xs)
              | JMP(l)     -> eval(env, c, fromLabel(env, l))
              | CJMP(c, l) -> let s: ss = stack in
                                 eval(env, [ss, state, world], case c of
                                                              "z"  -> if s == 0 then fromLabel(env, l) else xs fi
                                                            | "nz" -> if s != 0 then fromLabel(env, l) else xs fi
                                                            esac)
              | null ->         eval(env, c, xs)                        
              | _ -> failure("undefined variable ""%s""\n", x)
              esac
   | {}    -> c
   esac
}
-- Runs a stack machine for a given input and a given program, returns an output
public fun evalSM (input, insns) {
   showSM(insns);
   eval(initEvalEnv(insns), [{}, emptyState, createWorld(input)], insns)[2].getOutput
}
-- Compilation environment: generates labels
fun makeCompEnv (n) {
   [fun () {[sprintf("L%d", n), makeCompEnv(n + 1)]}]
}
fun initCompEnv () {
   makeCompEnv(0)
}
-- Accessor function: generates one label
fun genLabel (env) {
   env[0]()
}
-- Utility function: generates n labels
fun genLabels (env, n) {
   fun inner (env, n) {
      if n == 0 then {env}
      else case env.genLabel of
             [lab, env] -> lab : inner(env, n - 1)
           esac
      fi
   }
   
   listArray(inner(env, n))
}
-- Compiles an expression into a stack machine code.
-- Takes an expression, returns a list of stack machine instructions
fun compileExpr (expr) {
   case expr of
     Var(vr)                 -> singletonBuffer (LD (vr))
   | Const(n)                -> singletonBuffer (CONST (n))
   | Binop(op, expr1, expr2) -> compileExpr(expr1) <+> compileExpr(expr2) <+ BINOP(op)
   esac
}
-- Compiles a statement into a stack machine code.
-- Takes a statement, returns a list of stack machine
-- instructions.

public fun compileSM (stmt) {
  -- Generates a buffer with an optional label
  --    lab     --- the name of the label
  --    labUsed --- a flag if the lebel is needed
  fun label (lab, labUsed) {
    if labUsed
    then singletonBuffer (LABEL (lab))
    else emptyBuffer ()
    fi
  }

  -- Generates SM code for a given statement
  --    lab  --- a label th go to after the statement is executed
  --    env  --- compilation environment
  --    stmt --- a statement to generate SM code for
  -- Returns a triple:
  --    boolean flag indicating if "lab" was used
  --    updated environment
  --    code buffer  
  fun compile (lab, env, stmt) {
    case stmt of
      Skip            -> [false, env, emptyBuffer ()]
    | Read  (x)       -> [false, env, singletonBuffer (READ) <+ ST (x)]
    | Write (e)       -> [false, env, compileExpr (e) <+ WRITE]
    | Assn  (x, e)    -> [false, env, compileExpr (e) <+ ST (x)]
    | Seq   (s1, s2)  ->
        let [s2Lab, env] = env.genLabel in
          let [s2LabUsed, env, s1Code] = compile (s2Lab, env, s1) in
            let [labUsed, env, s2Code] = compile (lab, env, s2) in
              [labUsed, env, s1Code <+> label (s2Lab, s2LabUsed) <+> s2Code]
    | If(expr, s1, s2) -> 
        let [elseLabel, env] = env.genLabel in
          let [_, env, thenCode] = compile (lab, env, s1) in
            let [_, env, elseCode] = compile (lab, env, s2) in
              [true, env, 
                compileExpr(expr) 
                <+ CJMP ("z", elseLabel) 
                <+> thenCode 
                <+ JMP (lab) 
                <+ LABEL (elseLabel) 
                <+> elseCode
              ]
    | While(expr, s)  -> 
        let [condLabel, bodyLabel, env] = env.genLabels (2) in
          let [_, env, condCode] = compile (condLabel, env, s) in
            [false, env, 
              singletonBuffer (JMP (condLabel))
              <+ LABEL (bodyLabel) 
              <+> condCode
              <+ LABEL (condLabel)  
              <+> compileExpr (expr)
              <+ CJMP ("nz", bodyLabel)
            ]
    | DoWhile(expr, s) -> 
        compile(lab, env, Seq(s, While(expr, s)))
    | _              -> failure ("compileSM not implemented\n")
    esac
  }  

  case initCompEnv ().genLabel of
    [endLab, env] ->
       case compile (endLab, env, stmt) of
         [endLabUsed, _, code] -> getBuffer $  code <+> label (endLab, endLabUsed)
       esac
  esac
}