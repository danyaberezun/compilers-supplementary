-- Stack machine.

import Array;
import List;
import Fun;
import Collection;
import World;
import State;
import Expr;
import Buffer;

-- Stack code printer. Takes a list of SM instructions, return its
-- string representation.
public fun showSMInsn (i) {
  case i of
    READ         -> sprintf ("READ")
  | WRITE        -> sprintf ("WRITE")
  | BINOP (s)    -> sprintf ("BINOP %s", s)
  | LD    (x)    -> sprintf ("LD %s", x)
  | ST    (x)    -> sprintf ("ST %s", x)
  | CONST (n)    -> sprintf ("CONST %d", n)
  | LABEL (s)    -> sprintf ("LABEL %s", s)
  | JMP   (l)    -> sprintf ("JMP %s", l)
  | CJMP  (c, l) -> sprintf ("CJMP %s, %s", c, l)
  esac
}

public fun showSM (prg) {
  map (fun (i) {showSMInsn (i) ++ "\n"}, prg).stringcat
}

-- Evaluation environment: keeps a mapping between labels and (sub)programs
fun initEvalEnv (insns) {
  var map =
    fix (fun (rec) {
          fun ([m, insns]) {
            case insns of
              {}               -> m
            | LABEL (lab) : tl -> rec ([addMap (m, lab, insns), tl])
            | _ : tl           -> rec ([m, tl])
            esac
          }
        }) $ [emptyMap (compare), insns];
  
  [fun (l) {
     case findMap (map, l) of Some (insns) -> insns esac
  }]
}

-- Accessor function
fun fromLabel (env, lab) {
  env [0] (lab)
}

-- Stack machine interpreter. Takes an environment, an SM-configuration and a program,
-- returns a final configuration
fun eval (env, c, insns) {
  let impl = fix (fun (rec) {
      fun ([c, insns]) {
        case insns of
          {} -> c
        | i : tl ->
          let [c, next] = evalInsn (c, i) in
          let insnsNext = case next of
              Some (label) -> fromLabel (env, label)
            | _            -> tl
          esac in rec ([c, insnsNext])
        esac
      }
  }) in impl ([c, insns])
}

fun evalInsn (c@[stack, state, world], insn) {
  fun noJmp (c) {
    [c, None]
  }

  fun jmp (c, label) {
    [c, Some (label)]
  }

  case insn of
     READ     -> let [v, w] = world.readWorld in
                 [v : stack, state, w].noJmp
   | WRITE    -> let v : rest = stack in
                 [rest, state, v.writeWorld(world)].noJmp
   | BINOP(s) -> let r : rest = stack in
                 let l : rest = rest in
                 let v = evalBinOp(s, l, r) in
                 [v : rest, state, world].noJmp
   | LD(x)    -> let v = x.state in
                 [v : stack, state, world].noJmp
   | ST(x)    -> let v : rest = stack in
                 [rest, state <- [x, v], world].noJmp
   | CONST(n) -> [n : stack, state, world].noJmp
   | LABEL(l) -> c.noJmp
   | JMP(l)   -> c.jmp (l)
   | CJMP(cnd, l) -> 
      let v : rest = stack in
      let nc = [rest, state, world] in
      case cnd of
        "z"  -> if v == 0 then nc.jmp (l) else nc.noJmp fi
      | "nz" -> if v != 0 then nc.jmp (l) else nc.noJmp fi
      | _    -> failure ("Unknown condition %s\n", cnd.string)
      esac
   | _        -> failure ("Unknown instruction %s\n", insn.string)
   esac
}

-- Runs a stack machine for a given input and a given program, returns an output
public fun evalSM (input, insns) {
  eval (initEvalEnv (insns), [{}, emptyState, createWorld (input)], insns)[2].getOutput
}

-- Compilation environment: generates labels
fun makeCompEnv (n) {
  [fun () {
     [sprintf ("L%d", n), makeCompEnv (n+1)]
  }]
}

fun initCompEnv () {
  makeCompEnv (0)
}

-- Accessor function: generates one label
fun genLabel (env) {
  env [0] ()
}

-- Utility function: generates n labels
fun genLabels (env, n) {
  fun inner (env, n) {
    if n == 0
    then {env}
    else 
      case env.genLabel of
        [lab, env] -> lab : inner (env, n-1)
      esac
    fi
  }

  listArray (inner (env, n))
}

-- Compiles an expression into a stack machine code.
-- Takes an expression, returns a list of stack machine instructions
fun compileExpr (expr) {
   case expr of
      Var(x)   -> singletonBuffer (LD(x))
   |  Const(n) -> singletonBuffer (CONST(n))
   |  Binop(op, e1, e2) ->
         let c1 = e1.compileExpr in
         let c2 = e2.compileExpr in
         c1 <+> c2 <+ BINOP(op)
   |  _ -> failure ("Unknown expression %s", expr.string)
   esac
}

-- Compiles a statement into a stack machine code.
-- Takes a statement, returns a list of stack machine
-- instructions.
public fun compileSM (stmt) {
  -- Generates a buffer with an optional label
  --    lab     --- the name of the label
  --    labUsed --- a flag if the lebel is needed
  fun label (lab, labUsed) {
    if labUsed
    then singletonBuffer (LABEL (lab))
    else emptyBuffer ()
    fi
  }

  -- Generates SM code for a given statement
  --    lab  --- a label to go to after the statement is executed
  --    env  --- compilation environment
  --    stmt --- a statement to generate SM code for
  -- Returns a triple:
  --    boolean flag indicating if "lab" was used
  --    updated environment
  --    code buffer  
  fun compile (lab, env, stmt) {
    case stmt of
      Skip           -> [false, env, emptyBuffer ()]
    | Read  (x)      -> [false, env, singletonBuffer (READ) <+ ST (x)]
    | Write (e)      -> [false, env, compileExpr (e) <+ WRITE]
    | Assn  (x, e)   -> [false, env, compileExpr (e) <+ ST (x)]
    | Seq   (s1, s2) ->
      let [s2Lab, env] = env.genLabel in
      let [s2LabUsed, env, s1Code] = compile (s2Lab, env, s1) in
      let [labUsed, env, s2Code] = compile (lab, env, s2) in
      [labUsed, env, s1Code <+> label (s2Lab, s2LabUsed) <+> s2Code]
    | If (c, t, e)   ->
      let cCode = compileExpr (c) in
      let [_, env, tCode] = compile (lab, env, t) in
      let [_, env, eCode] = compile (lab, env, e) in
      let [eLab, env] = env.genLabel in
      let code =  cCode <+ CJMP("z", eLab) <+> 
                  tCode <+ JMP (lab) <+
                  LABEL (eLab) <+> eCode in
      [true, env, code]
    | While (c, b) ->
      let cCode = compileExpr (c) in
      let [cLab, env]= env.genLabel in
      let [_, env, bCode] = compile (cLab, env, b) in
      let code =  singletonBuffer (LABEL (cLab)) <+> cCode <+
                  CJMP("z", lab) <+> bCode <+ JMP (cLab) in
      [true, env, code]
    | DoWhile (b, c) ->
      let cCode = compileExpr (c) in
      let [sLab, cLab, env] = env.genLabels (2) in
      let [cLabUsed, env, bCode ] = compile (cLab, env, b) in
      let code =  singletonBuffer (LABEL (sLab)) <+> bCode <+>
                  label (cLab, cLabUsed) <+> cCode <+
                  CJMP("nz", sLab) in
      [false, env, code]
    | _              -> failure ("compileSM not implemented\n")
    esac
  }  

  let [endLab, env] = initCompEnv ().genLabel in
  let [endLabUsed, _, code] = compile (endLab, env, stmt) in 
  getBuffer $ code <+> label (endLab, endLabUsed)
}
