-- Stack machine.

import Array;
import List;
import Fun;
import Collection;
import World;
import State;
import Expr;
import Buffer;
import Fun;

-- Stack code printer. Takes a list of SM instructions, return its
-- string representation.
public fun showSMInsn (i) {
  case i of
    READ         -> "READ"
  | WRITE        -> "WRITE"
  | BINOP (s)    -> sprintf ("BINOP %s", s)
  | LD    (x)    -> sprintf ("LD %s", x)
  | LDA   (x)    -> sprintf ("LDA %s", x)
  | ST    (x)    -> sprintf ("ST %s", x)
  | STI          -> "STI"
  | CONST (n)    -> sprintf ("CONST %d", n)
  | LABEL (s)    -> sprintf ("LABEL %s", s)
  | JMP   (l)    -> sprintf ("JMP %s", l)
  | CJMP  (c, l) -> sprintf ("CJMP %s, %s", c, l)
  | DUP          -> "DUP"
  | DROP         -> "DROP"  
  esac
}

public fun showSM (prg) {
  map (fun (i) {showSMInsn (i) ++ "\n"}, prg).stringcat
}

-- Evaluation environment: keeps a mapping between labels and (sub)programs
fun initEvalEnv (insns) {
  var map =
    fix (fun (rec) {
          fun ([m, insns]) {
            case insns of
              {}               -> m
            | LABEL (lab) : tl -> rec ([addMap (m, lab, insns), tl])
            | _ : tl           -> rec ([m, tl])
            esac
          }
        }) $ [emptyMap (compare), insns];
  
  [fun (l) {
     case findMap (map, l) of Some (insns) -> insns esac
  }]
}

-- Accessor function
fun fromLabel (env, lab) {
  env [0] (lab)
}

-- Stack machine interpreter. Takes an environment, an SM-configuration and a program,
-- returns a final configuration
fun eval (env, c, insns) {
  case insns of
    {} -> c
  | insn : tail ->
      let [stack, s, w] = c in
      case insn of
        READ ->
          let [v, w1] = readWorld (w) in
          eval (env, [v : stack, s, w1], tail)
        | WRITE ->
            let v : stack1 = stack in
            eval (env, [stack1, s, writeWorld (v, w)], tail)
        | BINOP (op) ->
            let y : x : stack1 = stack in
            eval (env, [evalOp (op, x, y) : stack1, s, w], tail)
        | LD (x) ->
            eval (env, [s (x) : stack, s, w], tail)
        | LDA (x) ->
            eval (env, [x : stack, s, w], tail)
        | ST (x) ->
            let v : stack1 = stack in
            eval (env, [stack1, s <- [x, v], w], tail)
        | STI ->
            let v : addr : stack1 = stack in
            eval (env, [v : stack1, s <- [addr, v], w], tail)
        | CONST (n) ->
            eval (env, [n : stack, s, w], tail)
        | LABEL (_) ->
            eval (env, c, tail)
        | JMP (l) ->
            eval (env, c, fromLabel (env, l))
        | CJMP (cond, l) ->
            let v : stack1 = stack in
            eval (env, [stack1, s, w],
                  case cond of
                    "z"  -> if v == 0 then fromLabel (env, l) else tail fi
                  | "nz" -> if v != 0 then fromLabel (env, l) else tail fi
                  esac)
        | DUP ->
            let v : _ = stack in
            eval (env, [v : stack, s, w], tail)
        | DROP ->
            let _ : stack1 = stack in
            eval (env, [stack1, s, w], tail)
      esac
  esac
}

-- Runs a stack machine for a given input and a given program, returns an output
public fun evalSM (input, insns) {
  eval (initEvalEnv (insns), [{}, emptyState, createWorld (input)], insns)[2].getOutput
}

-- Compilation environment: generates labels
fun makeCompEnv (n) {
  [fun () {
     [sprintf ("L%d", n), makeCompEnv (n+1)]
  }]
}

fun initCompEnv () {
  makeCompEnv (0)
}

-- Accessor function: generates one label
fun genLabel (env) {
  env [0] ()
}

-- Utility function: generates n labels
fun genLabels (env, n) {
  fun inner (env, n) {
    if n == 0
    then {env}
    else case env.genLabel of
           [lab, env] -> lab : inner (env, n-1)
         esac
    fi
  }

  listArray (inner (env, n))
}

-- Compiles an expression into a stack machine code.
-- Takes an expression, returns a list of stack machine
-- instructions.
public fun compileSM (stmt) {
  fun label (lab, labUsed) {
    if labUsed
    then singletonBuffer (LABEL (lab))
    else emptyBuffer ()
    fi
  }
  
  fun compile (lab, env, stmt) {
    case stmt of
      Skip              -> [false, env, emptyBuffer ()]
      | Var    (x)        -> [false, env, singletonBuffer (LD (x))]
      | Ref    (x)        -> [false, env, singletonBuffer (LDA (x))]
      | Const  (n)        -> [false, env, singletonBuffer (CONST (n))]
      | Read (x)          -> [false, env, singletonBuffer (READ) <+ ST (x)]
      | Write (e) ->
          case env.genLabel of
            [lbl, env] ->
              case compile (lbl, env, e) of
                [labUsed, env, eCode] ->
                  [false, env, eCode <+> label (lbl, labUsed) <+ WRITE]
              esac
          esac
      | Assn (l, r) ->
          case env.genLabel of
            [lblL, env] ->
              case env.genLabel of
                [lblR, env] ->
                  case compile (lblL, env, l) of
                    [labUsedL, env, lCode] ->
                      case compile (lblR, env, r) of
                        [labUsedR, env, rCode] ->
                          [false, env,
                          lCode <+> label (lblL, labUsedL) <+>
                          rCode <+> label (lblR, labUsedR) <+ STI]
                      esac
                  esac
              esac
          esac
      | Binop (op, l, r) ->
          case env.genLabel of
            [lblL, env] ->
              case env.genLabel of
                [lblR, env] ->
                  case compile (lblL, env, l) of
                    [labUsedL, env, lCode] ->
                      case compile (lblR, env, r) of
                        [labUsedR, env, rCode] ->
                          [false, env,
                          lCode <+> label (lblL, labUsedL) <+>
                          rCode <+> label (lblR, labUsedR) <+ BINOP (op)]
                      esac
                  esac
              esac
          esac
      | Ignore (e) ->
          case env.genLabel of
            [lbl, env] ->
              case compile (lbl, env, e) of
                [labUsed, env, eCode] ->
                  [false, env, eCode <+> label (lbl, labUsed) <+ DROP]
              esac
          esac
      | Seq (s1, s2) ->
          case env.genLabel of
            [s2Lab, env] ->
              case compile (s2Lab, env, s1) of
                [s2LabUsed, env, s1Code] ->
                  case compile (lab, env, s2) of
                    [labUsed, env, s2Code] ->
                      [labUsed, env, s1Code <+> label (s2Lab, s2LabUsed) <+> s2Code]
                  esac
              esac
          esac
      | If (e, s1, s2) ->
          case env.genLabel of
            [elseLab, env] ->
              case compile (lab, env, e) of
                [_, env, eCode] ->
                  case compile (lab, env, s1) of
                    [_, env, thenCode] ->
                      case compile (lab, env, s2) of
                        [_, env, elseCode] ->
                          [true, env,
                          eCode <+ CJMP ("z", elseLab) <+>
                          thenCode <+ JMP (lab) <+>
                          singletonBuffer (LABEL (elseLab)) <+>
                          elseCode]
                      esac
                  esac
              esac
          esac
      | While (e, body) ->
          case env.genLabel of
            [condLab, env] ->
              case env.genLabel of
                [loopLab, env] ->
                  case compile (condLab, env, body) of
                    [_, env, bodyCode] ->
                      case compile (condLab, env, e) of
                        [_, env, eCode] ->
                          [false, env,
                          singletonBuffer (JMP (condLab)) <+>
                          singletonBuffer (LABEL (loopLab)) <+>
                          bodyCode <+>
                          singletonBuffer (LABEL (condLab)) <+>
                          eCode <+ CJMP ("nz", loopLab)]
                      esac
                  esac
              esac
          esac
      | DoWhile (body, e) ->
          case env.genLabel of
            [loopLab, env] ->
              case env.genLabel of
                [condLab, env] ->
                  case compile (condLab, env, body) of
                    [_, env, bodyCode] ->
                      case compile (condLab, env, e) of
                        [_, env, eCode] ->
                          [false, env,
                          singletonBuffer (LABEL (loopLab)) <+>
                          bodyCode <+>
                          singletonBuffer (LABEL (condLab)) <+>
                          eCode <+ CJMP ("nz", loopLab)]
                      esac
                  esac
              esac
          esac
      esac
  }

  case initCompEnv ().genLabel of
    [endLab, env] ->
       case compile (endLab, env, stmt) of
         [endLabUsed, _, code] -> getBuffer $ code <+> label (endLab, endLabUsed) 
       esac
  esac
}
