-- Stack machine.

import Array;
import List;
import Fun;
import Collection;
import World;
import State;
import Expr;
import Buffer;

-- Stack code printer. Takes a list of SM instructions, return its
-- string representation.
public fun showSMInsn (i) {
  case i of
    READ         -> sprintf ("READ")
  | WRITE        -> sprintf ("WRITE")
  | BINOP (s)    -> sprintf ("BINOP %s", s)
  | LD    (x)    -> sprintf ("LD %s", x)
  | ST    (x)    -> sprintf ("ST %s", x)
  | CONST (n)    -> sprintf ("CONST %d", n)
  | LABEL (s)    -> sprintf ("LABEL %s", s)
  | JMP   (l)    -> sprintf ("JMP %s", l)
  | CJMP  (c, l) -> sprintf ("CJMP %s, %s", c, l)
  esac
}

public fun showSM (prg) {
  map (fun (i) {showSMInsn (i) ++ "\n"}, prg).stringcat
}

-- Evaluation environment: keeps a mapping between labels and (sub)programs
fun initEvalEnv (insns) {
  var map =
    fix (fun (rec) {
          fun ([m, insns]) {
            case insns of
              {}               -> m
            | LABEL (lab) : tl -> rec ([addMap (m, lab, insns), tl])
            | _ : tl           -> rec ([m, tl])
            esac
          }
        }) $ [emptyMap (compare), insns];
  
  [fun (l) {
     case findMap (map, l) of Some (insns) -> insns esac
  }]
}

-- Accessor function
fun fromLabel (env, lab) {
  env [0] (lab)
}

-- Stack machine interpreter. Takes an environment, an SM-configuration and a program,
-- returns a final configuration
fun eval (env, c, insns) {
  case insns of
    {} -> c
  | i : rest ->
      var stack = c[0];
      var st = c[1];
      var w = c[2];
      case i of
        CONST (n) -> eval (env, [n : stack, st, w], rest)
      | LD (x) -> eval (env, [st (x) : stack, st, w], rest)
      | ST (x) -> eval (env, [stack.tl, st <- [x, stack.hd], w], rest)
      | BINOP (op) ->
          var r = stack.hd;
          var l = stack.tl.hd;
          var res = case op of
             "+"  -> l + r
          | "-"  -> l - r
          | "*"  -> l * r
          | "/"  -> l / r
          | "%"  -> l % r
          | "<"  -> if l < r then 1 else 0 fi
          | "<=" -> if l <= r then 1 else 0 fi
          | ">"  -> if l > r then 1 else 0 fi
          | ">=" -> if l >= r then 1 else 0 fi
          | "==" -> if l == r then 1 else 0 fi
          | "!=" -> if l != r then 1 else 0 fi
          | "&&" -> if l != 0 && r != 0 then 1 else 0 fi
          | "!!" -> if l != 0 then 1 else if r != 0 then 1 else 0 fi fi
          esac;
          eval (env, [res : stack.tl.tl, st, w], rest)
      | READ ->
          var rw = readWorld (w);
          eval (env, [rw.fst : stack, st, rw.snd], rest)
      | WRITE -> eval (env, [stack.tl, st, writeWorld (stack.hd, w)], rest)
      | LABEL (_) -> eval (env, c, rest)
      | JMP (l) -> eval (env, c, fromLabel (env, l))
      | CJMP (cond, l) ->
          var v = stack.hd;
          var c1 = [stack.tl, st, w];
          case cond of
            "z"  -> if v == 0 then eval (env, c1, fromLabel (env, l)) else eval (env, c1, rest) fi
          | "nz" -> if v != 0 then eval (env, c1, fromLabel (env, l)) else eval (env, c1, rest) fi
          esac
      esac
  esac
}

-- Runs a stack machine for a given input and a given program, returns an output
public fun evalSM (input, insns) {
  eval (initEvalEnv (insns), [{}, emptyState, createWorld (input)], insns)[2].getOutput
}

-- Compilation environment: generates labels
fun makeCompEnv (n) {
  [fun () {
     [sprintf ("L%d", n), makeCompEnv (n+1)]
  }]
}

fun initCompEnv () {
  makeCompEnv (0)
}

-- Accessor function: generates one label
fun genLabel (env) {
  env [0] ()
}

-- Utility function: generates n labels
fun genLabels (env, n) {
  fun inner (env, n) {
    if n == 0
    then {env}
    else case env.genLabel of
           [lab, env] -> lab : inner (env, n-1)
         esac
    fi
  }

  listArray (inner (env, n))
}

-- Compiles an expression into a stack machine code.
-- Takes an expression, returns a list of SM instructions.
fun compileExpr (expr) {
  case expr of
    Const (n) -> {CONST (n)}
  | Var (x) -> {LD (x)}
  | Binop (op, l, r) -> compileExpr (l) +++ compileExpr (r) +++ {BINOP (op)}
  esac
}

-- Compiles a statement into a stack machine code.
-- Takes a statement, returns a list of stack machine instructions.
public fun compileSM (stmt) {
  fun compile (env, stmt) {
    case stmt of
      Assn (s, expr) -> [env, compileExpr (expr) +++ {ST (s)}]
    | Seq (st1, st2) ->
        case compile (env, st1) of
          [env, c1] ->
            case compile (env, st2) of
              [env, c2] -> [env, c1 +++ c2]
            esac
        esac
    | Skip -> [env, {}]
    | Read (s) -> [env, {READ, ST (s)}]
    | Write (expr) -> [env, compileExpr (expr) +++ {WRITE}]
    | If (expr, thn, els) ->
        case genLabels (env, 2) of
          [elseLab, endLab, env] ->
            case compile (env, thn) of
              [env, thnCode] ->
                case compile (env, els) of
                  [env, elsCode] ->
                    [env, compileExpr (expr) +++ {CJMP ("z", elseLab)} +++
                          thnCode +++ {JMP (endLab), LABEL (elseLab)} +++
                          elsCode +++ {LABEL (endLab)}]
                esac
            esac
        esac
    | While (expr, body) ->
        case genLabels (env, 2) of
          [startLab, endLab, env] ->
            case compile (env, body) of
              [env, bodyCode] ->
                [env, {LABEL (startLab)} +++ compileExpr (expr) +++ {CJMP ("z", endLab)} +++
                      bodyCode +++ {JMP (startLab), LABEL (endLab)}]
            esac
        esac
    | DoWhile (body, expr) ->
        case genLabel (env) of
          [startLab, env] ->
            case compile (env, body) of
              [env, bodyCode] ->
                [env, {LABEL (startLab)} +++ bodyCode +++ compileExpr (expr) +++ {CJMP ("nz", startLab)}]
            esac
        esac
    esac
  }

  case compile (initCompEnv (), stmt) of
    [_, code] -> code
  esac
}
