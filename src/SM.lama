-- Stack machine.
import Array;
import List;
import Fun;
import Collection;
import World;
import State;
import Expr;
import Buffer;

-- Stack code printer. Takes a list of SM instructions, return its
-- string representation.
public fun showSMInsn (i) {
   case i of
     READ       -> sprintf("READ")
   | WRITE      -> sprintf("WRITE")
   | BINOP(s)   -> sprintf("BINOP %s", s)
   | LD(x)      -> sprintf("LD %s", x)
   | ST(x)      -> sprintf("ST %s", x)
   | CONST(n)   -> sprintf("CONST %d", n)
   | LABEL(s)   -> sprintf("LABEL %s", s)
   | JMP(l)     -> sprintf("JMP %s", l)
   | CJMP(c, l) -> sprintf("CJMP %s, %s", c, l)
   | _          -> failure("SM.showSMIns")
   esac
}
public fun showSM (prg) {
   map(fun (i) {showSMInsn(i) ++ "\n"}, prg).stringcat
}
-- Evaluation environment: keeps a mapping between labels and (sub)programs
fun initEvalEnv (insns) {
   var map = fix(fun (rec) {
                           fun ([m, insns]) {
                              case insns of
                                {}             -> m
                              | LABEL(lab): tl -> rec([addMap(m, lab, insns), tl])
                              | _: tl          -> rec([m, tl])
                              esac
                           }
                        }) $ [emptyMap(compare), insns];
   
   [fun (l) {
       case findMap(map, l) of
         Some(insns) -> insns
       esac
    }]
}
-- Accessor function
fun fromLabel (env, lab) {
   env[0](lab)
}
-- Stack machine interpreter. Takes an environment, an SM-configuration and a program,
-- returns a final configuration
fun eval (env, [stack, state, world], inses) {
   case inses of
     instruction: ins -> case instruction of
              READ       -> let [word, world1] = readWorld(world) in
                              eval(env, [word : stack, state, world1], ins)
            | WRITE      -> let word: tail = stack in
                              let world1 = writeWorld(word, world) in eval(env, [tail, state, world1], ins)
            | BINOP(s)   -> let w1: w2: tail = stack in
                              let stack1 = evalOp(s, w1, w2) : tail in eval(env, [stack1, state, world], ins)
            | ST(x)      -> let word: tail = stack in
                              let state1 = state <- [x, word] in eval(env, [tail, state1, world], ins)
            | LD(x)      -> let word = state(x) in eval(env, [word : stack, state, world], ins)
            | CONST(n)   -> eval(env, [n : stack, state, world], ins)
            | LABEL(s)   -> eval(env, [stack, state, world], ins)
            | JMP(l)     -> eval(env, [stack, state, world], fromLabel(env, l))
            | CJMP(c, l) -> let w1: tail = stack in
                              let todo = case c of
                                            "z"  -> if w1 == 0 then fromLabel(env, l) else ins fi
                                          | "nz" -> if w1 == 0 then ins else fromLabel(env, l) fi
                                          esac in eval(env, [stack, state, world], todo)
            | _          -> failure("SM.eval not implemented")
            esac
   | {}               -> [stack, state, world]
   | _                -> failure("SM.eval not implemented")
   esac
}
-- Runs a stack machine for a given input and a given program, returns an output
public fun evalSM (input, insns) {
   eval(initEvalEnv(insns), [{}, emptyState, createWorld(input)], insns)[2].getOutput
}
-- Compilation environment: generates labels
fun makeCompEnv (n) {
   [fun () {[sprintf("L%d", n), makeCompEnv(n + 1)]}]
}
fun initCompEnv () {
   makeCompEnv(0)
}
-- Accessor function: generates one label
fun genLabel (env) {
   env[0]()
}
-- Utility function: generates n labels
fun genLabels (env, n) {
   fun inner (env, n) {
      if n == 0 then {env}
      else case env.genLabel of
             [lab, env] -> lab : inner(env, n - 1)
           | _          -> failure("SM.genLabels")
           esac
      fi
   }
   
   listArray(inner(env, n))
}
-- Compiles an expression into a stack machine code.
-- Takes an expression, returns a list of stack machine instructions
fun compileExpr (expr) {
   var res = case expr of
     Var(s)                  -> singletonBuffer(LD(s))
   | Const(x)                -> singletonBuffer(CONST(x))
   | Binop(op, expr1, expr2) -> compileExpr(expr2) <+> compileExpr(expr1) <+> singletonBuffer(BINOP(op))
   | _                       -> failure("SM.compileExpr not implemented")
   esac;
   
  --  printf("Sm.compileExpr done %s\n", expr.string);
   res
}
-- Compiles a statement into a stack machine code.
-- Takes a statement, returns a list of stack machine
-- instructions.
public fun compileSM (stmt) {
   -- Generates a buffer with an optional label
   --    lab     --- the name of the label
   --    labUsed --- a flag if the lebel is needed
   fun label (lab, labUsed) {
      if labUsed then singletonBuffer(LABEL(lab)) else emptyBuffer() fi
   }
   -- Generates SM code for a given statement
   --    lab  --- a label th go to after the statement is executed
   --    env  --- compilation environment
   --    stmt --- a statement to generate SM code for
   -- Returns a triple:
   --    boolean flag indicating if "lab" was used
   --    updated environment
   --    code buffer  
   fun compile (lab, env, stmt) {
      var res = case stmt of
             Skip        -> [false, env, emptyBuffer()]
           | Read(x)     -> [false, env, singletonBuffer(READ) <+ ST(x)]
           | Write(e)    -> [false, env, compileExpr(e) <+ WRITE]
           | Assn(x, e)  -> [false, env, compileExpr(e) <+ ST(x)]
           | Seq(s1, s2) -> let [s2Lab, env] = env.genLabel in
                                let [s2LabUsed, env, s1Code] = compile(s2Lab, env, s1) in
                                    let [labUsed, env, s2Code] = compile(lab, env, s2) in
                                        [labUsed, env, s1Code <+> label(s2Lab, s2LabUsed) <+> s2Code]
            
            | If (e, stmt1, stmt2) -> let [elseLabel, env] = env.genLabel  in
            let [labUsedThen, env, thenCode] = compile (lab, env, stmt1) in
                let [labUsedElse, env, elseCode] = compile (lab, env, stmt2) in
                    [true, env,
                     compileExpr (e) <+ CJMP ("z", elseLabel)
                     <+> thenCode <+ JMP (lab)
                     <+> singletonBuffer (LABEL (elseLabel))
                     <+> elseCode]
              
          
        
    | While (e, stmt) ->
        case env.genLabel of
          [condLabel, env] ->
            case env.genLabel of
              [loopLabel, env] ->
                case compile (condLabel, env, stmt) of
                  [_, env, stmtCode] ->
                    [false, env,
                     singletonBuffer (JMP (condLabel))
                     <+> singletonBuffer (LABEL (loopLabel))
                     <+> stmtCode
                     <+> singletonBuffer (LABEL (condLabel))
                     <+> compileExpr (e) <+ CJMP ("nz", loopLabel)]
                esac
            esac
        esac
    | DoWhile (stmt, e) ->
        let [loopLabel, env] = env.genLabel in
           let [condLabel, env] =  env.genLabel in
            let [_, env, stmtCode] = compile (condLabel, env, stmt) in
                    [false, env,
                     singletonBuffer (LABEL (loopLabel))
                     <+> stmtCode
                     <+> singletonBuffer (LABEL (condLabel))
                     <+> compileExpr (e) <+ CJMP ("nz", loopLabel)]
              
           | _           -> printf("SM.compileSM not implemented\n")
           esac;
      
      -- printf("SM.compile done %s\n", stmt.string);
      res
   }
   var res = case initCompEnv().genLabel of
              [endLab, env] -> case compile(endLab, env, stmt) of
                                 [endLabUsed, _, code] -> getBuffer $ code <+> label(endLab, endLabUsed)
                               | _                     -> failure("SM.initCompEnv not implemented")
                               esac
            | _             -> failure("SM.compileSM not implemented")
            esac;
   
  --  printf("SM.compileSM done\n");
   res
}