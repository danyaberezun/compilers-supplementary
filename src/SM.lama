-- Stack machine.

import Array;
import List;
import Fun;
import Collection;
import World;
import State;
import Expr;
import Buffer;

-- Stack code printer. Takes a list of SM instructions, return its
-- string representation.
public fun showSMInsn (i) {
  case i of
    READ         -> sprintf ("READ")
  | WRITE        -> sprintf ("WRITE")
  | BINOP (s)    -> sprintf ("BINOP %s", s)
  | LD    (x)    -> sprintf ("LD %s", x)
  | ST    (x)    -> sprintf ("ST %s", x)
  | CONST (n)    -> sprintf ("CONST %d", n)
  | LABEL (s)    -> sprintf ("LABEL %s", s)
  | JMP   (l)    -> sprintf ("JMP %s", l)
  | CJMP  (c, l) -> sprintf ("CJMP %s, %s", c, l)
  esac
}

public fun showSM (prg) {
  map (fun (i) {showSMInsn (i) ++ "\n"}, prg).stringcat
}

-- Evaluation environment: keeps a mapping between labels and (sub)programs
fun initEvalEnv (insns) {
  var map =
    fix (fun (rec) {
          fun ([m, insns]) {
            case insns of
              {}               -> m
            | LABEL (lab) : tl -> rec ([addMap (m, lab, insns), tl])
            | _ : tl           -> rec ([m, tl])
            esac
          }
        }) $ [emptyMap (compare), insns];
  
  [fun (l) {
     case findMap (map, l) of Some (insns) -> insns esac
  }]
}

-- Accessor function
fun fromLabel (env, lab) {
  env [0] (lab)
}

-- Stack machine interpreter. Takes an environment, an SM-configuration and a program,
-- returns a final configuration
fun eval (env, c, insns) {
  let [stack, st, w] = c in
    case insns of
      {} -> c
    | i:is ->
        case i of
          READ -> let [v, w1] = readWorld (w) in eval (env, [v:stack, st, w1], is)
        | WRITE -> let v:stack1 = stack in eval (env, [stack1, st, writeWorld (v, w)], is)
        | LD (x) -> eval (env, [st (x):stack, st, w], is)
        | ST (x) -> let v:stack1 = stack in eval (env, [stack1, st <- [x, v], w], is)
        | CONST (n) -> eval (env, [n:stack, st, w], is)
        | BINOP (op) ->
            let r:(l:stack1) = stack in
              eval (env, [applyBinop (op, l, r):stack1, st, w], is)
        | LABEL (_) -> eval (env, c, is)
        | JMP (lab) -> eval (env, c, fromLabel (env, lab))
        | CJMP (cond, lab) ->
            let z:stack1 = stack in
              case cond of
                "z" -> if z == 0 then eval (env, [stack1, st, w], fromLabel (env, lab))
                       else eval (env, [stack1, st, w], is)
                       fi
              | "nz" -> if z != 0 then eval (env, [stack1, st, w], fromLabel (env, lab))
                         else eval (env, [stack1, st, w], is)
                         fi
              | _ -> failure ("unknown jump condition %s\n", cond)
              esac
        esac
    esac
}

-- Runs a stack machine for a given input and a given program, returns an output
public fun evalSM (input, insns) {
  eval (initEvalEnv (insns), [{}, emptyState, createWorld (input)], insns)[2].getOutput
}

-- Compilation environment: generates labels
fun makeCompEnv (n) {
  [fun () {
     [sprintf ("L%d", n), makeCompEnv (n+1)]
  }]
}

fun initCompEnv () {
  makeCompEnv (0)
}

-- Accessor function: generates one label
fun genLabel (env) {
  env [0] ()
}

-- Compiles an expression into a stack machine code.
-- Takes an expression, returns a list of stack machine instructions
fun compileExpr (expr) {
   case expr of
     Var (x) -> {LD (x)}
   | Const (n) -> {CONST (n)}
   | Binop (op, l, r) -> compileExpr (l) +++ compileExpr (r) +++ {BINOP (op)}
   esac
}

-- Compiles a statement into a stack machine code.
-- Takes a statement, returns a list of stack machine
-- instructions.
fun compile (env, stmt) {
  case stmt of
    Assn (x, e) -> [compileExpr (e) +++ {ST (x)}, env]
  | Seq (s1, s2) ->
      case compile (env, s1) of
        [c1, env] ->
          case compile (env, s2) of
            [c2, env] -> [c1 +++ c2, env]
          esac
      esac
  | Skip -> [{}, env]
  | Read (x) -> [{READ, ST (x)}, env]
  | Write (e) -> [compileExpr (e) +++ {WRITE}, env]
  | If (e, s1, s2) ->
      case env.genLabel of
        [elseLab, env] ->
          case env.genLabel of
            [endLab, env] ->
              case compile (env, s1) of
                [c1, env] ->
                  case compile (env, s2) of
                    [c2, env] ->
                      [compileExpr (e) +++
                       {CJMP ("z", elseLab)} +++
                       c1 +++
                       {JMP (endLab), LABEL (elseLab)} +++
                       c2 +++
                       {LABEL (endLab)},
                       env]
                  esac
              esac
          esac
      esac
  | While (e, s) ->
      case env.genLabel of
        [bodyLab, env] ->
          case env.genLabel of
            [condLab, env] ->
              case compile (env, s) of
                [c, env] ->
                  [{JMP (condLab), LABEL (bodyLab)} +++
                   c +++
                   {LABEL (condLab)} +++
                   compileExpr (e) +++
                   {CJMP ("nz", bodyLab)},
                   env]
              esac
          esac
      esac
  esac
}

public fun compileSM (stmt) {
  case compile (initCompEnv (), stmt) of
    [code, _] -> code
  esac
}
