-- Stack machine.

import Array;
import List;
import Fun;
import Collection;
import World;
import State;
import Expr;
import Buffer;
import Fun;

-- Stack code printer. Takes a list of SM instructions, return its
-- string representation.
public fun showSMInsn (i) {
  case i of
    READ         -> "READ"
  | WRITE        -> "WRITE"
  | BINOP (s)    -> sprintf ("BINOP %s", s)
  | LD    (x)    -> sprintf ("LD %s", x)
  | LDA   (x)    -> sprintf ("LDA %s", x)
  | ST    (x)    -> sprintf ("ST %s", x)
  | STI          -> "STI"
  | CONST (n)    -> sprintf ("CONST %d", n)
  | LABEL (s)    -> sprintf ("LABEL %s", s)
  | JMP   (l)    -> sprintf ("JMP %s", l)
  | CJMP  (c, l) -> sprintf ("CJMP %s, %s", c, l)
  | DUP          -> "DUP"
  | DROP         -> "DROP"  
  esac
}

public fun showSM (prg) {
  map (fun (i) {showSMInsn (i) ++ "\n"}, prg).stringcat
}

-- Evaluation environment: keeps a mapping between labels and (sub)programs
fun initEvalEnv (insns) {
  var map =
    fix (fun (rec) {
          fun ([m, insns]) {
            case insns of
              {}               -> m
            | LABEL (lab) : tl -> rec ([addMap (m, lab, insns), tl])
            | _ : tl           -> rec ([m, tl])
            esac
          }
        }) $ [emptyMap (compare), insns];
  
  [fun (l) {
     case findMap (map, l) of Some (insns) -> insns esac
  }]
}

-- Accessor function
fun fromLabel (env, lab) {
  env [0] (lab)
}

-- Stack machine interpreter. Takes an environment, an SM-configuration and a program,
-- returns a final configuration
fun eval (env, c, insns) {
  case insns of
    {}        -> c
  | insn : insns_new -> let [stack, state, w] = c in
                        case insn of
                          READ       -> let [n, w_new] = readWorld (w) in eval (env, [n : stack, state, w_new], insns_new)
                        | WRITE      -> let n : stack_new = stack in eval (env, [stack_new, state, writeWorld(n, w)], insns_new)
                        | BINOP(op)  -> let a : b : stack_new = stack in
                                          eval
                                          (
                                            env,
                                            [(case op of
                                                "+"  -> b + a
                                              | "-"  -> b - a
                                              | "*"  -> b * a
                                              | "/"  -> b / a
                                              | "%"  -> b % a
                                              | "<"  -> b < a
                                              | "<=" -> b <= a
                                              | ">"  -> b > a
                                              | ">=" -> b >= a
                                              | "==" -> b == a
                                              | "!=" -> b != a
                                              | "!!" -> b !! a
                                              | "&&" -> b && a
                                              | _    -> failure("Unknown operator: %s\n", op)
                                              esac) : stack_new, state, w],
                                            insns_new
                                          )
                        | LD(x)      -> eval (env, [state (x) : stack, state, w], insns_new)
                        | LDA(x)     -> eval (env, [x : stack, state, w], insns_new)
                        | ST(x)      -> let n : stack_new = stack in eval (env, [stack_new, state <- [x, n], w], insns_new)
                        | STI        -> let n : x : stack_new = stack in eval(env, [n : stack_new, state <- [x, n], w], insns_new)
                        | CONST(n)   -> eval (env, [n : stack, state, w], insns_new)
                        | LABEL(s)   -> eval (env, c, insns_new)
                        | JMP(l)     -> let [findLabel] = env in eval (env, c, findLabel(l))
                        | CJMP(x, l) -> let n : stack_new = stack in
                                        case x of
                                          "z"  -> case n of
                                                    0 -> let [findLabel] = env in eval (env, [stack_new, state, w], findLabel(l))
                                                  | _ -> eval (env, [stack_new, state, w], insns_new)
                                                  esac
                                        | "nz" -> case n of
                                                    0 -> eval (env, [stack_new, state, w], insns_new)
                                                  | _ -> let [findLabel] = env in eval (env, [stack_new, state, w], findLabel(l))
                                                  esac
                                        | _    -> failure("unsupported conditional jump: %s\n", c)
                                        esac
                        | DUP        -> let n : _ = stack in
                                        eval(env, [n : stack, state, w], insns_new)
                        | DROP       -> let n : stack1 = stack in
                                        eval(env, [stack1, state, w], insns_new)
                        esac
  esac
}

-- Runs a stack machine for a given input and a given program, returns an output
public fun evalSM (input, insns) {
  eval (initEvalEnv (insns), [{}, emptyState, createWorld (input)], insns)[2].getOutput
}

-- Compilation environment: generates labels
fun makeCompEnv (n) {
  [fun () {
     [sprintf ("L%d", n), makeCompEnv (n+1)]
  }]
}

fun initCompEnv () {
  makeCompEnv (0)
}

-- Accessor function: generates one label
fun genLabel (env) {
  env [0] ()
}

-- Utility function: generates n labels
fun genLabels (env, n) {
  fun inner (env, n) {
    if n == 0
    then {env}
    else case env.genLabel of
           [lab, env] -> lab : inner (env, n-1)
         esac
    fi
  }

  listArray (inner (env, n))
}

-- Compiles an expression into a stack machine code.
-- Takes an expression, returns a list of stack machine
-- instructions.
public fun compileSM (stmt) {
  fun label (lab, labUsed) {
    if labUsed
    then singletonBuffer (LABEL (lab))
    else emptyBuffer ()
    fi
  }
  
  fun compile (lab, env, stmt) {
    case stmt of
      Skip              -> [false, env, emptyBuffer ()]
    | Var    (x)        -> [false, env, singletonBuffer (LD (x))]
    | Ref    (x)        -> [false, env, singletonBuffer (LDA (x))]
    | Const  (n)        -> [false, env, singletonBuffer (CONST (n))]
    | Assn(Ref(x), e)   -> let [lab1, env1, insns1] = compile(lab, env, e) in
                           [lab1, env1, insns1 <+ DUP <+ ST (x)]
    | Assn(e1, e2)      -> let [lab1, env1, insns1] = compile(lab, env, e1) in
                           let [lab2, env2, insns2] = compile(lab1, env1, e2) in
                           [lab2, env2, insns1 <+> insns2 <+ STI]
    | Seq(e1, e2)       -> let [lab1, env1, insns1] = compile (lab, env, e1) in
                           let [lab2, env2, insns2] = compile (lab1, env1, e2) in
                           [lab2, env2, insns1 <+> insns2]
    | Read(x)           -> [false, env, singletonBuffer (READ) <+ ST (x)]
    | Write(e)          -> let [lab1, env1, insns1] = compile(lab, env, e) in
                           [lab1, env1, insns1 <+ WRITE]
    | If(e1, e2, e3)    -> let [l1, l2, env]           = genLabels(env, 2) in
                           let [lab1, env1, condition] = compile(lab, env, e1) in
                           let [lab2, env2, if_body]   = compile(lab1, env1, e2) in
                           let [lab3, env3, else_body] = compile(lab2, env2, e3) in
                           [lab3, env3, condition <+ CJMP("z", l1) <+> if_body <+ JMP(l2) <+ LABEL(l1) <+> else_body <+ LABEL(l2)]
    | While(e1, e2)     -> let [l1, l2, env]  = genLabels(env, 2) in
                           let [lab1, env1, loop_body] = compile (lab, env, e2) in
                           let [lab2, env2, condition] = compile (lab1, env1, e1) in
                           [lab2, env2, singletonBuffer(JMP(l2)) <+ LABEL(l1) <+> loop_body <+ LABEL(l2) <+> condition <+ CJMP("nz", l1)]

    | DoWhile(e1, e2)   -> let [l, env] = genLabel(env) in
                           let [lab1, env1, loop_body] = compile (lab, env, e1) in
                           let [lab2, env2, condition] = compile (lab1, env1, e2) in
                           [lab2, env2, singletonBuffer(LABEL(l)) <+> loop_body <+> condition <+ CJMP("nz", l)]
    | Binop(op, e1, e2) -> let [lab1, env1, insns1] = compile (lab, env, e1) in
                           let [lab2, env2, insns2] = compile (lab1, env1, e2) in
                           [lab2, env2, insns1 <+> insns2 <+ BINOP(op)]
    | Ignore(e)         -> let [lab1, env1, insns1] = compile(lab, env, e) in
                           [lab1, env1, insns1 <+ DROP]
    esac
  }

  case initCompEnv ().genLabel of
    [endLab, env] ->
       case compile (endLab, env, stmt) of
         [endLabUsed, _, code] -> getBuffer $ code <+> label (endLab, endLabUsed) 
       esac
  esac
}
