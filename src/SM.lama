-- Stack machine.

import Ref;
import Array;
import List;
import Fun;
import Collection;
import World;
import State;
import Parser;
import Lexer;
import Expr;
import Builtins;
import Buffer;

-- Stack code printer. Takes a list of SM instructions, return its
-- string representation.
public fun showSMInsn (i) {
  -- Shows a location (a reference to function argument, local or global variable)
  fun showLoc (d) {
    fun varity (f) {
      if f then "var" else "val" fi
    }
    
    case d of
      Arg (i) -> sprintf ("arg[%d]", i)
    | Loc (i) -> sprintf ("loc[%d]", i)
    | Glb (x) -> sprintf ("%s", x)
    esac
  }
  
  case i of
    BINOP  (s)       -> sprintf ("BINOP %s", s)
  | LD     (x)       -> sprintf ("LD %s", showLoc (x))
  | LDA    (x)       -> sprintf ("LDA %s", showLoc (x))
  | ST     (x)       -> sprintf ("ST %s", showLoc (x))
  | STI              -> "STI"
  | SEXP   (s, n)    -> sprintf ("SEXP ""%s"", %d", s, n)
  | CONST  (n)       -> sprintf ("CONST %d", n)
  | LABEL  (s, f)    -> sprintf ("LABEL %s, %d", s, f)
  | JMP    (l)       -> sprintf ("JMP %s", l)
  | CJMP   (c, l)    -> sprintf ("CJMP %s, %s", c, l)
  | CALL   (f, n)    -> sprintf ("CALL %s, %d", f, n)
  | BEGIN  (f, a, l) -> sprintf ("BEGIN %s, %d, %d", f, a, l)
  | GLOBAL (x)       -> sprintf ("GLOBAL %s", x)
  | END              -> sprintf ("END")
  | DUP              -> "DUP"
  | DROP             -> "DROP"
  | STRING (s)       -> sprintf ("STRING ""%s""", s)
  | ARRAY  (n)       -> sprintf ("ARRAY %d", n)
  | STA              -> "STA"
  | ELEM             -> "ELEM"
  | BUILTIN (f, n)   -> sprintf ("BUILTIN %s, %d", f, n)
  | META (m)         -> sprintf ("META %s", m.string)
  | PATT (p)         -> sprintf ("PATT %s", p.string)
  esac
}

public fun showSM (prg) {
  map (fun (i) {showSMInsn (i) ++ "\n"}, prg).stringcat
}

-- Evaluation environment: keeps a mapping between labels and (sub)programs
fun initEvalEnv (insns) {
  var map =
    fix (fun (rec) {
          fun ([m, insns]) {
            case insns of
              {}                  -> m
            | LABEL (lab, _) : tl -> rec ([addMap (m, lab, insns), tl])
            | _ : tl              -> rec ([m, tl])
            esac
          }
        }) $ [emptyMap (compare), insns];
  
  [fun (l) {
     case findMap (map, l) of Some (insns) -> insns esac
  }]
}

-- Accessor function
fun fromLabel (env, lab) {
  env [0] (lab)
}

-- Stack machine interpreter. Takes an environment, a world and a program,
-- returns a final output
fun eval (env, w, insns) {
  -- Global state maps names of global variables to values
  var globalState = ref (fun (x) {error (sprintf ("name ""%s"" is undefined", x), getLoc (x))});
  
  -- Make a fresh local state: a pair of arrays for arguments and local variables;
  -- takes the numbers of arguments and local variables respectively
  fun makeState (a, l) {
    [initArray (a, fun (_) {0}), initArray (l, fun (_) {0})]
  }

  fun argsState (args, l) {
    [listArray(args), initArray (l, fun (_) {0})]
  }

  -- Lookups a location in local/global states
  fun lookup ([args, locs], loc) {
    case loc of
      Arg (i) -> args[i]
    | Loc (i) -> locs[i]
    | Loc (i) -> locs[i]
    | Glb (x) -> deref (globalState) (x)
    esac 
  }

  -- Assigns a value to a location
  fun assign ([args, locs], loc, vl) {
    case loc of
      Arg (i) -> args[i] := vl
    | Loc (i) -> locs[i] := vl
    | Glb (x) -> var g = deref (globalState);
                 globalState ::= fun (y) {if compare (x, y) == 0 then vl else g (y) fi}
    esac
  }

  -- Takes n positions from the list, retursn a pair: the remaining list and the taken
  -- sublist
  fun take (list, n) {
    fun inner (n, acc, list) {
      if n == 0
      then [list, acc]
      else inner (n-1, list.hd : acc, list.tl)
      fi
    }

    inner (n, {}, list)
  }

  -- Core interpreter: takes a configuration and a program, returns a configuration
  fun eval (c@[st, cst, s, w], insns) {
    let impl = fix (fun (rec) {
        fun ([c, insns]) {
          case insns of
            {} -> c
          | i : tl ->
            let [c, insnsNext] = evalInsn (c, i, tl) in
            rec ([c, insnsNext])
          esac
        }
    }) in impl ([c, insns])
  }

  fun evalInsn (c@[st, cst, s, world], insn, insns) {
    fun noJmp (c) {
      [c, insns]
    }

    fun jmp (c, label) {
      [c, fromLabel (env, label)]
    }

    fun cont (c, insns) {
      [c, insns]
    }

    fun end (c) {
      [c, {}]
    }

    case insn of
      BINOP(op) -> let r : l : rest = st in
                  let v = evalOp(op, l, r) in
                  [v : rest, cst, s, world].noJmp
    | LD(x)    -> let v = lookup(s, x) in
                  [v : st, cst, s, world].noJmp
    | LDA(x)   -> [Ref (x) : st, cst, s, world].noJmp
    | ST(x)    -> let v : _ = st in
                  assign(s, x, v);
                  [st, cst, s, world].noJmp
    | STA      -> let v : i : a : rest = st in
                  case a of
                    Ref (x) -> assign(s, x, v)
                  | _ -> let arr = getIndexable (a) in
                         arr[i] := v
                  esac;
                  [v : rest, cst, s, world].noJmp  
    | CONST(n) -> [n : st, cst, s, world].noJmp
    | LABEL(l, _) -> c.noJmp
    | JMP(l)   -> c.jmp (l)
    | CJMP(cnd, l) -> 
        let v : rest = st in
        let nc = [rest, cst, s, world] in
        case cnd of
          "z"  -> if v == 0 then nc.jmp (l) else nc.noJmp fi
        | "nz" -> if v != 0 then nc.jmp (l) else nc.noJmp fi
        | _    -> failure ("Unknown condition %s\n", cnd.string)
        esac
    | DROP -> let _ : rest = st in [rest, cst, s, world].noJmp
    | BEGIN (f, a, l) -> 
      let [st, args] = take (st, a) in
      let s = argsState (args, l) in
      [st, cst, s, world].noJmp
    | END -> 
      case cst of
        {} -> c.end
      | [s, insns] : rcst -> [st, rcst, s, world].cont (insns)
      esac
    | GLOBAL (x) -> 
      assign (s, Glb (x), 0);
      c.noJmp
    | CALL (f, nArgs) ->
      [st, [s, insns] : cst, s, world].jmp (f)
    | BUILTIN (f, nArgs) ->
      let [rest, args] = take (st, nArgs) in
      let [v, nw] = evalBuiltin (f, args, world) in
      [v : rest, cst, s, nw].noJmp
    | STRING (v) -> [v : st, cst, s, world].noJmp
    | ARRAY (n) ->
      let [rest, args] = take (st, n) in
      [args.listArray : rest, cst, s, world].noJmp
    | SEXP (t, n) ->
      let [rest, args] = take (st, n) in
      [Sexp (t, args.listArray) : rest, cst, s, world].noJmp
    | ELEM ->
      let i : a : rest = st in
      let arr = getIndexable (a) in
      [arr[i] : rest, cst, s, world].noJmp
    | PATT (p) ->
      let v : rest = st in
      let r = case p of
        Tag (t, n) -> case v of
          Sexp (vt, args) -> compare (t, vt) == 0 && length (args) == n
        | _ -> false
        esac
      | Array (n) -> case v of
          #array -> length (v) == n
        | _ -> false
        esac
      esac in [r : rest, cst, s, world].noJmp
    | DUP -> 
      let v : rest = st in
      [v : v : rest, cst, s, world].noJmp
    | _ -> failure ("Unknown instruction %s\n", insn.string)
    esac
  }
  
  eval ([{}, {}, makeState (0, 0), w], insns) [3].getOutput
}

-- Runs a stack machine for a given input and a given program, returns an output
public fun evalSM (input, insns) {
  eval (initEvalEnv (insns), createWorld (input), insns)
}

-- Compilation environment: generates labels
fun makeCompEnv (nLabels, scopeDepth, state, nLocals, nArgs, functions) {
  -- Generates a new label
  fun genLabel () {
    [sprintf ("L%d", nLabels), makeCompEnv (nLabels+1, scopeDepth, state, nLocals, nArgs, functions)]
  }

  -- Adds a new function 
  fun rememberFun (fLabel, args, body) {
    makeCompEnv (nLabels,
                 scopeDepth,
                 state,
                 nLocals,
                 nArgs,
                 Fun (fLabel, args, body, state) : functions)
  }

  -- Enters a local scope
  fun beginScope () {
    makeCompEnv (nLabels, scopeDepth+1, enterScope (state), nLocals, nArgs, functions)
  }

  -- Leaves a local scope
  fun endScope () {
    makeCompEnv (nLabels, scopeDepth-1, leaveScope (state), nLocals, nArgs, functions)
  }

  -- Adds an argument for the current function
  fun addArg (name) {
    makeCompEnv (nLabels, scopeDepth, addName (state, name, Arg (nArgs)), nLocals, nArgs+1, functions)
  }

  -- Adds a variable in the scope
  fun addVar (name) {
    if isGlobal ()
    then makeCompEnv (nLabels, scopeDepth, addName (state, name, Glb (name, true)), nLocals, nArgs, functions)
    else makeCompEnv (nLabels, scopeDepth, addName (state, name, Loc (nLocals, true)), nLocals+1, nArgs, functions)
    fi
  }

  -- Adds a value in the scope
  fun addVal (name) {
    if isGlobal ()
    then makeCompEnv (nLabels, scopeDepth, addName (state, name, Glb (name, false)), nLocals, nArgs, functions)
    else makeCompEnv (nLabels, scopeDepth, addName (state, name, Loc (nLocals, false)), nLocals+1, nArgs, functions)
    fi
  }

  -- Adds a binding for a function
  fun addFun (name, fLabel, nargs) {
    makeCompEnv (nLabels, scopeDepth, addName (state, name, Fun (fLabel, nargs)), nLocals, nArgs, functions)
  }
  
  -- Enters a function
  fun beginFun (state) {
    makeCompEnv (nLabels, 2, enterFunction (state), 0, 0, functions)
  }

  -- Get functions and empty functions list
  fun getFuns () {
    [functions, makeCompEnv (nLabels, scopeDepth, state, nLocals, nArgs, {})]
  }

  -- Lookups variable
  fun lookupVar (name) {
    case lookup (state, name) of
      Loc (i, true) -> Loc (i)
    | Glb (x, true) -> Glb (x)
    | _             -> error (sprintf ("the name ""%s"" does not designate a variable", name), getLoc (name))
    esac
  }

  -- Lookups value
  fun lookupVal (name) {
    case lookup (state, name) of
      Loc (i, _) -> Loc (i)
    | Glb (x, _) -> Glb (x)
    | Arg (i)    -> Arg (i)
    | _          -> error (sprintf ("the name ""%s"" does not designate a value", name), getLoc (name))
    esac
  }
  
  -- Lookups a name of a function
  fun lookupFun (name) {
    case lookup (state, name) of
      x@Fun (_, _) -> x
    | _            -> error (sprintf ("the name ""%s"" does not designate a function", name), getLoc (name))
    esac
  }

  -- Gets the number of local variables
  fun getLocals () {
    nLocals
  }

  -- Generates an intrinsic function name
  fun genFunLabel (name) {
     if isGlobal ()
     then [sprintf ("L%s", name),             makeCompEnv (nLabels  , scopeDepth, state, nLocals, nArgs, functions)]
     else [sprintf ("L%s_%d", name, nLabels), makeCompEnv (nLabels+1, scopeDepth, state, nLocals, nArgs, functions)]
     fi 
  }

  -- Checks if the current scope is a global
  fun isGlobal () {
    scopeDepth == 2
  }
  
  [genLabel,
   rememberFun,
   beginScope,
   endScope,
   addArg,
   addVar,
   addVal,
   beginFun,
   getFuns,
   lookupVar,
   lookupVal,
   lookupFun,
   getLocals,
   genFunLabel,
   addFun,
   isGlobal
  ]
}

-- Initialize a new compilation environment
fun initCompEnv () {
  makeCompEnv (0, 0, emptyState (), 0, 0, {})
}

-- Accessor functions
fun genLabel (env) {
  env [0] ()
}

fun rememberFun (env, name, args, body) {
  env [1] (name, args, body)
}

fun beginScope (env) {
  env [2] ()
}

fun endScope (env) {
  env [3] ()
}

fun addArg (env, name) {
  env [4] (name)
}

fun addVar (env, name) {
  env [5] (name)
}

fun addVal (env, name) {
  env [6] (name)
}

fun beginFun (env, state) {
  env [7] (state)
}

fun getFuns (env) {
  env [8] ()
}

fun lookupVar (env, name) {
  env [9] (name)
}

fun lookupVal (env, name) {
  env [10] (name)
}

fun lookupFun (env, name) {
  env [11] (name)
}

fun getLocals (env) {
  env [12] ()
}

fun genFunLabel (env, name) {
  env [13] (name)
}

fun addFun (env, name, fLabel, nargs) {
  env [14] (name, fLabel, nargs)
}

fun isGlobal (env) {
  env [15] ()
}

-- Helper function: generates n labels
fun genLabels (env, n) {
  fun inner (env, n) {
    if n == 0
    then {env}
    else case genLabel (env) of
           [lab, env] -> lab : inner (env, n-1)
         esac
    fi
  }

  listArray (inner (env, n))
}

-- Helper function: adds a bunch of arguments
fun addArgs (env, names) {
  foldl (fun (env, name) {addArg (env, name)}, env, names)
}

-- Helper function: adds a bunch of local variables
fun addVars (env, names) {
  foldl (fun (env, name) {addVar (env, name)}, env, names)
}

-- Helper function: adds a bunch of locals values
fun addVals (env, names) {
  foldl (fun (env, name) {addVal (env, name)}, env, names)
}

-- Compiles an expression into a stack machine code.
-- Takes an expression, returns a list of stack machine
-- instructions.

-- Some guidelines for compiling functions and scopes.
--
-- 1. use env.beginScope/env.endScope properly;
-- 2. in each scope traverse the definitions twice:
--    a. first, add all bindings into symbolic state,
--       using end.addVar/env.addFun;
--    b. do not forget to generate GLOBAL instructions for
--       top-level variable declarations;
--    c. on the secord traversal add functions themselves for
--       future code generation (use env.rememberFun).
-- 3. the overall flow for codegeneration:
--    a. generate the code for thetopmost expression (the progrman itself);
--    b. take list of nested functions definitions via env.getFuns and
--       generate the code for each function;
--    c. repeat b. until no function definitions appear.
-- 4. when compiling functions, do not forget to create proper
--    environment (use env.beginFun) and register arguments
--    (use env.addArg).

public fun compileSM (expr) {
  fun label (lab, labUsed) {
    if labUsed
    then singletonBuffer (LABEL (lab, false))
    else emptyBuffer ()
    fi
  }
  
  fun compileMany (lab, env, exprs) {
    case exprs of
      {} -> [false, env, emptyBuffer ()]
    | {e} -> compile (lab, env, e)
    | e : es ->
      let [eLab, env] = env.genLabel in
      let [eUsed, env, eCode] = compile (eLab, env, e) in
      let [labUsed, env, esCode] = compileMany (lab, env, es) in
      [labUsed, env, eCode <+> label (eLab, eUsed) <+> esCode]
    esac
  }

  fun compileMatch (pattern, lab) {
    fun compileMatchArray (patterns) {
      foldl (
        fun ([i, code], p) {
          [i + 1, code <+ DUP <+ CONST (i) <+ ELEM <+> compileMatch (p, lab) <+ DROP]
        },
        [0, emptyBuffer ()],
        patterns
      )[1]
    }

    case pattern of
      Wildcard -> emptyBuffer ()
    | Const (n) -> 
      singletonBuffer (DUP) <+ 
        CONST (n) <+ BINOP ("-") <+ CJMP ("nz", lab)
    | Named (name, p) -> compileMatch (p, lab)
    | Sexp (name, patterns) ->
      let pCode = compileMatchArray (patterns) in 
        singletonBuffer (DUP) <+ 
          PATT (Tag (name, size (patterns))) <+ 
          CJMP ("z", lab) <+> pCode
    | Array (patterns) -> 
      let pCode = compileMatchArray (patterns) in 
      singletonBuffer (DUP) <+ 
          PATT (Array (size (patterns))) <+ 
          CJMP ("z", lab) <+> pCode
    esac
  }

  fun compileBr (env, pattern, expr, lab) {
    let [nLab, env] = env.genLabel in
    let mCode = compileMatch (pattern, nLab) in
    let [_, env, bCode] = compile (lab, env, expr) in
    let code = mCode <+ DROP <+> bCode <+ JMP (lab) <+ 
               LABEL (nLab, false) in
    [code, env]
  }

  fun compile (lab, env, expr) {
    case expr of
      Skip -> [false, env, emptyBuffer ()]
    | Var (x) -> 
      let v = lookupVal (env, x) in
      [false, env, singletonBuffer (LD (v))]
    | Ref (x) -> 
      let v = lookupVar (env, x) in
      [false, env, singletonBuffer (LDA (v)) <+ DUP] -- duplicate to conform to STA
    | Const (n) -> [false, env, singletonBuffer (CONST (n))]
    | Seq (s1, s2) ->
      let [s2Lab, env] = env.genLabel in
      let [s2LabUsed, env, s1Code] = compile (s2Lab, env, s1) in
      let [labUsed, env, s2Code] = compile (lab, env, s2) in
      [labUsed, env, s1Code <+> label (s2Lab, s2LabUsed) <+> s2Code]
    | If (c, t, e)   ->
      let [cLab, env] = env.genLabel in
      let [cLabUsed, env, cCode] = compile (cLab, env, c) in
      let [_, env, tCode] = compile (lab, env, t) in
      let [_, env, eCode] = compile (lab, env, e) in
      let [eLab, env] = env.genLabel in
      let code =  cCode <+> label (cLab, cLabUsed) <+
                  CJMP("z", eLab) <+> tCode <+ JMP (lab) <+
                  LABEL (eLab, false) <+> eCode in
      [true, env, code]
    | While (c, b) ->
      let [cLab, sLab, env] = env.genLabels (2) in
      let [cLabUsed, env, cCode] = compile (cLab, env, c) in
      let [_, env, bCode] = compile (sLab, env, b) in
      let code =  singletonBuffer (LABEL (sLab, true)) <+> cCode <+>
                  label (cLab, cLabUsed) <+ CJMP("z", lab) <+> 
                  bCode <+ JMP (sLab) in
      [true, env, code]
    | DoWhile (b, c) ->
      let [cLab, sLab, eLab, env] = env.genLabels (3) in
      let [eLabUsed, env, cCode] = compile (eLab, env, c) in
      let [cLabUsed, env, bCode ] = compile (cLab, env, b) in
      let code =  singletonBuffer (LABEL (sLab, true)) <+> bCode <+>
                  label (cLab, cLabUsed) <+> cCode <+>
                  label (eLab, eLabUsed) <+ CJMP("nz", sLab) in
      [false, env, code]
    | Ignore (e) ->
      let [eLab, env] = env.genLabel in
      let [eLabUsed, env, eCode] = compile (eLab, env, e) in
      [false, env, eCode <+> label (eLab, eLabUsed) <+ DROP]
    | Set (x, e) ->
      let v = lookupVal (env, x) in
      let [eLab, env] = env.genLabel in
      let [eLabUsed, env, eCode] = compile (eLab, env, e) in
      let code = singletonBuffer (LDA (v)) <+ DUP <+> 
                  eCode <+> label (eLab, eLabUsed) 
                  <+ STA in
      [false, env, code]
    | Assn (l, r) ->
      let [lLab, rLab, env] = env.genLabels (2) in
      let [lLabUsed, env, lCode] = compile (lLab, env, l) in
      let [rLabUsed, env, rCode] = compile (rLab, env, r) in
      let code = lCode <+> label (lLab, lLabUsed) <+>
                 rCode <+> label (rLab, rLabUsed) <+ 
                 STA in -- use STA for all assignments
      [false, env, code]
    | Binop (op, l, r) ->
      let [lLab, rLab, env] = env.genLabels (2) in
      let [rLabUsed, env, rCode] = compile (rLab, env, r) in
      let [lLabUsed, env, lCode] = compile (lLab, env, l) in
      let code = lCode <+> label (lLab, lLabUsed) <+>
                 rCode <+> label (rLab, rLabUsed) <+
                 BINOP (op) in
      [false, env, code]
    | Scope (defs, body) ->
      let scoped = env.beginScope in
      let withDefs = addDefs (scoped, defs) in
      let globals = if isGlobal (withDefs) 
                    then genGlobals (defs) 
                    else emptyBuffer ()
                    fi in
      let env = rememberFuncs (withDefs, defs) in
      let [used, env, code] = compile (lab, env, body) in
      [used, env.endScope, globals <+> code]
    | Call (f, args) ->
        let [argsLab, env] = env.genLabel in
        let [argsLabUsed, env, argsCode] = compileMany (argsLab, env, args) in
        let insn = if isBuiltin(f)
                   then BUILTIN (f, args.size)
                   else let Fun(fLabel, nArgs) = env.lookupFun (f) in CALL (fLabel, nArgs)
                   fi in
        let code = argsCode <+> label (argsLab, argsLabUsed) <+ insn in
        [false, env, code]
    | String (s) -> [false, env, singletonBuffer (STRING (s))]
    | Array (exprs) ->
        let [exprsLab, env] = env.genLabel in
        let [exprsLabUsed, env, exprsCode] = compileMany (exprsLab, env, exprs) in
        let code = exprsCode <+> label (exprsLab, exprsLabUsed) <+ ARRAY (exprs.size) in
        [false, env, code]
    | Sexp (t, exprs) ->
        let [eLab, env] = env.genLabel in
        let [eLabUsed, env, eCode] = compileMany (eLab, env, exprs) in
        let code = eCode <+> label (eLab, eLabUsed) <+ SEXP (t, exprs.size) in
        [false, env, code]
    | Elem (arr, idx) ->
        let [eLab, env] = env.genLabel in
        let [eLabUsed, env, code] = compileMany (eLab, env, {arr, idx}) in
        [false, env, code <+> label (eLab, eLabUsed) <+ ELEM]
    | ElemRef (arr, idx) -> compileMany (lab, env, {arr, idx})
    | Case (name, brs, [line, col]) -> 
        let lCode = singletonBuffer (LD (lookupVal (env, name))) in
        let [code, env] = foldl (
          fun ([code, env], [p, e]) {
            let [bCode, env] = compileBr (env, p, e, lab) in
            [code <+> bCode, env] 
          },
          [lCode, env],
          brs
        ) in
        let mfCode = code <+ CONST (line) <+ CONST (col) <+ BUILTIN ("match_failure", 2) in
        [true, env, mfCode]
    | _ -> failure ("unexpected instruction %s\n", expr.string)
    esac
  }

  fun isBuiltin (name) {
    case name of
      "read" -> true
    | "write" -> true
    | "length" -> true
    | "stringval" -> true
    | _ -> false
    esac
  }

  fun genGlobals (defs) {
    foldl(
      fun (code, def) {
        case def of
          Var (vs) -> foldl (
            fun (code, v) {code <+ GLOBAL (v)}, 
            code, 
            vs
          )
        | _ -> code
        esac
      },
      emptyBuffer(),
      defs
    )
  }

  fun addDefs (env, defs) {
    foldl (
      fun (env, def) {
        case def of
          Var (vs) -> addVars (env, vs)
        | Val (vs) -> addVals (env, vs)
        | Fun (f, args, body) ->
            let [lab, env] = env.genFunLabel (f) in
            env.addFun (f, lab, size(args))
        esac
      },
      env,
      defs
    )
  }

  fun rememberFuncs (env, defs) {
    foldl (
      fun (env, def) {
        case def of
          Fun(f, args, body) ->
            let Fun(lab, _) = env.lookupFun (f) in
            env.rememberFun (lab, args, body)
        | _ -> env
        esac
      },
      env,
      defs
    )
  }

  fun compileFunctions (env, main) {
    fun iterate (env, funList) {
      case funList of
        {} -> case getFuns (env) of
          [{}, env] -> emptyBuffer ()
        | [fs, env] -> iterate (env, fs)
        esac
      | Fun (f, args, body, state) : fs ->
          let [endLab, env] = genLabel (addArgs (beginFun (env, state), args)) in
          let [endUsed, env, code] = compile (endLab, env, body) in
          singletonBuffer (LABEL (f, false)) <+
          BEGIN (f, args.size, getLocals (env)) <+>
          code <+>
          label (endLab, endUsed) <+
          END <+>
          iterate (env, fs)         
      esac
    }
    
    main <+> iterate (env, {})
  }
  
  let env = initCompEnv () in
  let [endLab, env] = env.beginScope.genLabel in
  let [endLabUsed, env, code] = compile (endLab, env, expr) in
  getBuffer $ compileFunctions (env, 
    singletonBuffer (LABEL ("main", false)) <+
    BEGIN ("main", 0, getLocals (env)) <+>
    code <+>
    label (endLab, endLabUsed) <+
    END 
  )
}
