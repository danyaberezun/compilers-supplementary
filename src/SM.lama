-- Stack code printer. Takes a list of SM instructions, return its
-- string representation.
fun myReverse2(code,tw){
	case code of
		[]->tw
		|x:y->myReverse2(y,x:tw)
	esac
}
fun myReverse(code){
	myReverse2(code,[])
}
public fun showSMInsn (i) {
  -- Shows a location (a reference to function argument, local or global variable)
  fun showLoc (d) {
    fun varity (f) {
      if f then "var" else "val" fi
    }
    
    case d of
      Arg (i) -> sprintf ("arg[%d]", i)
    | Loc (i) -> sprintf ("loc[%d]", i)
    | Glb (x) -> sprintf ("%s", x)
    esac
  }
  
  case i of
    BINOP  (s)       -> sprintf ("BINOP %s", s)
  | LD     (x)       -> sprintf ("LD %s", showLoc (x))
  | LDA    (x)       -> sprintf ("LDA %s", showLoc (x))
  | ST     (x)       -> sprintf ("ST %s", showLoc (x))
  | STI              -> "STI"
  | CONST  (n)       -> sprintf ("CONST %d", n)
  | LABEL  (s)       -> sprintf ("LABEL %s", s)
  | JMP    (l)       -> sprintf ("JMP %s", l)
  | CJMP   (c, l)    -> sprintf ("CJMP %s, %s", c, l)
  | CALL   (f, n)    -> sprintf ("CALL %s, %d", f, n)
  | BEGIN  (f, a, l) -> sprintf ("BEGIN %s, %d, %d", f, a, l)
  | GLOBAL (x)       -> sprintf ("GLOBAL %s", x)
  | END              -> sprintf ("END")
  | DUP              -> "DUP"
  | DROP             -> "DROP"
  | STRING (s)       -> sprintf ("STRING ""%s""", s)
  | ARRAY  (n)       -> sprintf ("ARRAY %d", n)
  | SEXP   (s, n)    -> sprintf ("SEXP ""%s"", %d", s, n)
  | STA              -> "STA"
  | ELEM             -> "ELEM"
  | BUILTIN (f, n)   -> sprintf ("BUILTIN %s, %d", f, n)
  esac
}

public fun showSM (prg) {
	--printf(prg.string);
	case prg of
		[]->""
		|x:y->showSM(y)++showSMInsn(x)++"\n"
	esac
}

-- Evaluation environment: keeps a mapping between labels and (sub)programs
fun initEvalEnv (insns) {
  var map =
    fix (fun (rec) {
          fun ([m, insns]) {
            case insns of
              []               -> m
            | LABEL (lab) : tl -> rec ([addMap (m, lab, insns), tl])
            | _ : tl           -> rec ([m, tl])
            esac
          }
        }) $ [emptyMap (compare), insns];
  
  [fun (l) {
     case findMap (map, l) of Some (insns) -> insns esac
  }]
}

-- Accessor function
fun fromLabel (env, lab) {
  env [0] (lab)
}

-- Stack machine interpreter. Takes an environment, a world and a program,
-- returns a final output
fun eval (env, w, insns) {
  -- Global state maps names of global variables to values
  var globalState = ref (fun (x) {error (sprintf ("name ""%s"" is undefined", x), getLoc (x))});
  
  -- Make a fresh local state: a pair of arrays for arguments and local variables;
  -- takes the numbers of arguments and local variables respectively
  fun makeState (a, l) {
    [initArray (a, fun (_) {0}), initArray (l, fun (_) {0})]
  }

  -- Lookups a location in local/global states
  fun lookup ([args, locs], loc) {
    case loc of
      Arg (i) -> args[i]
    | Loc (i) -> locs[i]
    | Glb (x) -> deref (globalState) (x)
    esac 
  }

  -- Assigns a value to a location
  fun assign ([args, locs], loc, vl) {
    case loc of
      Arg (i) -> args[i] := vl
    | Loc (i) -> locs[i] := vl
    | Glb (x) -> var g = deref (globalState);
                 globalState ::= fun (y) {if compare (x, y) == 0 then vl else g (y) fi}
    esac
  }

  -- Takes n positions from the list, retursn a pair: the remaining list and the taken
  -- sublist
  fun take (list, n) {
    fun inner (n, acc, list) {
      if n == 0
      then [list, acc]
      else inner (n-1, list.hd : acc, list.tl)
      fi
    }

    inner (n, {}, list)
  }

  -- Core interpreter: takes a configuration and a program, returns a configuration
fun eval ([stack,state,cur_state,[i,o]], insns) {
	var debug=0;
	var running=1;
	--failure(showSM(insns));
	--var tmr=100;
	--failure(showSM(insns));
	--printf(insns.string);
	--printf("\n");
	--write(state("res"));
	--printf("\n");
	--write(state("n"));
	--printf("\n");
	--write(state("k"));
	--printf("\n");
	while running do
		--tmr:=tmr-1;
		--if tmr==0 then running:=0 fi;
		--printf(cur_state.string);
		case insns of
			[]->(running:=0)
			|x:y->--printf("%s\n%s\n",x.string,stack.string);
				case x of
				LD(v)->
					if debug then printf("LOADING %s\n",v.string) else Nop fi;
					stack:=(lookup(cur_state,v):stack);
					insns:=y
				|LDA(v)->
					if debug then printf("LDA %s\n",v.string) else Nop fi;
					stack:=(v:stack);
					insns:=y
				|ST(v)->
					if debug then printf("STORING %s\n",v.string) else Nop fi;
					case stack of
						f:r->
							stack:=r;
							assign(cur_state,v,f);
							insns:=y
					esac
				|STI->
					if debug then printf("STI\n") else Nop fi;
					case stack of
						f:v:r->
							stack:=f:r;
							--printf(cur_state.string);
							--printf("\n");
							--printf(v.string);
							--printf("\n");
							--printf(f.string);
							--printf("\n");
							assign(cur_state,v,f);
							--printf(cur_state.string);
							--printf("\n");
							--printf(v.string);
							--printf("\n");
							--printf(f.string);
							--printf("\n");
							insns:=y
					esac
				|DUP->
					if debug then printf("DUP\n") else Nop fi;
					case stack of
						f:r->
							stack:=f:f:r;
							insns:=y
					esac
				|DROP->
					if debug then printf("DROP\n") else Nop fi;
					case stack of
						f:r->
							stack:=r;
							insns:=y
					esac
				|CONST(n)->
					if debug then printf("CONSTING %i\n",n) else Nop fi;
					stack:=(n:stack);
					insns:=y
				|BINOP(a)->
					if debug then printf("BINOPING %s\n",a) else Nop fi;
					case stack of
						s:f:r->
							stack:=(evalOp(a,f,s):r);
							insns:=y
					esac
				|JMP(l)->
					if debug then printf("JUMPING %s\n",l) else Nop fi;
					insns:=env.fromLabel(l)
				|CJMP("nz",l)->
					if debug then printf("CHECKING nz\n") else Nop fi;
					case stack of
					f:r->
						if f
						then
							if debug then printf("JUMPING %s\n",l) else Nop fi;
							insns:=env.fromLabel(l)
						else
							if debug then printf("NOTJUMPING %s\n",l) else Nop fi;
							insns:=y
						fi
					esac
				|CJMP("z",l)->
					if debug then printf("CHECKING z\n") else Nop fi;
					case stack of
					f:r->
						stack:=r;
						if f
						then
							if debug then printf("NOTJUMPING %s\n",l) else Nop fi;
							insns:=y
						else
							if debug then printf("JUMPING %s\n",l) else Nop fi;
							insns:=env.fromLabel(l)
						fi
					esac
				|LABEL(l)->
					if debug then printf("MARKING %s\n",l) else Nop fi;
					insns:=y

				|GLOBAL(x)->
					if debug then printf("GLOBALLING %s\n",x) else Nop fi;
					assign(cur_state,Glb(x),0);
					insns:=y
				|CALL(f,n)->
					if debug then printf("CALLING %s %d\n",f,n) else Nop fi;
					state:=[cur_state,y]:state;
					insns:=env.fromLabel(f)
				|END->
					if debug then printf("ENDING\n") else Nop fi;
					case state of
						{}->running:=0
						|[ps,yy]:pstate->
								state:=pstate;
								cur_state:=ps;
								insns:=yy
					esac
				|BEGIN(f,a,l)->
					if debug then printf("BEGINNING %s %d %d\n",f,a,l) else Nop fi;
					case makeState(a, l) of [_, locs]->
						case stack.take(a) of [tstack, args]->
							stack:=tstack;
							cur_state:=[listArray(args),locs];
							insns:=y
						esac
					esac
				|BUILTIN(f,n)->
					if debug then printf("BUILTIN %s %d\n",f,n) else Nop fi;
					case stack.take(n) of [tstack,args]->
						case evalBuiltin(f,args,[i,o]) of [r,[inn,onn]]->
							stack:=r:tstack;
							i:=inn;
							o:=onn;
							insns:=y
						esac
					esac
				|STRING(s)->
					if debug then printf("STRING %s\n",s) else Nop fi;
					stack:=s:stack;
					insns:=y
				|SEXP(s,n)->
					if debug then printf("SEXP %s %d\n",s,n) else Nop fi;
					case stack.take(n) of [tstack,a]->
						stack:=Sexp(s,listArray(a)):tstack;
						insns:=y
					esac
				|ARRAY(n)->
					if debug then printf("ARRAY %d\n",n) else Nop fi;
					case stack.take(n) of [tstack,a]->
						stack:=listArray(a):tstack;
						insns:=y
					esac
				|STA->
					if debug then printf("STA\n") else Nop fi;--TODO
					case stack of v:idx:a:tstack->--printf("%s\n",a.string);
							case a of
							Sexp(_,aa)->aa[idx]:=v
							|Arg(_)->assign(cur_state,a,v)
							|Loc(_)->assign(cur_state,a,v)
							|Glb(_)->assign(cur_state,a,v)
							|_->a[idx]:=v
						esac;
						stack:=v:tstack;
						insns:=y
					esac
				|ELEM->
					if debug then printf("ELEM\n") else Nop fi;
					case stack of idx:a:tstack->
						case a of
							Sexp(_,aa)->stack:=aa[idx]:tstack
							|_->stack:=a[idx]:tstack
						esac;
						insns:=y
					esac
			esac
		esac
	od;
	[stack,state,cur_state,[i,o]]
}
  eval ([{}, {}, makeState (0, 0), w], insns) [3].getOutput
}

-- Runs a stack machine for a given input and a given program, returns an output
public fun evalSM (input, insns) {
	var r=myReverse(insns);
	var env=initEvalEnv (r);
  eval (env, createWorld (input), r)
}

-- Compilation environment: generates labels
fun makeCompEnv (nLabels, scopeDepth, state, nLocals, nArgs, functions) {
  -- Generates a new label
  fun genLabel () {
    [sprintf ("L%d", nLabels), makeCompEnv (nLabels+1, scopeDepth, state, nLocals, nArgs, functions)]
  }

  -- Adds a new function 
  fun rememberFun (fLabel, args, body) {
    makeCompEnv (nLabels,
                 scopeDepth,
                 state,
                 nLocals,
                 nArgs,
                 Fun (fLabel, args, body, state) : functions)
  }

  -- Enters a local scope
  fun beginScope () {
    makeCompEnv (nLabels, scopeDepth+1, enterScope (state), nLocals, nArgs, functions)
  }

  -- Leaves a local scope
  fun endScope () {
    makeCompEnv (nLabels, scopeDepth-1, leaveScope (state), nLocals, nArgs, functions)
  }

  -- Adds an argument for the current function
  fun addArg (name) {
    makeCompEnv (nLabels, scopeDepth, addName (state, name, Arg (nArgs)), nLocals, nArgs+1, functions)
  }

  -- Adds a variable in the scope
  fun addVar (name) {
    if isGlobal ()
    then makeCompEnv (nLabels, scopeDepth, addName (state, name, Glb (name, true)), nLocals, nArgs, functions)
    else makeCompEnv (nLabels, scopeDepth, addName (state, name, Loc (nLocals, true)), nLocals+1, nArgs, functions)
    fi
  }

  -- Adds a value in the scope
  fun addVal (name) {
    if isGlobal ()
    then makeCompEnv (nLabels, scopeDepth, addName (state, name, Glb (name, false)), nLocals, nArgs, functions)
    else makeCompEnv (nLabels, scopeDepth, addName (state, name, Loc (nLocals, false)), nLocals+1, nArgs, functions)
    fi
  }

  -- Adds a binding for a function
  fun addFun (name, fLabel, nargs) {
    makeCompEnv (nLabels, scopeDepth, addName (state, name, Fun (fLabel, nargs)), nLocals, nArgs, functions)
  }
  
  -- Enters a function
  fun beginFun (state) {
    makeCompEnv (nLabels, 2, enterFunction (state), 0, 0, functions)
  }

  -- Get functions and empty functions list
  fun getFuns () {
    [functions, makeCompEnv (nLabels, scopeDepth, state, nLocals, nArgs, {})]
  }

  -- Lookups variable
  fun lookupVar (name) {
    case lookup (state, name) of
      Loc (i, true) -> Loc (i)
    | Glb (x, true) -> Glb (x)
    | Arg (x) -> Arg (x)
    | _             -> error (sprintf ("the name ""%s"" does not designate a variable but %s", name,lookup(state,name).string), getLoc (name))
    esac
  }

  -- Lookups value
  fun lookupVal (name) {
    case lookup (state, name) of
      Loc (i, _) -> Loc (i)
    | Glb (x, _) -> Glb (x)
    | Arg (i)    -> Arg (i)
    | _          -> error (sprintf ("the name ""%s"" does not designate a value but %s", name,lookup(state,name).string), getLoc (name))
    esac
  }
  
  -- Lookups a name of a function
  fun lookupFun (name) {
    case lookup (state, name) of
      x@Fun (_, _) -> x
    | _            -> error (sprintf ("the name ""%s"" does not designate a function", name), getLoc (name))
    esac
  }

  -- Gets the number of local variables
  fun getLocals () {
    nLocals
  }

  -- Generates an intrinsic function name
  fun genFunLabel (name) {
     if isGlobal ()
     then [sprintf ("L%s", name),             makeCompEnv (nLabels  , scopeDepth, state, nLocals, nArgs, functions)]
     else [sprintf ("L%s_%d", name, nLabels), makeCompEnv (nLabels+1, scopeDepth, state, nLocals, nArgs, functions)]
     fi 
  }

  -- Checks if the current scope is a global
  fun isGlobal () {
    scopeDepth == 2
  }
  
  [genLabel,
   rememberFun,
   beginScope,
   endScope,
   addArg,
   addVar,
   addVal,
   beginFun,
   getFuns,
   lookupVar,
   lookupVal,
   lookupFun,
   getLocals,
   genFunLabel,
   addFun,
   isGlobal
  ]
}

-- Initialize a new compilation environment
fun initCompEnv () {
  --makeCompEnv (0, 0, emptyState (), 0, 0, {})
  makeCompEnv(0,1,emptyState().enterScope.addName("read",Fun("Lread",0)).addName("write",Fun("Lwrite",1)).addName("length",Fun("Llength",1)),0,0,{})
}

-- Accessor functions
fun genLabel (env) {
  env [0] ()
}

fun rememberFun (env, name, args, body) {
  env [1] (name, args, body)
}

fun beginScope (env) {
  env [2] ()
}

fun endScope (env) {
  env [3] ()
}

fun addArg (env, name) {
  env [4] (name)
}

fun addVar (env, name) {
  env [5] (name)
}

fun addVal (env, name) {
  env [6] (name)
}

fun beginFun (env, state) {
  env [7] (state)
}

fun getFuns (env) {
  env [8] ()
}

fun lookupVar (env, name) {
  env [9] (name)
}

fun lookupVal (env, name) {
  env [10] (name)
}

fun lookupFun (env, name) {
  env [11] (name)
}

fun getLocals (env) {
  env [12] ()
}

fun genFunLabel (env, name) {
  env [13] (name)
}

fun addFun (env, name, fLabel, nargs) {
  env [14] (name, fLabel, nargs)
}

fun isGlobal (env) {
  env [15] ()
}

-- Helper function: generates n labels
fun genLabels (env, n) {
  fun inner (env, n) {
    if n == 0
    then {env}
    else case genLabel (env) of
           [lab, env] -> lab : inner (env, n-1)
         esac
    fi
  }

  listArray (inner (env, n))
}

-- Helper function: adds a bunch of arguments
fun addArgs (env, names) {
  foldl (fun (env, name) {addArg (env, name)}, env, names)
}

-- Helper function: adds a bunch of local variables
fun addVars (env, names) {
  foldl (fun (env, name) {addVar (env, name)}, env, names)
}

-- Helper function: adds a bunch of locals values
fun addVals (env, names) {
  foldl (fun (env, name) {addVal (env, name)}, env, names)
}

-- Compiles an expression into a stack machine code.
-- Takes an expression, returns a list of stack machine
-- instructions.


-- Some guidelines for compiling functions and scopes.
--
-- 1. use env.beginScope/env.endScope properly;
-- 2. in each scope traverse the definitions twice:
--    a. first, add all bindings into symbolic state,
--       using end.addVar/env.addFun;
--    b. do not forget to generate GLOBAL instructions for
--       top-level variable declarations;
--    c. on the secord traversal add functions themselves for
--       future code generation (use env.rememberFun).
-- 3. the overall flow for codegeneration:
--    a. generate the code for thetopmost expression (the progrman itself);
--    b. take list of nested functions definitions via env.getFuns and
--       generate the code for each function;
--    c. repeat b. until no function definitions appear.
-- 4. when compiling functions, do not forget to create proper
--    environment (use env.beginFun) and register arguments
--    (use env.addArg).

-- Compiles an expression into a stack machine code.
-- Takes an expression, returns a list of stack machine
-- instructions.
-- Compiles an expression into a stack machine code.
-- Takes an expression, returns a list of stack machine
-- instructions.
fun addNames(env,aaa,tw){
	case aaa of
		{}->[env,tw]
		|aa:ar->if isGlobal(env) then
				addNames(addVar(env,aa),ar,GLOBAL(aa):tw)
			else
				addNames(addVar(env,aa),ar,tw)
			fi
	esac
}
fun expandScope(env,a,tw,twf){
	case a of
		{}->[env,tw,twf]
		|aa:ar->case aa of
			Var(aaa)->case addNames(env,aaa,tw) of
				[env,code]->expandScope(env,ar,code,twf)
				esac
			|Fun(aaa,args,b)->case genFunLabel(env,aaa) of
				[lab,env]->expandScope(addFun(env,aaa,lab,args.size),ar,tw,[lab,args,b]:twf)
				esac
		esac
	esac
}
fun rememberMany(env,funs){
	case funs of
		[]->env
		|[lab,args,b]:fr->rememberFun(rememberMany(env,fr),lab,args,b)
	esac
}
public fun compileSM (stmt) {
  fun label (lab, labUsed,tw) {
    if labUsed
    then LABEL(lab):tw
    else tw
    fi
  }
  
  fun compileMany (lab, env, exprs,tw) {
    case exprs of
      {}->[false,env,tw]
      |{e}    -> compile (lab, env, e,tw)
    | e : es ->
        case env.genLabel of
          [eLab, env] ->
            case compile (eLab, env, e,tw) of
              [eUsed, env, eCode] ->
                 compileMany (lab, env, es,label(eLab,eUsed,eCode))
            esac
        esac
    esac
  }

fun isBuiltin(nm){
	case nm of
		"length"->1
		|"read"->1
		|"write"->1
		|_->0
	esac
}
  fun compile (lab, env, stmt,tw) {
    case stmt of
			Skip->[false,env,tw]
			|Var(x)->[false,env,LD(lookupVar(env,x)):tw]
			|Ref(x)->[false,env,DUP:LDA(lookupVar(env,x)):tw]
			|Const(n)->[false,env,CONST(n):tw]
			|Binop(a,b,c)->case compile(lab,env,Seq(Seq(b,c),Skip),tw) of [false,env,code]->
					[false,env,BINOP(a):code]
				esac
			|Ignore(x)->case compile(lab,env,Seq(x,Skip),tw) of [false,env,code]->
					[false,env,DROP:code]
				esac
			|Assn(x,e)->case compile(lab,env,Seq(Seq(x,e),Skip),tw) of [false,env,code]->
					case x of
						ElemRef(_,_)->[false,env,STA:code]
						|_->[false,env,STA:code]
					esac
				esac
			|Seq(s1,s2)->
				case env.genLabel of [s2Lab,env]->
					case compile(s2Lab,env,s1,tw) of [s2LabUsed,env,s1Code]->
						if s2LabUsed then
							compile(lab,env,s2,LABEL(s2Lab):s1Code)
						else
							compile(lab,env,s2,s1Code)
						fi
					esac
				esac
			|While(a,b)->
				case env.genLabel of [start,env] ->
					case compile(lab,env,Seq(a,Skip),LABEL(start):tw) of [false,env,code]->
					case compile(start,env,b,CJMP("z",lab):code) of [_, env, code]->
						[true,env,JMP(start):code]
					esac
					esac
				esac
			|If(a,b,c)->
				case env.genLabel of [ifbad,env]->
					case compile(lab,env,Seq(a,Skip),tw) of [false,env,code]->
					case compile(lab,env,b,CJMP("z",ifbad):code) of [needB,env,codeB]->
					case compile(lab,env,c,LABEL(ifbad):JMP(lab):codeB) of [_,env,codeC]->
						[true,env,codeC]
					esac
					esac
					esac
				esac
			|DoWhile(a,b)->
				case env.genLabel of [start,env]->
				case env.genLabel of [end,env]->
				case compile(end,env,a,LABEL(start):tw) of
					[true,env,code]->
							case compile(lab,env,b,LABEL(end):code) of [false,env,code]->
								[false,env,CJMP("nz",start):code]
							esac
					|[false,env,code]->
							case compile(lab,env,b,code) of [false,env,code]->
								[false,env,CJMP("nz",start):code]
							esac
				esac
				esac
				esac
			|Scope(a,b)->case expandScope(beginScope(env),a,tw,[]) of
				[env,code,funs]->case compile(lab,rememberMany(env,funs),b,code) of
						[used,env,code]->[used,endScope(env),code]
					esac
				esac
			|Call(f,a)->--printf(f);
				case lookupFun(env,f) of
					Fun(flab,cnt)->case env.genLabel of [eLab,env]->case compileMany(eLab,env,a,tw) of
						[used,env,code]->if isBuiltin(f) then
									[false,env,BUILTIN(f,cnt):label(eLab,used,code)]
								else
									[false,env,CALL(flab,cnt):label(eLab,used,code)]
								fi
					esac esac
				esac
			|String(a)->[false,env,STRING(a):tw]
			|Array(a)->case env.genLabel of [eLab,env]->
					case compileMany(eLab,env,a,tw) of [used,env,code]->
						[false,env,ARRAY(a.size):label(eLab,used,code)]
					esac
				esac
			|Sexp(s,a)->case env.genLabel of [eLab,env]->
					case compileMany(eLab,env,a,tw) of [used,env,code]->
						[false,env,SEXP(s,a.size):label(eLab,used,code)]
					esac
				esac
			|Elem(a,idx)->case env.genLabel of [eLab,env]->
					case compileMany(lab,env,{a,idx},tw) of [used,env,code]->
						[false,env,ELEM:label(eLab,used,code)]
					esac
				esac
			|ElemRef(a,idx)->case env.genLabel of [eLab,env]->
					case compileMany(lab,env,{a,idx},tw) of [used,env,code]->
						[false,env,label(eLab,used,code)]
					esac
				esac
    esac
  }

  fun merge(a,b){
	case a of
		[]->b
		|aa:ar->aa:merge(ar,b)
	esac
  }
  fun compileFunctions (env, tw) {
    fun iterate (env, funList,tw) {
      case funList of
        {}     -> case getFuns (env) of
                    [{}, env] -> tw
                  | [fs, env] -> iterate (env, fs,tw)
                  esac
      | Fun (f, args, body, state) : fs ->
          case genLabel (addArgs (beginFun (env, state), args)) of
            [endLab, env] ->
               case compile (endLab, env, body,[]) of
                 [endUsed, env, code] -> 
                    iterate (env, fs,END:label(endLab,endUsed,merge(code,BEGIN(f,args.size,getLocals(env)):LABEL(f):tw)))
               esac
          esac          
      esac
    }
    
    iterate (env, {},tw)
  }
    
	--failure(stmt.string);
  case initCompEnv ().genLabel of
    [endLab, env] ->
       case compile (endLab, env, stmt,[]) of
         [endLabUsed, env, code] ->
            var x=compileFunctions(env,END:label(endLab, endLabUsed,merge(code,BEGIN("main",0,getLocals(env)):LABEL("main"):[])));
					--printf(x.string);
					x
       esac
  esac
}
