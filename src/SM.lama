-- Stack machine.
import Array;
import List;
import Fun;
import Collection;
import World;
import State;
import Expr;
import Buffer;
import Fun;

-- Stack code printer. Takes a list of SM instructions, return its
-- string representation.
public fun showSMInsn (i) {
    case i of
      READ         -> "READ"
    | WRITE        -> "WRITE"
    | BINOP (s)    -> sprintf ("BINOP %s", s)
    | LD    (x)    -> sprintf ("LD %s", x)
    | LDA   (x)    -> sprintf ("LDA %s", x)
    | ST    (x)    -> sprintf ("ST %s", x)
    | STI          -> "STI"
    | CONST (n)    -> sprintf ("CONST %d", n)
    | LABEL (s)    -> sprintf ("LABEL %s", s)
    | JMP   (l)    -> sprintf ("JMP %s", l)
    | CJMP  (c, l) -> sprintf ("CJMP %s, %s", c, l)
    | DUP          -> "DUP"
    | DROP         -> "DROP"
    esac
}

public fun showSM (prg) {
    map (fun (i) {showSMInsn (i) ++ "\n"}, prg).stringcat
}

-- Evaluation environment: keeps a mapping between labels and (sub)programs
fun initEvalEnv (insns) {
    var map = fix (fun (rec) {
                                fun ([m, insns]) {
                                    case insns of
                                      {}               -> m
                                    | LABEL (lab) : tl -> rec ([addMap (m, lab, insns), tl])
                                    | _           : tl -> rec ([m, tl])
                                    esac
                                }
                            }) $ [emptyMap (compare), insns];
    
    [fun (l) {case findMap (map, l) of Some (insns) -> insns esac}]
}

-- Accessor function
fun fromLabel (env, lab) {
    env[0] (lab)
}

fun evalBiop (op, l, r) {
    case op of
      "+"  -> l + r
    | "-"  -> l - r
    | "*"  -> l * r
    | "/"  -> l / r
    | "%"  -> l % r
    | "==" -> l == r
    | "!=" -> l != r
    | "<"  -> l < r
    | "<=" -> l <= r
    | ">"  -> l > r
    | ">=" -> l >= r
    | "&&" -> l && r
    | "!!" -> l !! r
    esac
}

-- Stack machine interpreter. Takes an environment, an SM-configuration and a program,
-- returns a final configuration
fun eval (env, c, is) {
    let [stack, state, world] = c in
    case is of
      LD    (name)      : is -> eval (env, [state (name) : stack, state, world], is)
    | LDA   (name)      : is -> eval (env, [name : stack, state, world], is)
    | ST    (value)     : is -> let s : _ = stack in eval (env, [stack, state <- [value, s], world], is)
    | STI               : is -> let s : ss : sss = stack in eval (env, [s : sss, state <- [ss, s], world], is)
    | READ              : is ->
        let [v, world] = readWorld (world) in eval (env, [v : stack, state, world], is)
    | WRITE             : is -> let s : ss = stack in eval (env, [ss, state, writeWorld (s, world)], is)
    | CONST (value)     : is -> eval (env, [value : stack, state, world], is)
    | BINOP (op)        : is ->
        let r : l : ss = stack in eval (env, [evalBiop (op, l, r) : ss, state, world], is)
    | LABEL (lab)       : is -> eval (env, c, is)
    | JMP   (lab)       : _  -> eval (env, c, env.fromLabel (lab))
    | CJMP  (cond, lab) : is ->
        let s : ss = stack in
        let is =
            case cond of
              "nz" -> if s != 0 then env.fromLabel (lab) else is fi
            | "z"  -> if s == 0 then env.fromLabel (lab) else is fi
            esac
        in
            eval (env, [ss, state, world], is)
    | DROP              : p  -> let s : ss = stack in eval (env, [ss, state, world], p)
    | DUP               : is -> let s : _ = stack in eval (env, [s : stack, state, world], is)
    | _                      -> c
    esac
}

-- Runs a stack machine for a given input and a given program, returns an output
public fun evalSM (input, insns) {
    eval (initEvalEnv (insns), [{}, emptyState, createWorld (input)], insns)[2].getOutput
}

-- Compilation environment: generates labels
fun makeCompEnv (n) {
    [fun () {[sprintf ("L%d", n), makeCompEnv (n + 1)]}]
}

fun initCompEnv () {
    makeCompEnv (0)
}

-- Accessor function: generates one label
fun genLabel (env) {
    env[0] ()
}

-- Utility function: generates n labels
fun genLabels (env, n) {
    fun inner (env, n) {
        if n == 0 then {env} else case env.genLabel of [lab, env] -> lab : inner (env, n - 1) esac fi
    }
    
    listArray (inner (env, n))
}

-- Compiles an expression into a stack machine code.
-- Takes an expression, returns a list of stack machine
-- instructions.
public fun compileSM (stmt) {
    fun label (lab, labUsed) {
        if labUsed then singletonBuffer (LABEL (lab)) else emptyBuffer () fi
    }
    
    fun compile (lab, env, stmt) {
        case stmt of
          Skip                   -> [false, env, emptyBuffer ()]
        | Var     (x)            -> [false, env, singletonBuffer (LD (x))]
        | Ref     (x)            -> [false, env, singletonBuffer (LDA (x))]
        | Const   (n)            -> [false, env, singletonBuffer (CONST (n))]
        | Read    (x)            -> [false, env, singletonBuffer (READ) <+ ST (x)]
        | Write   (e)            ->
            let [writeLab, env] = env.genLabel in
            let [used, env, code] = compile (writeLab, env, e) in
                [false, env, code <+> label (writeLab, used) <+ WRITE]
        | Binop   (op, lhs, rhs) ->
            let [rLab, bLab, env] = env.genLabels (2) in
            let [rLabUsed, env, lCode] = compile (rLab, env, lhs) in
            let [bLabUsed, env, rCode] = compile (bLab, env, rhs) in
                [false, env,
                    lCode <+> label (rLab, rLabUsed) <+> rCode <+> label (bLab, bLabUsed) <+ BINOP (op)
                ]
        | Assn    (x, e)         ->
            let [exprLab, stiLab, env] = env.genLabels (2) in
            let [exprLabUsed, env, code] = compile (exprLab, env, x) in
            let [stiLabUsed, env, expr] = compile (stiLab, env, e) in
                [false, env,
                    code <+> label (exprLab, exprLabUsed) <+> expr <+> label (stiLab, stiLabUsed) <+ STI
                ]
        | Seq     (s1, s2)       ->
            let [s2Lab, env] = env.genLabel in
            let [s2LabUsed, env, s1Code] = compile (s2Lab, env, s1) in
            let [labUsed, env, s2Code] = compile (lab, env, s2) in
                [labUsed, env, s1Code <+> label (s2Lab, s2LabUsed) <+> s2Code]
        | While   (e, s)         ->
            let [condLab, bodyLab, env] = env.genLabels (2) in
            let [_, env, bodyCode] = compile (condLab, env, s) in
            let [testLab, env] = env.genLabel in
            let [testUsed, env, condCode] = compile (testLab, env, e) in
                [false, env,
                    singletonBuffer (JMP (condLab))
                    <+> label (bodyLab, true)
                    <+> bodyCode
                    <+> label (condLab, true)
                    <+> condCode
                    <+> label (testLab, testUsed)
                    <+ CJMP ("nz", bodyLab)
                ]
        | DoWhile (s, e)         ->
            let [condLab, bodyLab, env] = env.genLabels (2) in
            let [_, env, bodyCode] = compile (condLab, env, s) in
            let [testLab, env] = env.genLabel in
            let [testUsed, env, condCode] = compile (testLab, env, e) in
                [false, env,
                    label (bodyLab, true)
                    <+> bodyCode
                    <+> label (condLab, true)
                    <+> condCode
                    <+> label (testLab, testUsed)
                    <+ CJMP ("nz", bodyLab)
                ]
        | If      (e, s1, s2)    ->
            let [elseLab, s2Lab, env] = env.genLabels (2) in
            let [elseLabUsed, env, code] = compile (elseLab, env, e) in
            let [_, env, s2Code] = compile (lab, env, s2) in
            let [_, env, s1Code] = compile (lab, env, s1) in
                [true, env,
                    code
                    <+> label (elseLab, elseLabUsed)
                    <+ CJMP ("z", s2Lab)
                    <+> s1Code
                    <+ JMP (lab)
                    <+> label (s2Lab, true)
                    <+> s2Code
                ]
        | Ignore  (e)            ->
            let [dropLab, env] = env.genLabel in
            let [dropLabUsed, env, eCode] = compile (dropLab, env, e) in
                [false, env, eCode <+> label (dropLab, dropLabUsed) <+ DROP]
        | _                      -> failure ("compileSM not implemented\n")
        esac
    }
    
    case initCompEnv ().genLabel of
      [endLab, env] ->
        case compile (endLab, env, stmt) of
          [endLabUsed, _, code] -> getBuffer $ code <+> label (endLab, endLabUsed)
        esac
    esac
}
