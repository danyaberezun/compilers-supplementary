-- Stack machine.

import Array;
import List;
import Fun;
import Collection;
import World;
import State;
import Expr;
import Buffer;
import Fun;

-- Stack code printer. Takes a list of SM instructions, return its
-- string representation.
public fun showSMInsn (i) {
  case i of
    READ         -> "READ"
  | WRITE        -> "WRITE"
  | BINOP (s)    -> sprintf ("BINOP %s", s)
  | LD    (x)    -> sprintf ("LD %s", x)
  | LDA   (x)    -> sprintf ("LDA %s", x)
  | ST    (x)    -> sprintf ("ST %s", x)
  | STI          -> "STI"
  | CONST (n)    -> sprintf ("CONST %d", n)
  | LABEL (s)    -> sprintf ("LABEL %s", s)
  | JMP   (l)    -> sprintf ("JMP %s", l)
  | CJMP  (c, l) -> sprintf ("CJMP %s, %s", c, l)
  | DUP          -> "DUP"
  | DROP         -> "DROP"  
  esac
}

public fun showSM (prg) {
  map (fun (i) {showSMInsn (i) ++ "\n"}, prg).stringcat
}

-- Evaluation environment: keeps a mapping between labels and (sub)programs
fun initEvalEnv (insns) {
  var map =
    fix (fun (rec) {
          fun ([m, insns]) {
            case insns of
              {}               -> m
            | LABEL (lab) : tl -> rec ([addMap (m, lab, insns), tl])
            | _ : tl           -> rec ([m, tl])
            esac
          }
        }) $ [emptyMap (compare), insns];
  
  [fun (l) {
     case findMap (map, l) of Some (insns) -> insns esac
  }]
}

-- Accessor function
fun fromLabel (env, lab) {
  env [0] (lab)
}

-- Stack machine interpreter. Takes an environment, an SM-configuration and a program,
-- returns a final configuration
fun eval (env, c, insns) {
   let [stack, st, w] = c in
      case insns of
        {}                 -> c
      | LABEL (_): rest    -> eval(env, c, rest)
      | JMP (lab): _       -> eval(env, c, fromLabel (env, lab))
      | CJMP (cond, lab): rest ->
          let v: stack1 = stack in
             if case cond of
                  "z"  -> v == 0
                | "nz" -> v != 0
                esac
             then eval(env, [stack1, st, w], fromLabel (env, lab))
             else eval(env, [stack1, st, w], rest)
             fi
      | READ: rest         -> let [n, w1] = readWorld (w) in eval(env, [n : stack, st, w1], rest)
      | WRITE: rest        -> let n: stack1 = stack in eval(env, [stack1, st, writeWorld (n, w)], rest)
      | BINOP(op): rest    -> let r: l: stack1 = stack in eval(env, [evalOp (op, l, r) : stack1, st, w], rest)
      | LD(x): rest        -> eval(env, [st(x) : stack, st, w], rest)
      | LDA(x): rest       -> eval(env, [Addr (x) : stack, st, w], rest)
      | ST(x): rest        -> let n: stack1 = stack in eval(env, [n : stack1, st <- [x, n], w], rest)
      | STI: rest          -> let n: Addr (x): stack1 = stack in eval(env, [n : stack1, st <- [x, n], w], rest)
      | CONST(n): rest     -> eval(env, [n : stack, st, w], rest)
      | DUP: rest          -> let n: stack1 = stack in eval(env, [n : n : stack1, st, w], rest)
      | DROP: rest         -> let _: stack1 = stack in eval(env, [stack1, st, w], rest)
      esac
}

-- Runs a stack machine for a given input and a given program, returns an output
public fun evalSM (input, insns) {
  eval (initEvalEnv (insns), [{}, emptyState, createWorld (input)], insns)[2].getOutput
}

-- Compilation environment: generates labels
fun makeCompEnv (n) {
  [fun () {
     [sprintf ("L%d", n), makeCompEnv (n+1)]
  }]
}

fun initCompEnv () {
  makeCompEnv (0)
}

-- Accessor function: generates one label
fun genLabel (env) {
  env [0] ()
}

-- Utility function: generates n labels
fun genLabels (env, n) {
  fun inner (env, n) {
    if n == 0
    then {env}
    else case env.genLabel of
           [lab, env] -> lab : inner (env, n-1)
         esac
    fi
  }

  listArray (inner (env, n))
}

-- Compiles an expression into a stack machine code.
-- Takes an expression, returns a list of stack machine
-- instructions.
public fun compileSM (expr) {
  fun compileRef (env, expr) {
    case expr of
      Ref(x) -> [env, {LDA(x)}]
    | Seq(e1, e2) ->
        case compileVoid (env, e1) of
          [env1, code1] ->
            case compileRef (env1, e2) of
              [env2, code2] -> [env2, code1 +++ code2]
            esac
        esac
    | If(e, yes, no) ->
        case genLabel (env) of
          [elseLab, env1] ->
            case genLabel (env1) of
              [exitLab, env2] ->
                case compileExpr (env2, e) of
                  [env3, condCode] ->
                    case compileRef (env3, yes) of
                      [env4, thenCode] ->
                        case compileRef (env4, no) of
                          [env5, elseCode] -> [env5, condCode +++ {CJMP ("z", elseLab)} +++ thenCode +++ {JMP (exitLab), LABEL (elseLab)} +++ elseCode +++ {LABEL (exitLab)}]
                        esac
                    esac
                esac
            esac
        esac
    esac
  }

  fun compileExpr (env, expr) {
    case expr of
      Var(x) ->
        [env, {LD(x)}]
    | Const(n) ->
        [env, {CONST(n)}]
    | Binop(op, l, r) ->
        case compileExpr (env, l) of
          [env1, code1] ->
            case compileExpr (env1, r) of
              [env2, code2] -> [env2, code1 +++ code2 +++ {BINOP(op)}]
            esac
        esac
    | Assn(l, e) ->
        case compileRef (env, l) of
          [env1, lhsCode] ->
            case compileExpr (env1, e) of
              [env2, rhsCode] -> [env2, lhsCode +++ rhsCode +++ {STI}]
            esac
        esac
    | Read(x) ->
        [env, {READ, ST(x)}]
    | Write(e) ->
        case compileExpr (env, e) of
          [env1, code] -> [env1, code +++ {DUP, WRITE}]
        esac
    | Seq(e1, e2) ->
        case compileVoid (env, e1) of
          [env1, code1] ->
            case compileExpr (env1, e2) of
              [env2, code2] -> [env2, code1 +++ code2]
            esac
        esac
    | Skip ->
        [env, {CONST(0)}]
    | If(e, yes, no) ->
        case genLabel (env) of
          [elseLab, env1] ->
            case genLabel (env1) of
              [exitLab, env2] ->
                case compileExpr (env2, e) of
                  [env3, condCode] ->
                    case compileExpr (env3, yes) of
                      [env4, thenCode] ->
                        case compileExpr (env4, no) of
                          [env5, elseCode] ->
                            [env5, condCode +++ {CJMP ("z", elseLab)} +++ thenCode +++ {JMP (exitLab), LABEL (elseLab)} +++ elseCode +++ {LABEL (exitLab)}]
                        esac
                    esac
                esac
            esac
        esac
    | While(e, body) ->
        case genLabel (env) of
          [loopLab, env1] ->
            case genLabel (env1) of
              [exitLab, env2] ->
                case compileExpr (env2, e) of
                  [env3, condCode] ->
                    case compileVoid (env3, body) of
                      [env4, bodyCode] ->
                        [env4, {LABEL (loopLab)} +++ condCode +++ {CJMP ("z", exitLab)} +++ bodyCode +++ {JMP (loopLab), LABEL (exitLab), CONST(0)}]
                    esac
                esac
            esac
        esac
    | DoWhile(body, e) ->
        case genLabel (env) of
          [loopLab, env1] ->
            case compileVoid (env1, body) of
              [env2, bodyCode] ->
                case compileExpr (env2, e) of
                  [env3, condCode] ->
                    [env3, {LABEL (loopLab)} +++ bodyCode +++ condCode +++ {CJMP ("nz", loopLab), CONST(0)}]
                esac
            esac
        esac
    | Ignore(e) ->
        case compileExpr (env, e) of
          [env1, code] -> [env1, code +++ {DROP, CONST(0)}]
        esac
    esac
  }

  fun compileVoid (env, expr) {
    case compileExpr (env, expr) of
      [env1, code] -> [env1, code +++ {DROP}]
    esac
  }

  case compileVoid (initCompEnv (), expr) of
    [_, code] -> code
  esac
}
