-- Statement evaluator.
import State;
import Expr;
import World;

-- Evaluates a statement "stmt" in a configuration "c".
-- A configuration is a pair of a state "s" and a world "w".
-- Returns a final configuration (if any)
--
-- A statement is represented by a data structure of the following shape:
--
-- stmt = Assn    (string, expr)     |
--        Seq     (stmt, stmt)       |
--        Skip                       |
--        Read    (string)           |
--        Write   (expr)             |
--        If      (expr, stmt, stmt) |
--        While   (expr, stmt)       |
--        DoWhile (stmt, expr)

fun eval(c, stmt) {
  case c of
    [s, w] ->
      case stmt of
          Assn (name, expr) -> [s <- [name, evalExpr(s, expr)], w]
        | Seq (a, b)        -> eval(eval(c, a), b)
        | Skip              -> c
        | Read (name)       ->
          case readWorld(w) of [v, nw] ->
            [s <- [name, v], nw]
          esac
        | Write (expr)      -> [s, writeWorld(evalExpr(s, expr), w)]
        | If (e, t, f)   -> if evalExpr(s, e) then eval(c, t) else eval(c, f) fi
        | While (e, b)   -> if evalExpr(s, e) then eval(c, DoWhile (b, e)) else c fi
        | DoWhile (b, e) -> eval(eval(c, b), While(e, b))
        | _ -> failure("Stmt eval not implemented\n")
      esac
  esac
}

-- Evaluates a program with a given input and returns an output
public fun evalStmt(input, stmt) {
  eval([emptyState, createWorld(input)], stmt).snd.getOutput
}