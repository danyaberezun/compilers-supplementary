-- Statement evaluator.

import State;
import Expr;
import World;

-- Evaluates a statement "stmt" in a configuration "c".
-- A configuration is a pair of a state "s" and a world "w".
-- Returns a final configuration (if any)
--
-- A statement is represented by a data structure of the following shape:
--
-- stmt = Assn    (string, expr)     |
--        Seq     (stmt, stmt)       |
--        Skip                       |
--        Read    (string)           |
--        Write   (expr)             |
--        If      (expr, stmt, stmt) |
--        While   (expr, stmt)       |
--        DoWhile (stmt, expr)

fun eval ([s, w], stmt) {
   case stmt of
   Assn (name, expr)       -> let [s, expr] = s.evalExpr (expr) in [s <- [name, expr], w]
   | Seq  (head, tail)     -> eval (eval ([s, w], head), tail)
   | Skip                  -> [s, w]
   | Read (buffer)         -> let [next, w] = w.readWorld in [s <- [buffer, next], w]
   | Write (expr)          -> let [s, expr] = s.evalExpr (expr) in [s, expr.writeWorld (w)]
   | If (cond, thn, els)   -> let [s, res] = s.evalExpr (cond) in
                                 if res then eval ([s, w], thn) else eval ([s, w], els) fi
   | While (cond, body)    -> let [s, res] = s.evalExpr (cond) in
                                 if res then eval ([s, w], Seq (body, While (cond, body))) else [s, w] fi
   | DoWhile (body, cond)  -> let [s, w] = eval ([s, w], body) in
                                 let [s, res] = s.evalExpr (cond) in
                                    if res then eval ([s, w], stmt) else [s, w] fi
   esac
}

-- Evaluates a program with a given input and returns an output
public fun evalStmt (input, stmt) {
   eval([emptyState, createWorld(input)], stmt).snd.getOutput
}
