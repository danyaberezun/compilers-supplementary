-- Statement evaluator.
import State;
import Expr;
import World;

-- Evaluates a statement "stmt" in a configuration "c".
-- A configuration is a pair of a state "s" and a world "w".
-- Returns a final configuration (if any)
--
-- A statement is represented by a data structure of the following shape:
--
-- stmt = Assn   (string, expr)     |
--        Seq    (stmt, stmt)       |
--        Skip                      |
--        Read   (string)           |
--        Write  (expr)             |
fun eval (configuration, stmt) {
   case [configuration, stmt] of
     [[state, world], Assn(name, expr)] -> [state <- [name, evalExpr(state, expr)], world]
   | [_, Seq(first, second)] -> eval(eval(configuration, first), second)
   | [_, Skip] -> configuration
   | [[state, world], Read(name)] -> let [value, world] = readWorld(world) in [state <- [name, value], world]
   | [[state, world], Write(expr)] -> let world = writeWorld(evalExpr(state, expr), world) in [state, world]
   esac
}
-- Evaluates a program with a given input and returns an output
public fun evalStmt (input, stmt) {
   eval([emptyState, createWorld(input)], stmt).snd.getOutput
}