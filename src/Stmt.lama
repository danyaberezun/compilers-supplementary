-- Statement evaluator.

import State;
import Expr;
import World;

-- Evaluates a statement "stmt" in a configuration "c".
-- A configuration is a pair of a state "s" and a world "w".
-- Returns a final configuration (if any)
--
-- A statement is represented by a data structure of the following shape:
--
-- stmt = Assn    (string, expr)     |
--        Seq     (stmt, stmt)       |
--        Skip                       |
--        Read    (string)           |
--        Write   (expr)             |
--        If      (expr, stmt, stmt) |
--        While   (expr, stmt)       |
--        DoWhile (stmt, expr)

fun eval (c, stmt) {
   let [s, w] = c in 
      case stmt of
         Assn (x, e) -> [s <- [x, evalExpr(s, e)], w]
         | Seq (s1, s2) -> let c1 = eval(c, s1) in eval(c1, s2)
         | Skip -> c
         | Read (x) -> let [z, w1] = readWorld(w) in [s <- [x, z], w1]
         | Write (e) -> [s, writeWorld(evalExpr(s, e), w)]
         | If (e, s1, s2) -> if evalExpr(s, e) then eval(c, s1) else eval(c, s2) fi
         | While (e, body) -> while let [s,w] = c in evalExpr(s, e) do c := eval(c, body) od; c
         | DoWhile (body, e) -> do c := eval(c, body) while let [s,w] = c in evalExpr(s, e) od; c
      esac
}

-- Evaluates a program with a given input and returns an output
public fun evalStmt (input, stmt) {
  eval ([emptyState, createWorld (input)], stmt).snd.getOutput
}
