-- Statement evaluator.

import State;
import Expr;
import World;

-- Evaluates a statement "stmt" in a configuration "c".
-- A configuration is a pair of a state "s" and a world "w".
-- Returns a final configuration (if any)
--
-- A statement is represented by a data structure of the following shape:
--
-- stmt = Assn   (string, expr)     |
--        Seq    (stmt, stmt)       |
--        Skip                      |
--        Read   (string)           |
--        Write  (expr)             |
--        if     (expr, stmt, stmt) |
--        While  (expr, stmt)       |
--        Repeat (stmt, expr)

fun eval (c, stmt) {
  case stmt of
     Assn (x, e)              -> let [s, w] = c in [s <- [x, evalExpr(s, e)], w]
   | Seq (s1, s2)             -> eval(eval(c, s1), s2)
   | Skip                     -> c
   | Read (x)                 -> let [s, w] = c in let [n, new_w] = readWorld(w) in [s <- [x, n], new_w]
   | Write (e)                -> let [s, w] = c in [s, writeWorld(evalExpr(s, e), w)]
   | If (e, s_true, s_false)  -> let [s, w] = c in if evalExpr(s, e) != 0 then eval(c, s_true) else eval(c, s_false) fi
   | While (e, st)            -> let [s, w] = c in if evalExpr(s, e) != 0 then eval(eval(c, st), While(e, st)) else c fi
   | DoWhile (st, e)          -> let [new_s, new_w] = eval(c, st) in if evalExpr(new_s, e) != 0 then eval([new_s, new_w], While(e, st)) else [new_s, new_w] fi
   esac
}

-- Evaluates a program with a given input and returns an output
public fun evalStmt (input, stmt) {
  eval ([emptyState, createWorld (input)], stmt).snd.getOutput
}
