-- Statement evaluator.

import State;
import Expr;
import World;

-- Evaluates a statement "stmt" in a configuration "c".
-- A configuration is a pair of a state "s" and a world "w".
-- Returns a final configuration (if any)
--
-- A statement is represented by a data structure of the following shape:
--
-- stmt = Assn    (string, expr)     |
--        Seq     (stmt, stmt)       |
--        Skip                       |
--        Read    (string)           |
--        Write   (expr)             |
--        If      (expr, stmt, stmt) |
--        While   (expr, stmt)       |
--        DoWhile (stmt, expr)
fun eval ([state, world], stmt) {
   case stmt of
      Assn(x, e)  -> let v = evalExpr(state, e) in
                     [state <- [x, v], world]
   |  Seq(s1, s2) -> let c1 = eval([state, world], s1) in
                     eval(c1, s2)
   |  Skip        -> [state, world]
   |  Read(x)     -> let [v, w] = world.readWorld in
                     [state <- [x, v], w]
   |  Write(e)    -> let v = evalExpr(state, e) in
                     [state, v.writeWorld(world)] -- lol
   |  If(c, t, e) -> 
      if evalExpr(state, c) != 0 
      then eval([state, world], t)
      else eval([state, world], e)
      fi
   |  While(c, b) ->
      while evalExpr(state, c) != 0 do
         let [s, w] = eval([state, world], b) in
         state := s;
         world := w
      od;
      [state, world]
   |  DoWhile(b, c) ->
      var st = state;
      var wrld = world;
      do
         let [s, w] = eval([st, wrld], b) in
         st := s;
         wrld := w
      while evalExpr(st, c) != 0 od;
      [st, wrld]
   |  _           -> failure ("Unknown statement %s\n", stmt.string)
   esac
}

-- Evaluates a program with a given input and returns an output
public fun evalStmt (input, stmt) {
  eval ([emptyState, createWorld (input)], stmt).snd.getOutput
}
