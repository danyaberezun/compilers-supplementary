-- Statement evaluator.
import State;
import Expr;
import World;

-- Evaluates a statement "stmt" in a configuration "c".
-- A configuration is a pair of a state "s" and a world "w".
-- Returns a final configuration (if any)
--
-- A statement is represented by a data structure of the following shape:
--
-- stmt = Assn   (string, expr)     |
--        Seq    (stmt, stmt)       |
--        Skip                      |
--        Read   (string)           |
--        Write  (expr)             |
fun eval (c@[state, world], stmt) {
   case stmt of
     Assn(stri, expr)  -> state := state <- [stri, evalExpr(state, expr)];
                          c := [state, world]
   | Seq(stmt1, stmt2) -> c := eval(c, stmt1);
                          c := eval(c, stmt2)
   | Skip              -> skip
   | Read(stri)        -> var inputWorld;
                          
                          inputWorld := readWorld(world);
                          world := snd(inputWorld);
                          state := state <- [stri, fst(inputWorld)];
                          c := [state, world]
   | Write(expr)       -> world := writeWorld(evalExpr(state, expr), world);
                          c := [state, world]
   esac;
   c
}
-- Evaluates a program with a given input and returns an output
public fun evalStmt (input, stmt) {
   eval([emptyState, createWorld(input)], stmt).snd.getOutput
}