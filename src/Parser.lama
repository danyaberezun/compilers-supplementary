-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

fun binops (ops) {
  map(fun (op) {
    [s(op), fun (l, op, r) {Binop (op, l, r)}]
  }, ops)
}

-- Primary expression
var primary = memo $ eta syntax (x=decimal {Const (stringInt (x))} |
                                 x=lident  {Var (x)}               |
                                 inbr[s("("), exp, s(")")]),
        exp = memo $ eta (
          expr({
            [Left, binops ({"!!", "&&"})],
            [Nona, binops ({"==", "!=", "<", ">", "<=", ">="})],
            [Left, binops ({"+", "-"})],
            [Left, binops ({"*", "/", "%"})]
          }, primary)
        );

var stmt = syntax(
    -kRead  x=inbr[s("("), lident, s(")")]  {Read (x)}      |
    -kWrite e=inbr[s("("), exp, s(")")]     {Write (e)}     |
    -kSkip                                  {Skip}          |
    x=lident s[":="] e=exp                  {Assn (x, e)}
);

var stmts = syntax (
  stmt | s1=stmt s[";"] s2=stmts {Seq (s1, s2)}
); 

-- Public top-level parser
public parse = stmts;
