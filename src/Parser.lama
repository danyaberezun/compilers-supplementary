-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

fun makeBinop (l, op, r) {
  Binop (op, l, r)
}

fun makeSeq (l, _, r) {
  Seq (l, r)
}

fun makeIf (e, s1, s2) {
  If (e, s1, s2)
}

fun makeWhile (e, s) {
  While (e, s)
}

fun makeDoWhile (s, e) {
  Seq (s, While (e, s))
}

fun makeFor (init, e, step, body) {
  Seq (init, While (e, Seq (body, step)))
}

var kAssn  = s (":="),
    kComma = s (",");

-- Primary expression
var primary = memo $ eta syntax (x=decimal {Const (stringInt (x))} |
                                 x=lident  {Var (x)}               |
                                 inbr[s("("), exp, s(")")]),
      exp = memo $ eta (expr (
        {
          [Left, {[s ("!!"), makeBinop]}],
          [Left, {[s ("&&"), makeBinop]}],
          [Left, {[s ("=="), makeBinop], [s ("!="), makeBinop]}],
          [Left, {[s ("<"), makeBinop], [s ("<="), makeBinop], [s (">"), makeBinop], [s (">="), makeBinop]}],
          [Left, {[s ("+"), makeBinop], [s ("-"), makeBinop]}],
          [Left, {[s ("*"), makeBinop], [s ("/"), makeBinop], [s ("%"), makeBinop]}]
        }, primary));

var simpleStmt = memo $ eta syntax (x=lident -kAssn e=exp {Assn (x, e)} |
                                      -kRead x=inbr[s ("("), lident, s (")")] {Read (x)} |
                                      -kWrite e=inbr[s ("("), exp, s (")")] {Write (e)} |
                                      -kSkip {Skip}),
    ifTail = memo $ eta syntax (-kElif e=exp -kThen s1=stmt t=ifTail {makeIf (e, s1, t)} |
                                  -kElse s=stmt -kFi {s} |
                                  -kFi {Skip}),
    ifStmt = memo $ eta syntax (-kIf e=exp -kThen s1=stmt t=ifTail {makeIf (e, s1, t)}),
    whileStmt = memo $ eta syntax (-kWhile e=exp -kDo s=stmt -kOd {makeWhile (e, s)}),
    doWhileStmt = memo $ eta syntax (-kDo s=stmt -kWhile e=exp -kOd {makeDoWhile (s, e)}),
    forStmt = memo $ eta syntax (-kFor init=simpleStmt -kComma e=exp -kComma step=simpleStmt -kDo body=stmt -kOd {makeFor (init, e, step, body)}),
    atomStmt = memo $ eta syntax (s=simpleStmt {s} | s=ifStmt {s} | s=whileStmt {s} | s=doWhileStmt {s} | s=forStmt {s}),
    stmt = memo $ eta (expr ({[Left, {[s (";"), makeSeq]}]}, atomStmt));
   

-- Public top-level parser
public parse = stmt;
