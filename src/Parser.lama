-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;
import Matcher;

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

fun op (x) {
  [ s(x), fun (l, op, r) { Binop (op, l, r) } ]
}

-- Primary expression
var primary = memo $ eta syntax (x=decimal {Const (stringInt (x))} |
                                 x=lident  {Var (x)}               |
                                 inbr[s("("), exp, s(")")]),
    foo = fun (l, op, r) { Binop (op, l, r) },
    exp = memo $ expr ({
        [ Left, { [s("!!"), foo] } ],
        [ Left, { [s("&&"), foo] } ],
        [ Nona, { [s("=="), foo], [s("!="), foo], [s("<"), foo], [s("<="), foo], [s(">"), foo], [s(">="), foo] } ],
        [ Left, { [s("+"), foo], [s("-"), foo] } ],
        [ Left, { [s("*"), foo], [s("/"), foo], [s("%"), foo] } ]
    }, primary);

var if_tail = memo $ eta syntax (
    kElif e=exp kThen s1=stmt s2=if_tail {If(e, s1, s2)} |
    kElse s=stmt kFi {s} |
    kFi {Skip}
);

var one_statement = memo $ eta syntax (
    kSkip { Skip } |
    x=lident s[":="] e=exp { Assn (x, e) } |
    kRead x=inbr[s("("), lident, s(")")] { Read (x) } |
    kWrite x=inbr[s("("), exp, s(")")] { Write (x) } |
    kIf e=exp kThen s1=stmt s2=if_tail {If(e, s1, s2)} |
    kWhile e=exp kDo s1=stmt kOd {While(e, s1)} |
    kDo s1=stmt kWhile e=exp kOd {DoWhile(s1, e)} |
    kFor s1=stmt s[","] e=exp s[","] s2=stmt kDo s3=stmt kOd {
        Seq(s1, While(e, Seq(s3, s2)))
    }
);

var stmt = memo $ eta syntax (
    one_statement |
    s1=one_statement s[";"] s2=stmt { Seq(s1, s2) }
);

-- Public top-level parser
public parse = stmt;
