-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

-- Primary expression
var primary = memo $ eta syntax (x=decimal {Const (stringInt (x))}             |
                                 x=lident  {Var (x)}                           |
                                 inbr[s("("), exp, s(")")]),
       exp4 = memo $ eta syntax (x=exp4 s["*"] y=primary { Binop ("*", x, y) } |
                                 x=exp4 s["/"] y=primary { Binop ("/", x, y) } |
                                 x=exp4 s["%"] y=primary { Binop ("%", x, y) } |
                                 x=primary { x }),
       exp3 = memo $ eta syntax (x=exp3 s["+"] y=exp4 {Binop ( "+", x, y) }    |
                                 x=exp3 s["-"] y=exp4 {Binop ( "-", x, y) }    |
                                 x=exp4 { x }),
       exp2 = memo $ eta syntax (x=exp3 s["=="] y=exp3 { Binop ("==", x, y) }  |
                                 x=exp3 s["!="] y=exp3 { Binop ("!=", x, y) }  |
                                 x=exp3 s["<="] y=exp3 { Binop ("<=", x, y) }  |
                                 x=exp3 s["<"] y=exp3 { Binop ("<",  x, y) }   |
                                 x=exp3 s[">="] y=exp3 { Binop (">=", x, y) }  |
                                 x=exp3 s[">"] y=exp3 { Binop (">",  x, y) }   |
                                 x=exp3 { x }),
       exp1 = memo $ eta syntax (x=exp1 s["&&"] y=exp2 { Binop ("&&", x, y) }  |
                                 x=exp2 { x }),
       exp  = memo $ eta syntax (x=exp s["!!"] y=exp1 { Binop ("!!", x, y) }   |
                                 x=exp1 { x });

var first_stmt = memo $ eta syntax (-kSkip {Skip}                                        |
                                    -kRead  x=inbr[s("("), lident, s(")")] { Read (x) }  |
                                    -kWrite x=inbr[s("("), exp, s(")")] { Write (x) }    |
                                    x=lident s[":="] e=exp { Assn (x, e)} );

var stmt = memo $ eta syntax (x=stmt s[";"] y=first_stmt { Seq (x, y) } |
                              x=first_stmt { x });

-- Public top-level parser
public parse = stmt;
             
