-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;
import Matcher;

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

fun binop_node(l, op, r) { Binop(op, l, r) }
fun binop_pair(op) { [s(op), binop_node] }
fun seq_node(l, _, r) { Seq(l, r) }
fun makeIf (branches, elseBranch) {
  foldr (fun ([cond, body], alt) {If (cond, body, alt)}, elseBranch, branches)
}

fun makeFor (init, cond, step, body) {
  Seq (init, While (cond, Seq (body, step)))
}

-- Primary expression
var primary = memo $ eta syntax (x=decimal {Const (stringInt (x))} |
                                 x=lident  {Var (x)}               |
                                 inbr[s("("), exp, s(")")]),
    exp = memo $ eta(
        expr({
            [Left, {binop_pair("!!"), binop_pair("&&")}],
            [Left, {binop_pair("=="), binop_pair("!="), binop_pair("<"), 
                    binop_pair(">"), binop_pair("<="), binop_pair(">=")}],
            [Left, {binop_pair("+"), binop_pair("-")}],
            [Left, {binop_pair("*"), binop_pair("/"), binop_pair("%")}]
        }, primary)
    );

var simple_stmt = memo $ eta syntax (
    x=lident s[":="] e=exp                  {Assn (x, e)}      |
    kRead x = inbr[s("("), lident, s(")")]  {Read (x)}         |
    kWrite e = inbr[s("("), exp, s(")")]    {Write (e)}        |
    kSkip                                   {Skip}
);

var stmt = memo $ eta(
        expr(
          { [Left, {[s(";"), seq_node]}] },
          atom_stmt
        )
    ),
    for_head = memo $ eta syntax (
        init=simple_stmt -s[","] c=exp -s[","] step=simple_stmt {[init, c, step]}
    ),
    if_tail = memo $ eta syntax (
        kElif c=exp kThen t=stmt tail=if_tail {If (c, t, tail)}
      | kElse s=stmt kFi {s}
      | kFi {Skip}
    ),
    if_stmt = memo $ eta syntax (
        kIf c=exp kThen t=stmt tail=if_tail {If (c, t, tail)}
    ),
    while_stmt = memo $ eta syntax (
        kWhile c=exp kDo body=stmt kOd {While (c, body)}
    ),
    do_while_stmt = memo $ eta syntax (
        kDo body=stmt kWhile c=exp kOd {DoWhile (body, c)}
    ),
    for_stmt = memo $ eta syntax (
        kFor h=for_head kDo body=stmt kOd {
          let [init, c, step] = h in
          makeFor (init, c, step, body)
        }
    ),
    atom_stmt = memo $ eta (
        if_stmt       |
        while_stmt    |
        do_while_stmt |
        for_stmt      |
        simple_stmt
    );

-- Public top-level parser
public parse = stmt;
             
