-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;
import Matcher;

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

-- Primary expression
var primary=memo $ eta syntax (x=decimal {Const (stringInt (x))} |
                               x=lident  {Var (x)}               |
                               inbr[s("("), exp, s(")")]         ),

    exp_mul=memo $ eta syntax(primary                                          |
                              l=exp_mul s["*"]  r=primary {Binop ("*", l, r) } |
                              l=exp_mul s["/"]  r=primary {Binop ("/", l, r) } |
                              l=exp_mul s["%"]  r=primary {Binop ("%", l, r) } ),

    exp_add=memo $ eta syntax(exp_mul                                          |
                              l=exp_add s["+"]  r=exp_mul {Binop ("+", l, r) } |
                              l=exp_add s["-"]  r=exp_mul {Binop ("-", l, r) } ),

    exp_cmp=memo $ eta syntax(exp_add                                          |
                              l=exp_add s["<"]  r=exp_add {Binop ("<", l, r) } |
                              l=exp_add s[">"]  r=exp_add {Binop (">", l, r) } |
                              l=exp_add s["!="] r=exp_add {Binop ("!=", l, r)} |
                              l=exp_add s["=="] r=exp_add {Binop ("==", l, r)} |
                              l=exp_add s[">="] r=exp_add {Binop (">=", l, r)} |
                              l=exp_add s["<="] r=exp_add {Binop ("<=", l, r)} ),

    exp_cnj=memo $ eta syntax(exp_cmp                                          |
                              l=exp_cnj s["&&"] r=exp_cmp {Binop ("&&", l, r)} ),

        exp=memo $ eta syntax(exp_cnj                                      |
                              l=exp s["!!"] r=exp_cnj {Binop ("!!", l, r)} );

var stmt=memo $ eta syntax (prim_stmt                              |
                            l=prim_stmt s[";"] r=stmt {Seq (l, r)} ),

    elif_tail=memo $ eta syntax (kFi                                              {Skip} |
                                 kElse s=stmt kFi                                    {s} |
                                 kElif e=exp kThen s1=stmt s2=elif_tail {If (e, s1, s2)} ),

    prim_stmt=memo $ eta syntax (kRead l=inbr[s("("), lident, s(")")]          {Read (l)} |
                                 kWrite e=inbr[s("("), exp, s(")")]           {Write (e)} |
                                 kSkip                                             {Skip} |
                                 kWhile c=exp kDo b=stmt kOd               {While (c, b)} |
                                 kDo b=stmt kWhile c=exp kOd             {DoWhile (c, b)} |
                                 kFor s1=stmt s[","] e=exp s[","] s2=stmt kDo s3=stmt kOd
                                                      {Seq (s1, While (e, Seq (s3, s2)))} |
                                 kIf e=exp kThen s1=stmt s2=elif_tail    {If (e, s1, s2)} | 
                                 lid=lident s[":="] e=exp                 {Assn (lid, e)} );

-- Public top-level parser
public parse = stmt;
