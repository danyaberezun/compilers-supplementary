-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

-- fun inbr_exact(exp) {
--   inbr[s("("), exp, s(")")]
-- }

-- Primary expression
var primary = memo $ eta syntax (x=decimal {Const (stringInt (x))} |
                                 x=lident  {Var (x)}               |
                                 inbr[s("("), exp, s(")")]),

      mul_exp = memo $ eta syntax (l=mul_exp s["*"] r=primary {Binop ("*", l , r)} |
                                   l=mul_exp s["/"] r=primary {Binop ("/", l , r)} |
                                   l=mul_exp s["%"] r=primary {Binop ("%", l , r)} |
                                   primary),

      add_exp = memo $ eta syntax (l=add_exp s["+"] r=mul_exp {Binop ("+", l , r)} |
                                   l=add_exp s["-"] r=mul_exp {Binop ("-", l , r)} |
                                   mul_exp),

      comp_exp = memo $ eta syntax (l=add_exp s["<"] r=add_exp {Binop ("<", l , r)}   |
                                    l=add_exp s["<="] r=add_exp {Binop ("<=", l , r)} |
                                    l=add_exp s[">"] r=add_exp {Binop (">", l , r)}   |
                                    l=add_exp s[">="] r=add_exp {Binop (">=", l , r)} |
                                    l=add_exp s["!="] r=add_exp {Binop ("!=", l , r)} |
                                    l=add_exp s["=="] r=add_exp {Binop ("==", l , r)} |
                                    add_exp),

      and_exp = memo $ eta syntax (l=and_exp s["&&"] r=comp_exp {Binop ("&&", l , r)} |
                                   comp_exp),    

      or_exp = memo $ eta syntax (l=or_exp s["!!"] r=and_exp {Binop ("!!", l , r)} |
                                    and_exp),                                                            

      exp = or_exp;

var stmt = memo $ eta syntax (head=stmt_base s[";"] tail=stmt {Seq (head , tail)} |
                              stmt_base),

      stmt_base = memo $ eta syntax (kSkip {Skip}                                         |
                                     kRead id=inbr[s("("), lident, s(")")] {Read (id)}    |
                                     kWrite v=inbr[s("("), exp, s(")")] {Write (v)}       |
                                     id=lident s[":="] v=exp {Assn (id , v)});


-- Public top-level parser
public parse = stmt;
             
