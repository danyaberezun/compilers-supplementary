-- Parser 
import Ostap;
import Lexer;
import List;
import Fun;

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

-- Primary expression
var primary = memo $ eta syntax (
                       x=decimal {Const(stringInt(x))} |
                       x=lident {Var(x)}               |
                       inbr[s("("), exp, s(")")]
                     );

-- var exp = memo $ eta (failure ("expression parsing not implemented\n"));
var exp = memo $ expr({[Left, {[s("&&"), fun (l, op, r) {Binop(op, l, r)}],
                               [s("!!"), fun (l, op, r) {Binop(op, l, r)}]}],
                       [Left, {[s("=="), fun (l, op, r) {Binop(op, l, r)}],
                               [s("!="), fun (l, op, r) {Binop(op, l, r)}],
                               [s(">"), fun (l, op, r) {Binop(op, l, r)}],
                               [s("<"), fun (l, op, r) {Binop(op, l, r)}],
                               [s(">="), fun (l, op, r) {Binop(op, l, r)}],
                               [s("<="), fun (l, op, r) {Binop(op, l, r)}]}],
                       [Left, {[s("+"), fun (l, op, r) {Binop(op, l, r)}],
                               [s("-"), fun (l, op, r) {Binop(op, l, r)}]}],
                       [Left, {[s("*"), fun (l, op, r) {Binop(op, l, r)}],
                               [s("/"), fun (l, op, r) {Binop(op, l, r)}],
                               [s("%"), fun (l, op, r) {Binop(op, l, r)}]}]}, primary) | primary;

var stmt = memo $ eta syntax (
      x=lident s[":="] e=exp {Assn(x, e)}      |
      kSkip {Skip}                             |
      kRead s["("] x=lident s[")"] {Read(x)}   |
      kWrite s["("] e=exp s[")"] {Write(e)}
    );

var stmts = memo $ expr({[Left, {[token(";"), fun (l, op, r) {Seq(l, r)}]}]}, stmt);

-- Public top-level parser
public parse = stmts ;-- @ fun (e) {failure("%s\n", string(e)); e};
