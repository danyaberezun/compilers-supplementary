-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

fun binop_node(l, op, r) { Binop(op, l, r) }
fun binop_pair(op) { [s(op), binop_node] }
-- Primary expression
var primary = memo $ eta syntax (x=decimal {Const (stringInt (x))} |
                                 x=lident  {Var (x)}               |
                                 inbr[s("("), exp, s(")")]),
    exp = memo $ eta(
        expr({
            [Left, {binop_pair("!!"), binop_pair("&&")}],
            [Left, {binop_pair("=="), binop_pair("!="), binop_pair("<"), 
                    binop_pair(">"), binop_pair("<="), binop_pair(">=")}],
            [Left, {binop_pair("+"), binop_pair("-")}],
            [Left, {binop_pair("*"), binop_pair("/"), binop_pair("%")}]
        }, primary)
    );

var single_stmt = memo $ eta syntax (
    x=lident s[":="] e=exp                  {Assn (x, e)}      |
    kRead x = inbr[s("("), lident, s(")")]  {Read (x)}         |
    kWrite e = inbr[s("("), exp, s(")")]    {Write (e)}        |
    kSkip                                   {Skip}
);
-- Public top-level parser
public parse = memo $ eta(
    expr(
      { [Left, {[s(";"), fun (l, _, r) {Seq(l, r)}]}] },
      single_stmt
    )
);
             
