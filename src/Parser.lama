-- Parser

import Ostap;
import Lexer;
import List;
import Fun;
import Matcher;
import Ref;
import Collection;

-- Signals an error; takes an error message and location info
fun error (msg, loc) {
  failure ("%s at %d:%d\n", msg, loc.fst, loc.snd)
}

-- An attribute-processing functions
-- Attributes are:
--   Val  --- a plain value (aka "rvalue")
--   Ref  --- a reference to a mutable cell (aka "lvalue")
--   Void --- no value (aka "void"/"unit")

-- Checks if a plain value "val" can be used in the context described by
-- the attribute "atr".
fun assertValue (atr, v, loc) {
  case atr of
    Ref  -> error ("reference expected", loc)
  | Void -> Ignore (v)
  | _    -> v
  esac
}

fun assertVoid (atr, v, loc) {
  case atr of
    Void -> v
  | Val  -> error ("value expected", loc)
  | _    -> error ("reference expected", loc)
  esac
}

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

fun binop (op) {
  [syntax (pos -s[op]), fun (l, loc, r) {
                          fun (a) {
                            assertValue (a, Binop (op, l (Val), r (Val)), loc)
                          }
                        }
  ]
}

var primary  = memo $ eta syntax (
                                  -- decimal constant
                                  loc=pos x=decimal                                 {fun (a) {assertValue (a, Const (stringInt (x)), loc)}}     |

                                  -- identifier
                                  x=lident                                          {fun (a) {
                                                                                       case a of
                                                                                         Ref  -> Ref (x)
                                                                                       | Void -> Ignore (Var (x))
                                                                                       | _    -> Var (x)
                                                                                       esac
                                                                                    }} |
                                  $(failure ("the rest of primary parsing in not implemented\n"))),
    basic    = memo $ eta (expr ({[Right, {[s (":="),
                                            fun (l, loc, r) {
                                              fun (a) {assertValue (a, Assn (l (Ref), r (Val)), loc)}
                                            }]}],
                                  [Left , map (binop, {"!!"})],
                                  [Left , map (binop, {"&&"})],
                                  [Nona , map (binop, {"==", "!=", "<", ">", "<=", ">="})],
                                  [Left , map (binop, {"+", "-"})],
                                  [Left , map (binop, {"*", "/", "%"})]
                                 },
                                 primary)),
    exp      = memo $ eta syntax (basic | s1=basic s[";"] s2=exp {fun (a) {Seq (s1 (Void), s2 (a))}}),
   ifExp = memo $ eta syntax (kIf cond=exp kThen thn=stmtBlock kFi {If (cond, thn, Skip)} |
                              kIf cond=exp kThen thn=stmtBlock els=elseExp kFi {If (cond, thn, els)}),
   elseExp = memo $ eta syntax (kElif cond=exp kThen thn=stmtBlock {If (cond, thn, Skip)}             |
                                kElif cond=exp kThen thn=stmtBlock els=elseExp {If (cond, thn, els)} |
                                kElse thn=stmtBlock {thn}),
   whileExp = memo $ eta syntax (kWhile cond=exp kDo body=stmtBlock kOd {While (cond, body)} |
                                 kFor decl=stmtBlock s[","] cond=exp s[","] step=stmtBlock kDo body=stmtBlock kOd
                                    {Seq (decl, While (cond, Seq (body, step)))}),
   doWhileExp = memo $ eta syntax (kDo body=stmtBlock kWhile cond=exp kOd {DoWhile (body, cond)}),
   stmtBlock = memo $ eta syntax (head=stmt s[";"] tail=stmtBlock {Seq (head, tail)} | stmt),
   stmt = memo $ eta syntax (kSkip {Skip}                                       |
                             kRead s["("] buffer=lident s[")"] {Read (buffer)}  |
                             kWrite s["("] value=exp s[")"] {Write (value)}     |
                             name=lident s[":="] value=exp {Assn (name, value)} |
                             cond=ifExp {cond}                                  |
                             loop=whileExp {loop}                               |
                             loop=doWhileExp {loop});

-- Public top-level parser
public parse = syntax (s=exp {s (Void)});
