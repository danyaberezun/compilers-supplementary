-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;
import Matcher;

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

-- Primary expression
var primary = memo $ eta (decimal @ fun (x) {Const (stringInt (x))} |
                          lident  @ fun (x) {Var (x)}               |
                          inbr (s("("), exp1, s(")"))),
    exp6 = memo $ eta syntax(-whiteSpace primary -whiteSpace),
    exp5 = memo $ eta syntax(exp6 | x=exp5 op=binop5 y=exp6 {Binop(op, x, y)}),
    exp4 = memo $ eta syntax(exp5 | x=exp4 op=binop4 y=exp5 {Binop(op, x, y)}),
    exp3 = memo $ eta syntax(exp4 | x=exp3 op=binop3 y=exp4 {Binop(op, x, y)}),
    exp2 = memo $ eta syntax(exp3 | x=exp2 op=binop2 y=exp3 {Binop(op, x, y)}),
    exp1 = memo $ eta syntax(exp2 | x=exp1 op=binop1 y=exp2 {Binop(op, x, y)});

var whiteSpace = token(rWhiteSpace);

var line = syntax (x=lident whiteSpace token[":="] y=exp1 {Assn(x, y)}                |
                   -kRead inbr[s("("), syntax (x=lident {Read(x)}), s(")")]           |
                   -kWrite inbr[s("("), syntax (x=exp1 {Write(x)}), s(")")]           |
                   kWhile whiteSpace c=exp1 whiteSpace kDo e=whileBody {While(c, e)}  |
                   kDo e=doWhileBody whiteSpace c=exp1 kOd {DoWhile(e, c)}            |
                   kFor s1=forExpr1 whiteSpace c=exp1 whiteSpace token[","] s3=forExpr3 s=whileBody {Seq(s1, While(c, Seq(s, s3)))} |
                   -kIf ifElse                                                        |
                   kSkip {Skip});

var ifElse = memo $ eta syntax(whiteSpace c=exp1 whiteSpace kThen e1=ifElseBody e2=elseBody {If(c, e1, e2)} |
                               whiteSpace c=exp1 whiteSpace kThen e1=ifBody {If(c, e1, Skip)} |
                               whiteSpace c=exp1 whiteSpace kThen e1=elifBody e2=ifElse {If(c, e1, e2)});

var ifBody = memo $ eta syntax(-whiteSpace line -whiteSpace -kFi                         |
                               -whiteSpace line -whiteSpace -token[";"] -whiteSpace -kFi |
                               whiteSpace x=line whiteSpace token[";"] y=ifBody {Seq(x, y)});

var ifElseBody = memo $ eta syntax(-whiteSpace line -whiteSpace -kElse                         |
                                   -whiteSpace line -whiteSpace -token[";"] -whiteSpace -kElse |
                                    whiteSpace x=line whiteSpace token[";"] y=ifElseBody {Seq(x, y)});

var elifBody = memo $ eta syntax(-whiteSpace line -whiteSpace -kElif                         |
                                 -whiteSpace line -whiteSpace -token[";"] -whiteSpace -kElif |
                                 whiteSpace x=line whiteSpace token[";"] y=ifElseBody {Seq(x, y)});

var elseBody = memo $ eta syntax(-whiteSpace line -whiteSpace -kFi             |
                                 -whiteSpace line -whiteSpace -token[";"] -kFi |
                                 whiteSpace x=line whiteSpace token[";"] y=elseBody {Seq(x, y)});

var whileBody = memo $ eta syntax(-whiteSpace line -whiteSpace -kOd                        |
                                 -whiteSpace line -whiteSpace -token[";"] -whiteSpace -kOd |
                                 whiteSpace x=line whiteSpace token[";"] y=whileBody {Seq(x, y)});

var doWhileBody = memo $ eta syntax(-whiteSpace line -whiteSpace -kWhile                         |
                                    -whiteSpace line -whiteSpace -token[";"] -whiteSpace -kWhile |
                                    whiteSpace x=line whiteSpace token[";"] y=doWhileBody {Seq(x, y)});

var forExpr1 = memo $ eta syntax(-whiteSpace line -whiteSpace -token[","]                         |
                                 -whiteSpace line -whiteSpace -token[";"] -whiteSpace -token[","] |
                                 whiteSpace x=line whiteSpace token[";"] y=forExpr1 {Seq(x, y)});

var forExpr3 = memo $ eta syntax(-whiteSpace line -whiteSpace -kDo                         |
                                 -whiteSpace line -whiteSpace -token[";"] -whiteSpace -kDo |
                                 whiteSpace x=line whiteSpace token[";"] y=forExpr3 {Seq(x, y)});

var stmt = memo $ eta syntax (-whiteSpace line -whiteSpace -eof                         |
                              -whiteSpace line -whiteSpace -token[";"] -whiteSpace -eof |
                              whiteSpace x=line whiteSpace token[";"] y=stmt {Seq(x, y)});

-- Public top-level parser
public parse = stmt;
