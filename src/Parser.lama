-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

fun pbinop(op) {
  [s(op), fun (l, _, r) {Binop (op, l, r)}]
}

var primary = memo $ eta syntax (
  x=decimal {Const (stringInt (x))}              |
  x=lident  {Var (x)}                            |
  inbr[s("("), exp, s(")")]
),
exp = memo $ eta (expr ({
  [Left, {pbinop("!!")}],
  [Left, {pbinop("&&")}],
  [Nona, {pbinop("=="), pbinop("!="), pbinop("<="), pbinop("<"), pbinop(">="), pbinop(">")}],
  [Left, {pbinop("+"), pbinop("-")}],
  [Left, {pbinop("*"), pbinop("/"), pbinop("%")}]
}, primary));

var stmt = memo $ eta syntax (
  kSkip {Skip}                                   |
  v=lident s[":="] e=exp {Assn(v, e)}                |
  kRead s["("] v=lident s[")"] {Read(v)}         |
  kWrite s["("] e=exp s[")"] {Write(e)}
),
stmts = memo $ eta syntax (
  stmt |
  l=stmt s[";"] r=stmts {Seq(l, r)}             
);

-- Public top-level parser
public parse = stmts;
