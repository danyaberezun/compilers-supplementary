-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;
import Matcher;

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

-- Primary expression
var primary = memo $ eta syntax (x=decimal {Const (stringInt (x))}             |
                                 x=lident  {Var (x)}                           |
                                 inbr[s("("), exp, s(")")]),
       exp4 = memo $ eta syntax (x=exp4 s["*"] y=primary { Binop ("*", x, y) } |
                                 x=exp4 s["/"] y=primary { Binop ("/", x, y) } |
                                 x=exp4 s["%"] y=primary { Binop ("%", x, y) } |
                                 x=primary { x }),
       exp3 = memo $ eta syntax (x=exp3 s["+"] y=exp4 {Binop ( "+", x, y) }    |
                                 x=exp3 s["-"] y=exp4 {Binop ( "-", x, y) }    |
                                 x=exp4 { x }),
       exp2 = memo $ eta syntax (x=exp3 s["=="] y=exp3 { Binop ("==", x, y) }  |
                                 x=exp3 s["!="] y=exp3 { Binop ("!=", x, y) }  |
                                 x=exp3 s["<="] y=exp3 { Binop ("<=", x, y) }  |
                                 x=exp3 s["<"] y=exp3 { Binop ("<",  x, y) }   |
                                 x=exp3 s[">="] y=exp3 { Binop (">=", x, y) }  |
                                 x=exp3 s[">"] y=exp3 { Binop (">",  x, y) }   |
                                 x=exp3 { x }),
       exp1 = memo $ eta syntax (x=exp1 s["&&"] y=exp2 { Binop ("&&", x, y) }  |
                                 x=exp2 { x }),
       exp  = memo $ eta syntax (x=exp s["!!"] y=exp1 { Binop ("!!", x, y) }   |
                                 x=exp1 { x });

var     if_alt = memo $ eta syntax (-kElif e=exp -kThen s=stmt alt=if_alt { If (e, s, alt) } |
                                    -kElse s=stmt -kFi { s }                                 |
                                    -kFi { Skip }
                                   ),
    first_stmt = memo $ eta syntax (-kSkip {Skip}                                                 |
                                    -kRead  x=inbr[s("("), lident, s(")")] { Read (x) }           |
                                    -kWrite x=inbr[s("("), exp, s(")")] { Write (x) }             |
                                    -kIf e=exp -kThen s1=stmt alt=if_alt { If (e, s1, alt) }      | 
                                    -kWhile e=exp -kDo s1=stmt -kOd { While (e, s1) }             |
                                    -kDo s1=stmt -kWhile e=exp -kOd { DoWhile (s1, e) }           |
                                    -kFor s1=first_stmt -s[","] e=exp -s[","] s2=first_stmt -kDo s3=stmt -kOd
                                      { Seq (s1, While (e, Seq (s3, s2))) }                       |
                                    x=lident s[":="] e=exp { Assn (x, e)}
                                    ),
          stmt = memo $ eta syntax (x=stmt s[";"] y=first_stmt { Seq (x, y) } |
                                    x=first_stmt { x });

-- Public top-level parser
public parse = stmt;
