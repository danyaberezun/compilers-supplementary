-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

-- Primary expression
var primary = memo $ 
        eta syntax (
            x=decimal {Const (stringInt (x))} |
            x=lident  {Var (x)}               |
            inbr[s("("), exp, s(")")]),

    exp = memo $ 
        eta (expr (
            let binop = fun (op) { [s(op), fun (l, _, r) { Binop(op, l , r) }] }  in
            {
                [Left, map(binop, {"!!"})],
                [Left, map(binop, {"&&"})],
                [Nona, map(binop, {">",">=","<","<=","==","!="})],
                [Left, map(binop, {"+", "-"})],
                [Left, map(binop, {"*", "%", "/"})]
            }, primary)),

    stmtExp = memo $
        eta (expr (
                {[Right, {[s(";"), fun (lhs, _, rhs) { Seq(lhs, rhs) }]}]}, stmtPrimary
        ));

var stmtPrimary = memo $ 
        eta syntax (
            x=lident s[":="] v=exp { Assn(x, v) }    |
            kSkip {Skip}                             | 
            kRead s["("] x=lident s[")"] { Read(x) } |
            kWrite s["("] x=exp s[")"] { Write(x) } 
    );

var stmt = memo $ eta syntax ( stmtExp ) ;
   

-- Public top-level parser
public parse = stmt;
             
