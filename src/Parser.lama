-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;
import Matcher;
import Ref;
import Collection;

-- Signals an error; takes an error message and location info
fun error (msg, loc) {
  failure ("%s at %d:%d\n", msg, loc.fst, loc.snd)
}

-- An attribute-processing functions
-- Attributes are:
--   Val  --- a plain value (aka "rvalue")
--   Ref  --- a reference to a mutable cell (aka "lvalue")
--   Void --- no value (aka "void"/"unit")

fun showAttr (atr) {
  case atr of
    Val -> "val"
  | Ref -> "ref"
  | Void -> "void"
  esac
}

-- Checks if a plain value "val" can be used in the context described by
-- the attribute "atr".
fun assertValue (atr, v, loc) {
  case atr of
    Ref  -> error ("reference expected", loc)
  | Void -> Ignore (v)
  | _    -> v
  esac
}

fun assertVoid (atr, v, loc) {
  case atr of
    Void -> v
  | Val  -> error ("value expected", loc)
  | _    -> error ("reference expected", loc)
  esac
}

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

fun binop (op) {
  [syntax (pos -s[op]), fun (l, loc, r) {
                          fun (a) {
                            assertValue (a, Binop (op, l (Val), r (Val)), loc)
                          }
                        }
  ]
}

public primary  = memo $ eta syntax (
                                  -- decimal constant
                                  loc=pos x=decimal                                 {fun (a) {
                                                                                      assertValue (a, Const (stringInt (x)), loc)
                                                                                    }} |

                                  -- identifier
                                  x=lident                                          {fun (a) {
                                                                                       case a of
                                                                                         Ref  -> Ref (x)
                                                                                       | Void -> Ignore (Var (x))
                                                                                       | _    -> Var (x)
                                                                                       esac
                                                                                    }} |
                                  
                                  -- skip
                                  loc=pos kSkip                                     {fun (a) {
                                                                                      assertVoid (a, Skip, loc)
                                                                                    }} |

                                  -- read
                                  loc=pos kRead x=inbr[s("("), exp, s(")")]      {fun (a) {
                                                                                      assertVoid (a, Read (x (Ref)), loc)
                                                                                    }} |
                                  
                                  -- write
                                  loc=pos kWrite e=inbr[s("("), exp, s(")")]        {fun (a) {
                                                                                      assertVoid (a, Write (e (Val)), loc)
                                                                                    }} |
                                  
                                  -- if
                                  kIf cond=exp kThen tb=exp elifs=elifsP eb=maybeElseP kFi
                                                                                    {fun (a) {
                                                                                      foldr (
                                                                                        fun (acc, [cond, bd]) {
                                                                                          If (cond (Val), bd (a), acc)
                                                                                        },
                                                                                        eb (a),
                                                                                        [cond, tb]:elifs
                                                                                      )
                                                                                    }} |
                                  
                                  -- while
                                  loc=pos kWhile cond=exp kDo bd=exp kOd            {fun (a) {
                                                                                      assertVoid (a, While (cond (Val), bd (Void)), loc)
                                                                                    }} |
                                  
                                  -- do while
                                  loc=pos kDo bd=exp kWhile cond=exp kOd            {fun (a) {
                                                                                      assertVoid (a, DoWhile (cond (Val), bd (Void)), loc)
                                                                                    }} |

                                  -- for
                                  loc=pos kFor init=exp token[","] cond=exp token[","] post=exp kDo bd=exp kOd
                                                                                    {fun (a) {
                                                                                      assertVoid (a, Seq (init (Void), While (cond (Val), Seq (bd (Void), post (Void)))), pos)
                                                                                    }} |
                                  
                                  x=inbr[s("("), exp, s(")")] {x}
                                ),
    basic    = memo $ eta (expr ({[Right, {[s (":="),
                                            fun (l, loc, r) {
                                              fun (a) {assertValue (a, Assn (l (Ref), r (Val)), loc)}
                                            }]}],
                                  [Left , map (binop, {"!!"})],
                                  [Left , map (binop, {"&&"})],
                                  [Nona , map (binop, {"==", "!=", "<", ">", "<=", ">="})],
                                  [Left , map (binop, {"+", "-"})],
                                  [Left , map (binop, {"*", "/", "%"})]
                                 },
                                 primary)),
    exp      = memo $ eta syntax (basic | s1=basic s[";"] s2=exp {fun (a) {Seq (s1 (Void), s2 (a))}});

public elifP = memo $ eta syntax (
  kElif cond=exp kThen bd=exp {[cond, bd]}
);

public elifsP = memo $ eta syntax (
  empty {{}} |
  b=elifP bb=elifsP {b:bb}
);

public maybeElseP = memo $ eta syntax (
  loc=pos empty       {fun (a) {
                        assertVoid (a, Skip, pos)
                      }} |
  kElse bd=exp        {bd}
);

-- Public top-level parser
public parse = syntax (s=exp {s (Void)});
