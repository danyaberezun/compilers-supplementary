-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

-- Primary expression
var primary = memo $ eta syntax (
      x=decimal {Const (stringInt (x))} |
      x=lident  {Var (x)}               |
      inbr[s("("), exp, s(")")]),
    exp = memo $ eta (
      expr ({[Left, {[s("!!"), fun (a, op, b) {Binop (op, a, b)}]}],
             [Left, {[s("&&"), fun (a, op, b) {Binop (op, a, b)}]}],
             [Left, {[s("=="), fun (a, op, b) {Binop (op, a, b)}],
                     [s("!="), fun (a, op, b) {Binop (op, a, b)}],
                     [s("<="), fun (a, op, b) {Binop (op, a, b)}],
                     [s(">="), fun (a, op, b) {Binop (op, a, b)}],
                     [s("<"),  fun (a, op, b) {Binop (op, a, b)}],
                     [s(">"),  fun (a, op, b) {Binop (op, a, b)}]}],
             [Left, {[s("+"), fun (a, op, b) {Binop (op, a, b)}],
                     [s("-"), fun (a, op, b) {Binop (op, a, b)}]}],
             [Left, {[s("*"), fun (a, op, b) {Binop (op, a, b)}],
                     [s("/"), fun (a, op, b) {Binop (op, a, b)}],
                     [s("%"), fun (a, op, b) {Binop (op, a, b)}]}]},
            primary));

var kAssign = s (":="),
    kSemi   = s (";");

var simpleStmt = memo $ eta syntax (
      -kRead x=inbr[s("("), lident, s(")")] {Read (x)} |
      -kWrite e=inbr[s("("), exp, s(")")] {Write (e)} |
      x=lident -kAssign e=exp {Assn (x, e)} |
      -kSkip {Skip}),
    stmt = memo $ eta syntax (
      l=simpleStmt t=(-kSemi simpleStmt)*
      {foldl (fun (acc, s) {Seq (acc, s)}, l, t)});

-- Public top-level parser
public parse = stmt;
             
