-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;
import Matcher;
import Ref;
import Collection;

-- Signals an error; takes an error message and location info
fun error (msg, loc) {
  failure ("%s at %d:%d\n", msg, loc.fst, loc.snd)
}

-- An attribute-processing functions
-- Attributes are:
--   Val  --- a plain value (aka "rvalue")
--   Ref  --- a reference to a mutable cell (aka "lvalue")
--   Void --- no value (aka "void"/"unit")

-- Checks if a plain value "val" can be used in the context described by
-- the attribute "atr".
fun assertValue (atr, v, loc) {
  case atr of
    Ref  -> error ("reference expected", loc)
  | Void -> Ignore (v)
  | _    -> v
  esac
}

fun assertVoid (atr, v, loc) {
  case atr of
    Void -> v
  | Val  -> error ("value expected", loc)
  | _    -> error ("reference expected", loc)
  esac
}

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

fun binop (op) {
  [syntax (pos -s[op]), fun (l, loc, r) {
                          fun (a) {
                            assertValue (a, Binop (op, l (Val), r (Val)), loc)
                          }
                        }
  ]
}

var primary  = memo $ eta syntax (
	loc=pos x=decimal{fun(a){assertValue(a,Const(stringInt(x)),loc)}}
	|x=lident{fun(a){case a of
			Ref->Ref(x)
			|Void->Ignore(Var(x))
			|_->Var(x)
		esac}}
	|loc=pos kRead s["("] x=exp s[")"]{fun(a){assertVoid(a,Read(x(Ref)),loc)}}
	|loc=pos kWrite s["("] x=exp s[")"]{fun(a){assertVoid(a,Write(x(Val)),loc)}}
	|loc=pos kSkip{fun(a){assertVoid(a,Skip,loc)}}
	|loc=pos x=inbr[s("("), exp, s(")")]{x}
	|loc=pos kWhile x=exp kDo y=exp kOd{fun(a){assertVoid(a,While(x(Val),y(Void)),loc)}}
	|loc=pos kDo x=exp kWhile y=exp kOd{fun(a){assertVoid(a,DoWhile(x(Void),y(Val)),loc)}}
	|loc=pos kIf x=exp kThen y=exp z=exp_fi{fun(a){If(x(Val),y(a),z(a))}}
	|loc=pos kFor x=exp s[","] y=exp s[","] z=exp kDo t=exp kOd{fun(a){Seq(x(Void),While(y(Val),Seq(t(Void),z(Void))))}}
),
exp_fi=memo $ eta syntax(
  kFi{fun(a){assertVoid(a,Skip,loc)}}
  |kElse x=exp kFi{fun(a){x(a)}}
  |kElif x=exp kThen y=exp z=exp_fi{fun(a){If(x(Val),y(a),z(a))}}
),
    basic    = memo $ eta (expr ({[Right, {[s (":="),
                                            fun (l, loc, r) {
                                              fun (a) {assertValue (a, Assn (l (Ref), r (Val)), loc)}
                                            }]}],
                                  [Left , map (binop, {"!!"})],
                                  [Left , map (binop, {"&&"})],
                                  [Nona , map (binop, {"==", "!=", "<", ">", "<=", ">="})],
                                  [Left , map (binop, {"+", "-"})],
                                  [Left , map (binop, {"*", "/", "%"})]
                                 },
                                 primary)),
    exp      = memo $ eta syntax (basic | s1=basic s[";"] s2=exp {fun (a) {Seq (s1 (Void), s2 (a))}});

-- Public top-level parser
public parse = syntax (s=exp {s (Void)});
