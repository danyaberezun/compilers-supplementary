-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;
import Matcher;

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

-- Primary expression
var primary = memo $ eta (syntax (x=decimal {Const (stringInt (x))} |
                                  x=lident  {Var (x)}               |
                                  inbr[s("("), exp, s(")")])),
      exp = memo $ eta (expr ({[Left, {[s ("!!"), fun (l, sign, r) {Binop ("!!", l, r)}]}],
                               [Left, {[s ("&&"), fun (l, sign, r) {Binop ("&&", l, r)}]}],
                               [Nona, {[s ("=="), fun (l, sign, r) {Binop ("==", l, r)}],
                                        [s ("!="), fun (l, sign, r) {Binop ("!=", l, r)}],
                                        [s ("<"),  fun (l, sign, r) {Binop ("<", l, r)}],
                                        [s ("<="), fun (l, sign, r) {Binop ("<=", l, r)}],
                                        [s (">"),  fun (l, sign, r) {Binop (">", l, r)}],
                                        [s (">="), fun (l, sign, r) {Binop (">=", l, r)}]}],
                               [Left, {[s ("+"), fun (l, sign, r) {Binop ("+", l, r)}],
                                       [s ("-"), fun (l, sign, r) {Binop ("-", l, r)}]}],
                               [Left, {[s ("*"), fun (l, sign, r) {Binop ("*", l, r)}],
                                       [s ("/"), fun (l, sign, r) {Binop ("/", l, r)}],
                                       [s ("%"), fun (l, sign, r) {Binop ("%", l, r)}]}]
                              },
                              primary)),
      ifTail = memo $ eta (syntax (-kElse s=stmt {s} |
                                   -kElif e=exp -kThen s1=stmt s2=ifTail {If (e, s1, s2)} |
                                   -empty {Skip})),
      ifStmt = memo $ eta (syntax (-kIf e=exp -kThen s1=stmt s2=ifTail -kFi {If (e, s1, s2)})),
      whileStmt = memo $ eta (syntax (-kWhile e=exp -kDo s=stmt -kOd {While (e, s)})),
      doWhileStmt = memo $ eta (syntax (-kDo s=stmt -kWhile e=exp -kOd {DoWhile (s, e)})),
      forStmt = memo $ eta (syntax (-kFor s1=stmt -s[","] e=exp -s[","] s2=stmt -kDo s3=stmt -kOd {Seq (s1, While (e, Seq (s3, s2)))})),
      sStmt = memo $ eta (syntax (x=lident -s[":="] e=exp {Assn (x, e)} |
                                  -kRead x=inbr[s("("), lident, s(")")] {Read (x)} |
                                  -kWrite e=inbr[s("("), exp, s(")")] {Write (e)} |
                                  -kSkip {Skip} |
                                  ifStmt |
                                  whileStmt |
                                  doWhileStmt |
                                  forStmt)),
      stmt = memo $ eta (syntax (s1=sStmt -s[";"] s2=stmt {Seq (s1, s2)} |
                                 sStmt));

-- Public top-level parser
public parse = stmt;
