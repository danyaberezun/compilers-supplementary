-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

-- Primary expression
var primary = memo $ eta syntax (x=decimal {Const (stringInt (x))} |
                                 x=lident  {Var (x)}               |
                                 inbr[s("("), exp, s(")")]),
    funBinop = fun (l, op, r) { Binop (op, l, r) },
    exp = memo $ expr ({[Left, {[s ("!!"), funBinop]}],
                        [Left, {[s ("&&"), funBinop]}],
                        [Nona, {[cmp, funBinop]}],
                        [Left, {[arithmLow, funBinop]}],
                        [Left, {[arithmHigh, funBinop]}]}, primary),
    stmtImpl = memo $ eta syntax (kWrite e=inbr[s("("), exp, s(")")] { Write (e) } |
                                  kRead x=inbr[s("("), lident, s(")")] { Read (x) } |
                                  kSkip { Skip } |
                                  x=lident s[":="] e=exp { Assn (x, e) }),
    stmt = memo $ eta syntax (s1=stmtImpl s[";"] s2=stmt { Seq (s1, s2) } |
                              stmtImpl);
   

-- Public top-level parser
public parse = stmt;
             
