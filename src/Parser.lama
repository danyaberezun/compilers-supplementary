-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;
import Matcher;

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

-- Primary expression
var primary = memo $ eta syntax (
            x=decimal {Const (stringInt (x))} |
            x=lident  {Var (x)}               |
            inbr[s("("), exp, s(")")]),

    exp = memo $ eta (expr (
            let binop = fun (op) { [s(op), fun (l, _, r) { Binop(op, l , r) }] }  in
            {
                [Left, map(binop, {"!!"})],
                [Left, map(binop, {"&&"})],
                [Nona, map(binop, {">",">=","<","<=","==","!="})],
                [Left, map(binop, {"+", "-"})],
                [Left, map(binop, {"*", "%", "/"})]
            }, primary)),

    stmtExp = memo $ eta (expr ( {[Right, {[s(";"), fun (lhs, _, rhs) { Seq(lhs, rhs) }]}]}, stmtPrimary ));
        

var ifThen = memo $ eta syntax ( kIf cond=exp kThen tr=stmtPrimary { [cond, tr] } );
var elseDummy = memo $ eta syntax ( kFi { Skip } | kElse fls=stmtPrimary kFi { fls } | kElif cond=exp kThen tr=stmtPrimary fls=elseDummy { If (cond, tr, fls) }  );
var ifImp = memo $ eta syntax ( beg=ifThen fls=elseDummy { let [cond, tr] = beg in If (cond, tr, fls) } );

var stmtPrimary = memo $ eta syntax (
            x=lident s[":="] v=exp { Assn(x, v) }                                                                                                  |
            kSkip { Skip }                                                                                                                         | 
            kRead x=inbr[s("("),lident,s(")")] { Read(x) }                                                                                         |
            kFor init=stmtPrimary s[","] cond=exp s[","] step=stmtPrimary kDo body=stmtPrimary kOd { Seq (init, While (cond, Seq (body, step)) ) } |
            kWhile cond=exp body=stmtPrimary { While (cond, body) }                                                                                |
            kDo body=stmtPrimary kWhile cond=exp kOd { DoWhile (body, cond) }                                                                      |
            ifImp                                                                                                                                  |
            kWrite x=inbr[s("("), exp, s(")")] { Write(x) } 
);


var stmt = memo $ eta syntax ( stmtExp ) ;
   

-- Public top-level parser
public parse = stmt;
