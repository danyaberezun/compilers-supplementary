-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;
import Matcher;
import Ref;
import Collection;

-- Signals an error; takes an error message and location info
fun error (msg, loc) {
  failure ("%s at %d:%d\n", msg, loc.fst, loc.snd)
}

-- An attribute-processing functions
-- Attributes are:
--   Val  --- a plain value (aka "rvalue")
--   Ref  --- a reference to a mutable cell (aka "lvalue")
--   Void --- no value (aka "void"/"unit")

-- Checks if a plain value "val" can be used in the context described by
-- the attribute "atr".
fun assertValue (atr, v, loc) {
  case atr of
    Ref  -> error ("reference expected", loc)
  | Void -> Ignore (v)
  | _    -> v
  esac
}

fun assertVoid (atr, v, loc) {
  case atr of
    Void -> v
  | Val  -> error ("value expected", loc)
  | _    -> error ("reference expected", loc)
  esac
}

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

fun binop (op) {
  [syntax (pos -s[op]), fun (l, loc, r) {
                          fun (a) {
                            assertValue (a, Binop (op, l (Val), r (Val)), loc)
                          }
                        }
  ]
}

fun makeFor (init, cond, step, body) {
  Seq (init, While (cond, Seq (body, step)))
}

var
  exp = memo $ eta syntax (
    basic
  | s1=basic s[";"] s2=exp {fun (a) {Seq (s1 (Void), s2 (a))}}
  ),

  if_tail = memo $ eta syntax (
    kElif c=exp kThen t=exp tail=if_tail {
      fun (a) {If (c (Val), t (a), tail (a))}
    }
  | kElse e=exp kFi {
      fun (a) {e (a)}
    }
  | loc=pos kFi {
      fun (a) {assertVoid (a, Skip, loc)}
    }
  ),

  primary = memo $ eta syntax (
    -- decimal constant
    loc=pos x=decimal {
      fun (a) {assertValue (a, Const (stringInt (x)), loc)}
    } |

    -- identifier
    x=lident {
      fun (a) {
        case a of
          Ref  -> Ref (x)
        | Void -> Ignore (Var (x))
        | _    -> Var (x)
        esac
      }
    } |

    -- read
    loc=pos kRead x=inbr[s("("), lident, s(")")] {
      fun (a) {
        case a of
          Ref -> error ("reference expected", loc)
        | Void -> Read (x)
        | _    -> Seq (Read (x), Var (x))
        esac
      }
    } |

    -- write
    loc=pos kWrite e=inbr[s("("), exp, s(")")] {
      fun (a) {assertValue (a, Write (e (Val)), loc)}
    } |

    -- skip
    loc=pos kSkip {
      fun (a) {assertVoid (a, Skip, loc)}
    } |

    -- if
    loc=pos kIf c=exp kThen t=exp tail=if_tail {
      fun (a) {If (c (Val), t (a), tail (a))}
    } |

    -- while
    loc=pos kWhile c=exp kDo body=exp kOd {
      fun (a) {assertVoid (a, While (c (Val), body (Void)), loc)}
    } |

    -- do ... while
    loc=pos kDo body=exp kWhile c=exp kOd {
      fun (a) {assertVoid (a, DoWhile (body (Void), c (Val)), loc)}
    } |

    -- for
    loc=pos kFor init=exp -s[","] c=exp -s[","] step=exp kDo body=exp kOd {
      fun (a) {assertVoid (a, makeFor (init (Void), c (Val), step (Void), body (Void)), loc)}
    } |

    -- parenthesized expression
    x=inbr[s("("), exp, s(")")] {
      x
    }
  ),

  basic = memo $ eta (
    expr ({[Right, {[s (":="),
                     fun (l, loc, r) {
                       fun (a) {assertValue (a, Assn (l (Ref), r (Val)), loc)}
                     }]}],
           [Left , map (binop, {"!!"})],
           [Left , map (binop, {"&&"})],
           [Nona , map (binop, {"==", "!=", "<", ">", "<=", ">="})],
           [Left , map (binop, {"+", "-"})],
           [Left , map (binop, {"*", "/", "%"})]
          },
          primary)
  );

-- Public top-level parser
public parse = syntax (s=exp {s (Void)});
