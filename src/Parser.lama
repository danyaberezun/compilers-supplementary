-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;
import Matcher;

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

fun parse_op(op) {
  [s(op), fun (l, op, r) {Binop(op, l, r)}]
}

fun binops(ops) {
  map(parse_op, ops)
}

-- Primary expression
var primary = memo $ eta syntax (x=decimal {Const (stringInt (x))} |
                                 x=lident  {Var (x)}               |
                                 inbr[s("("), exp, s(")")]),
      exp = memo $ eta (
        expr({[Left, binops({"!!"})],
              [Left, binops({"&&"})],
              [Nona, binops({"==", "!=", ">", "<", ">=", "<="})],
              [Left, binops({"+", "-"})],
              [Left, binops({"*", "/", "%"})]
        }, primary));

var cond_stmt = memo $ eta syntax (
  e=exp kThen tt=stmt kElif tf=cond_stmt {If(e, tt, tf)} |
  e=exp kThen tt=stmt kElse tf=stmt kFi {If(e, tt, tf)}  |
  e=exp kThen tt=stmt kFi {If(e, tt, Skip)}
);

var simpleStmt = memo $ eta syntax (
  kRead  x=inbr[s("("), lident, s(")")] {Read(x)}  |
  kWrite x=inbr[s("("), exp, s(")")]    {Write(x)} |
  kSkip                                 {Skip}     |
  x=lident s[":="] e=exp                {Assn(x, e)} |
  kIf cd=cond_stmt {cd}                  |
  kWhile e=exp kDo t=stmt kOd {While(e, t)} |
  kDo t=stmt kWhile e=exp kOd {DoWhile(t, e)} |
  kFor init_s=stmt s[","] e=exp s[","] rp_s=stmt kDo t=stmt kOd {Seq(init_s, While(e, Seq(t, rp_s)))}
);

var stmt = memo $ eta syntax (
  st=simpleStmt s[";"] t=stmt {Seq(st, t)} |
  st=simpleStmt               {st}
);

-- Public top-level parser
public parse = stmt;
             
