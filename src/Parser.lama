-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

fun binop(l, op, r) { Binop(op, l, r) }

-- Primary expression
var primary = memo $ eta syntax (x=decimal {Const (stringInt (x))} |
                                 x=lident  {Var (x)}               |
                                 inbr[s("("), exp, s(")")]),

    exp = memo $ expr (
        [Left, {[s("!!"), binop],
                [s("&&"),  binop]}],
        [Left, {[s("=="), binop],
                [s("!="), binop],
                [s("<"), binop],
                [s(">"), binop],
                [s("<="), binop],
                [s(">="), binop]}],
        [Left, {[s("+"), binop],
                [s("-"), binop]}],
        [Left, {[s("*"), binop],
                [s("/"), binop],
                [s("%"), binop]}],
        primary)
    | primary;

var simple = memo $ eta syntax (
    x=lident s[":="] e=exp                  {Assn (x, e)}      |
    kRead x = inbr[s("("), lident, s(")")]  {Read (x)}         |
    kWrite e = inbr[s("("), exp, s(")")]    {Write (e)}        |
    kSkip                                   {Skip}
);

var stmt = memo $ eta (
    expr(
      [Left, {[s(";"),  fun (l, op, r) {Seq(l, r)}]}],
      simple
    )
);


public parse = stmt;
