-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

-- Primary expression

fun binop(op) { 
  [s(op), 
    fun(l, _, r) { Binop(op, l, r) }
  ] 
} 

var primary = memo $ eta syntax (x=decimal {Const (stringInt (x))} |
                                 x=lident  {Var (x)}               |
                                 inbr[s("("), exp, s(")")]),
    exp = memo $ eta (expr ({
                          [Right, {binop(":=")}],
                          [Right, {binop(":")}],
                          [Left, {binop("!!")}],
                          [Left, {binop("&&")}],
                          [Nona, map (binop, {"==", "!=", "<=", "<", ">=",">"})],
                          [Left, map (binop, {"+", "-"})],
                          [Left, map (binop, {"*", "/", "%"})]
                        }, primary));

var singleStmt = memo $ eta syntax (
                          x=lident s[":="] e=exp {Assn(x, e)} |
                          kSkip {Skip} |
                          kRead s["("] x=lident s[")"] {Read(x)} |
                          kWrite s["("] x=exp s[")"] {Write(x)} 
                        ),
    stmt = memo $ eta syntax (
                    singleStmt |
                    x=singleStmt s[";"] y=stmt {Seq(x, y)}
                 );
   

-- Public top-level parser
public parse = stmt;
             
