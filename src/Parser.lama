-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;
import Matcher;

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

fun pbinop (op) {
  [s (op), fun (l, _, r) {Binop (op, l, r)}]
}

var primary = memo $ eta syntax (
    x=decimal {Const (stringInt (x))}              
  | x=lident  {Var (x)}                            
  | inbr[s("("), exp, s(")")]
),
exp = memo $ eta (expr ({
  [Left, {pbinop("!!")}],
  [Left, {pbinop("&&")}],
  [Nona, {pbinop("=="), pbinop("!="), pbinop("<="), pbinop("<"), pbinop(">="), pbinop(">")}],
  [Left, {pbinop("+"), pbinop("-")}],
  [Left, {pbinop("*"), pbinop("/"), pbinop("%")}]
}, primary));

var stmt = memo $ eta syntax (
    kSkip {Skip}                                          
  | v=lident s[":="] e=exp {Assn(v, e)}                   
  | kRead s["("] v=lident s[")"] {Read(v)}                
  | kWhile cond=exp kDo body=stmts kOd {While(cond, body)}
  | kWrite s["("] e=exp s[")"] {Write(e)}                 
  | kIf cond=exp kThen body=stmts other=elses {If(cond, body, elses)}
  | kDo body=stmts kWhile cond=exp kOd {DoWhile(body, cond)}
  | kFor ini=stmts s[","] cond=exp s[","] inc=stmts kDo body=stmts kOd {Seq(ini, While(cond, Seq(body, inc)))}
),
elses = memo $ eta syntax (
    kFi {Skip}
  | kElse body=stmts kFi {body}
  | kElif cond=exp kThen body=stmt other=elses {If(cond, body, other)}
),
stmts = memo $ eta syntax (
  stmt |
  l=stmt s[";"] r=stmts {Seq(l, r)}             
);

-- Public top-level parser
public parse = stmts;
