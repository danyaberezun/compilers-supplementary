-- Parser 
import Ostap;
import Lexer;
import List;
import Fun;
import Matcher;

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
   syntax (-l p -r)
}
-- Primary expression
var primary = memo $ eta (decimal @ fun (x) {Const(stringInt(x))} | lident @ fun (x) {Var(x)} | inbr(s("("), exp, s(")"))),
    exp     = memo $ eta (
                   expr({[Left, {[s("!!"), fun (x, _, y) {Binop("!!", x, y)}]}],
                      [Left, {[s("&&"), fun (x, _, y) {Binop("&&", x, y)}]}],
                      [Left, {[s("=="), fun (x, _, y) {Binop("==", x, y)}],
                              [s("!="), fun (x, _, y) {Binop("!=", x, y)}],
                              [s("<="), fun (x, _, y) {Binop("<=", x, y)}],
                              [s(">="), fun (x, _, y) {Binop(">=", x, y)}],
                              [s("<"), fun (x, _, y) {Binop("<", x, y)}],
                              [s(">"), fun (x, _, y) {Binop(">", x, y)}]}],
                      [Left, {[s("+"), fun (x, _, y) {Binop("+", x, y)}], [s("-"), fun (x, _, y) {Binop("-", x, y)}]}],
                      [Left, {[s("*"), fun (x, _, y) {Binop("*", x, y)}],
                              [s("/"), fun (x, _, y) {Binop("/", x, y)}],
                              [s("%"), fun (x, _, y) {Binop("%", x, y)}]}]}, primary)
                );
var stmtHlp = memo $ eta syntax (
                             kSkip {Skip} |
                             
                             -kRead x=inbr[s("("), lident, s(")")] {Read(x)} |
                             
                             -kWrite e=inbr[s("("), exp, s(")")] {Write(e)} |
                             
                             -kIf cnd=exp -kThen s=stmt t=tail -kFi {If(cnd, s, t)} |
                             
                             -kWhile e=exp -kDo body=stmt -kOd {While(e, body)} |
                             
                             -kDo body=stmt -kWhile e=exp -kOd {DoWhile(body, e)} |
                             
                             -kFor init=stmtHlp -s[","] cnd=exp -s[","] step=stmtHlp -kDo body=stmt -kOd {
                                Seq(init, While(cnd, Seq(body, step)))
                             } |
                             
                             x=lident -s[":="] e=exp {Assn(x, e)}
                           ),
    tail    = memo $ eta syntax (
      -kElif cnd=exp -kThen s=stmt t=tail {If(cnd, s, t)} |
      
      -kElse s=stmt {s} |
      
      $(empty) {Skip}
    ),
    stmt    = memo $ eta syntax (
      s1=stmtHlp -s[";"] s2=stmt {Seq(s1, s2)} |
      
      stmtHlp
    );
-- Public top-level parser
public parse = stmt;