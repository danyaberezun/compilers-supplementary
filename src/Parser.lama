-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;
import Matcher;
import Ref;
import Collection;

fun error (msg, loc) {
  failure ("%s at %d:%d\n", msg, loc.fst, loc.snd)
}

fun assertValue (atr, v, loc) {
  case atr of
    Ref  -> error ("reference expected", loc)
  | Void -> Ignore (v)
  | _    -> v
  esac
}

fun assertVoid (atr, v, loc) {
  case atr of
    Void -> v
  | Val  -> error ("value expected", loc)
  | _    -> error ("reference expected", loc)
  esac
}

fun inbr (l, p, r) {
  syntax (-l p -r)
}

fun binop (op) {
  [syntax (pos -s[op]), fun (l, loc, r) {
                          fun (a) {assertValue (a, Binop (op, l (Val), r (Val)), loc)}
                        }]
}

fun void (loc, e) {
  fun (a) {assertVoid (a, e, loc)}
}

var primary  = memo $ eta syntax (
      loc=pos x=decimal {fun (a) {assertValue (a, Const (stringInt (x)), loc)}} |
      x=lident {fun (a) {case a of Ref -> Ref (x) | Void -> Ignore (Var (x)) | _ -> Var (x) esac}} |
      inbr[s("("), exp, s(")")] |
      loc=pos -kSkip {void (loc, Skip)} |
      loc=pos -kRead x=inbr[s("("), lident, s(")")] {void (loc, Read (x))} |
      loc=pos -kWrite e=inbr[s("("), exp, s(")")] {void (loc, Write (e (Val)))} |
      loc=pos -kIf c=exp -kThen t=exp e=elsePart -kFi {fun (a) {If (c (Val), t (a), e (a, loc))}} |
      loc=pos -kWhile c=exp -kDo b=exp -kOd {void (loc, While (c (Val), b (Void)))} |
      loc=pos -kDo b=exp -kWhile c=exp -kOd {void (loc, DoWhile (b (Void), c (Val)))} |
      loc=pos -kFor i=exp -s[","] c=exp -s[","] step=exp -kDo b=exp -kOd {
        void (loc, Seq (i (Void), While (c (Val), Seq (b (Void), step (Void)))))
      }),
    basic    = memo $ eta (expr ({[Right, {[syntax (pos -s[":="]),
                                            fun (l, loc, r) {
                                              fun (a) {assertValue (a, Assn (l (Ref), r (Val)), loc)}
                                            }]}],
                                  [Left , map (binop, {"!!"})],
                                  [Left , map (binop, {"&&"})],
                                  [Nona , map (binop, {"==", "!=", "<", ">", "<=", ">="})],
                                  [Left , map (binop, {"+", "-"})],
                                  [Left , map (binop, {"*", "/", "%"})]
                                 },
                                 primary)),
    exp      = memo $ eta syntax (s1=basic -s[";"] s2=exp {fun (a) {Seq (s1 (Void), s2 (a))}} | basic),
    elsePart = memo $ eta (
      syntax (-kElse e=exp {fun (a, _) {e (a)}}) |
      syntax (loc=pos -kElif c=exp -kThen t=exp e=elsePart {fun (a, _) {If (c (Val), t (a), e (a, loc))}}) |
      empty @ fun (_) {fun (a, loc) {assertVoid (a, Skip, loc)}});

public parse = syntax (s=exp {s (Void)});
