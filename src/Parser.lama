-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

fun makeBinop (l, op, r) {
  Binop (op, l, r)
}

fun makeSeq (l, _, r) {
  Seq (l, r)
}

var kAssn = s (":=");

-- Primary expression
var primary = memo $ eta syntax (x=decimal {Const (stringInt (x))} |
                                 x=lident  {Var (x)}               |
                                 inbr[s("("), exp, s(")")]),
      exp = memo $ eta (expr (
        {
          [Left, {[s ("!!"), makeBinop]}],
          [Left, {[s ("&&"), makeBinop]}],
          [Left, {[s ("=="), makeBinop], [s ("!="), makeBinop]}],
          [Left, {[s ("<"), makeBinop], [s ("<="), makeBinop], [s (">"), makeBinop], [s (">="), makeBinop]}],
          [Left, {[s ("+"), makeBinop], [s ("-"), makeBinop]}],
          [Left, {[s ("*"), makeBinop], [s ("/"), makeBinop], [s ("%"), makeBinop]}]
        }, primary));

var atomStmt = memo $ eta syntax (x=lident -kAssn e=exp {Assn (x, e)} |
                                    -kRead x=inbr[s ("("), lident, s (")")] {Read (x)} |
                                    -kWrite e=inbr[s ("("), exp, s (")")] {Write (e)} |
                                    -kSkip {Skip}),
    stmt = memo $ eta (expr ({[Left, {[s (";"), makeSeq]}]}, atomStmt));
   

-- Public top-level parser
public parse = stmt;
             
