-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;
import Matcher;
import Ref;
import Collection;

-- Signals an error; takes an error message and location info
fun error (msg, loc) {
  failure ("%s at %d:%d\n", msg, loc.fst, loc.snd)
}

-- An attribute-processing functions
-- Attributes are:
--   Val  --- a plain value (aka "rvalue")
--   Ref  --- a reference to a mutable cell (aka "lvalue")
--   Void --- no value (aka "void"/"unit")

-- Checks if a plain value "val" can be used in the context described by
-- the attribute "atr".
fun assertValue (atr, v, loc) {
  case atr of
    Ref  -> error ("reference expected", loc)
  | Void -> Ignore (v)
  | _    -> v
  esac
}

fun assertVoid (atr, v, loc) {
  case atr of
    Void -> v
  | Val  -> error ("value expected", loc)
  | _    -> error ("reference expected", loc)
  esac
}

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

fun binop (op) {
  [syntax (pos -s[op]), fun (l, loc, r) {
                          fun (a) {
                            assertValue (a, Binop (op, l (Val), r (Val)), loc)
                          }
                        }
  ]
}

var kComma = s (",");

var primary  = memo $ eta syntax (
                                  -- decimal constant
                                  loc=pos x=decimal                                 {fun (a) {assertValue (a, Const (stringInt (x)), loc)}}     |

                                  -- identifier
                                  x=lident                                          {fun (a) {
                                                                                       case a of
                                                                                         Ref  -> Ref (x)
                                                                                       | Void -> Ignore (Var (x))
                                                                                       | _    -> Var (x)
                                                                                       esac
                                                                                    }} |
                                  e=inbr[s ("("), exp, s (")")]                     {e}),
    basic    = memo $ eta (expr ({[Right, {[s (":="),
                                            fun (l, loc, r) {
                                              fun (a) {assertValue (a, Assn (l (Ref), r (Val)), loc)}
                                            }]}],
                                  [Left , map (binop, {"!!"})],
                                  [Left , map (binop, {"&&"})],
                                  [Nona , map (binop, {"==", "!=", "<", ">", "<=", ">="})],
                                  [Left , map (binop, {"+", "-"})],
                                  [Left , map (binop, {"*", "/", "%"})]
                                 },
                                 primary)),
    simpleStmt = memo $ eta syntax (
                                     loc=pos -kRead x=inbr[s ("("), lident, s (")")]  {fun (a) {assertVoid (a, Read (x), loc)}}   |
                                     loc=pos -kWrite e=inbr[s ("("), exp, s (")")]    {fun (a) {assertVoid (a, Write (e (Val)), loc)}} |
                                     loc=pos -kSkip                                    {fun (a) {assertVoid (a, Skip, loc)}} |
                                     s=basic                                            {s}
                                   ),
    ifTail = memo $ eta syntax (
                                  loc=pos -kElif e=exp -kThen s1=exp t=ifTail {fun (a) {assertVoid (a, If (e (Val), s1 (Void), t (Void)), loc)}} |
                                  -kElse s=exp -kFi                             {s} |
                                  loc=pos -kFi                                  {fun (a) {assertVoid (a, Skip, loc)}}
                                ),
    ifStmt = memo $ eta syntax (
                                  loc=pos -kIf e=exp -kThen s1=exp t=ifTail {fun (a) {assertVoid (a, If (e (Val), s1 (Void), t (Void)), loc)}}
                                ),
    whileStmt = memo $ eta syntax (
                                     loc=pos -kWhile e=exp -kDo s=exp -kOd {fun (a) {assertVoid (a, While (e (Val), s (Void)), loc)}}
                                   ),
    doWhileStmt = memo $ eta syntax (
                                       loc=pos -kDo s=exp -kWhile e=exp -kOd {fun (a) {assertVoid (a, DoWhile (s (Void), e (Val)), loc)}}
                                     ),
    forStmt = memo $ eta syntax (
                                  loc=pos -kFor init=simpleStmt -kComma e=exp -kComma step=simpleStmt -kDo body=exp -kOd {
                                    fun (a) {
                                      assertVoid (a, Seq (init (Void), While (e (Val), Seq (body (Void), step (Void)))), loc)
                                    }
                                  }
                                ),
    atomStmt = memo $ eta syntax (s=simpleStmt {s} | s=ifStmt {s} | s=whileStmt {s} | s=doWhileStmt {s} | s=forStmt {s}),
    exp      = memo $ eta syntax (atomStmt | s1=atomStmt s[";"] s2=exp {fun (a) {Seq (s1 (Void), s2 (a))}});

-- Public top-level parser
public parse = syntax (s=exp {s (Void)});
