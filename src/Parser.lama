-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;
import Matcher;

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

fun op (o) {
  [s (o),  fun (l, _, r) {Binop (o, l, r)}]
}

fun elifTail (cond, stmt1, tail) {
  fun (cond1, stmt2) {
    If (cond1, stmt2, tail (cond, stmt1))
  }
}

fun elseTail (stmt1) {
  fun (cond1, stmt2) {
    If (cond1, stmt2, stmt1)
  }
}

fun endIfTail () {
  fun (cond1, stmt1) {
    If (cond1, stmt1, Skip)
  }
}

fun forStmtBody (stmt1, cond, stmt2, stmt3) {
  Seq (stmt1, While (cond, Seq (stmt3, stmt2)))
}

-- Primary expression
var primary = memo $ eta syntax (x=decimal {Const (stringInt (x))} |
                                 x=lident  {Var (x)}               |
                                 inbr[s("("), exp, s(")")]),
    exp = memo $ eta (expr (
            {
              [Left, {op("!!")}],
              [Left, {op("&&")}],
              [Nona, {op("=="), op("!="), op("<="), op("<"), op(">="), op(">")}],
              [Left, {op("+"), op("-")}],
              [Left, {op("*"), op("/"), op("%")}]
            },
            primary
          ));

var partStmt = memo $ eta syntax (
                x=lident -s[":="] e=exp {Assn (x, e)} |
                -kSkip {Skip}
              ),
    tailStmt = memo $ eta syntax (
               -kElif cond=exp -kThen stmt1=stmt tail=tailStmt {elifTail (cond, stmt1, tail)} |
               -kElse stmt1=stmt -kFi {elseTail (stmt1)} |
               -kFi {endIfTail ()}
             );

var simpleStmt = memo $ eta syntax (
                   x=lident -s[":="] e=exp {Assn (x, e)} |
                   -kRead x=inbr[s("("), lident, s(")")] {Read (x)} |
                   -kWrite e=inbr[s("("), exp, s(")")] {Write (e)} |
                   -kSkip {Skip} |
                   -kIf cond=exp -kThen stmt1=stmt tail=tailStmt {tail (cond, stmt1)} |
                   -kWhile cond=exp -kDo stmt1=stmt -kOd {While (cond, stmt1)} |
                   -kDo stmt1=stmt -kWhile cond=exp -kOd {DoWhile (stmt1, cond)} |
                   -kFor stmt1=partStmt -s[","] cond=exp -s[","] stmt2=partStmt -kDo stmt3=stmt -kOd {forStmtBody (stmt1, cond, stmt2, stmt3)}
                 ),
    stmt = memo $ eta syntax (
             stmt1=simpleStmt -s[";"] stmt2=stmt {Seq (stmt1, stmt2)} |
             simpleStmt
           ); 

-- Public top-level parser
public parse = stmt;
