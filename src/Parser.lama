-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;
import Matcher;

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}
fun binop(l, op, r) { Binop(op, l, r) }
-- Primary expression
var primary = memo $ eta (decimal @ fun (x) {Const (stringInt (x))} |
                          lident  @ fun (x) {Var (x)} |
                          inbr (s ("("), exp, s (")"))),
    exp = memo $ eta(
      expr ({
        [Left, {[s("!!"), binop],
                [s("&&"),  binop]}],
        [Nona, {[s("=="), binop],
                [s("!="), binop],
                [s("<"), binop],
                [s(">"), binop],
                [s("<="), binop],
                [s(">="), binop]}],
        [Left, {[s("+"), binop],
                [s("-"), binop]}],
        [Left, {[s("*"), binop],
                [s("/"), binop],
                [s("%"), binop]}]
        },
        primary)
    );

var post_if = memo $ eta syntax (
   kElif e=exp kThen s1=stmt s2=post_if  {If(e, s1, s2)} |
   kElse s1=stmt kFi                     {s1}           |
   kFi                                   {Skip}
);

var simple = memo $ eta syntax (
    x=lident s[":="] e=exp                  {Assn (x, e)}      |
    kRead x = inbr[s("("), lident, s(")")]  {Read (x)}         |
    kWrite e = inbr[s("("), exp, s(")")]    {Write (e)}        |
    kSkip                                   {Skip}             |
    kIf e=exp kThen s1=stmt s2=post_if      {If(e, s1, s2)}    |
    kWhile e=exp kDo s1=stmt kOd            {While(e, s1)}     |
    kDo s1=stmt kWhile e=exp kOd            {DoWhile(s1, e)}   |
    kFor s1=stmt s[","] e=exp s[","] s2=stmt kDo s3=stmt kOd  {Seq(s1, While(e, Seq(s3, s2)))}
);

var stmt = memo $ eta (
    expr({
        [Left, {[s(";"), fun (l, op, r) {Seq(l, r)}]}]
      },
      simple
    )
);
   

-- Public top-level parser
public parse = stmt;
