-- Parser 
import Ostap;
import Lexer;
import List;
import Fun;
import Matcher;

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
   syntax (-l p -r)
}
fun binop (l, o, r) {
   Binop(o, l, r)
}
-- Primary expression
var primary = memo $ eta syntax (
                       x=decimal {Const(stringInt(x))} |
                       
                       x=lident {Var(x)} |
                       
                       inbr[s("("), exp, s(")")]
                     ),
    exp     = memo $ eta (
                   expr({[Left, {[s("!!"), binop], [s("&&"), binop]}],
                      [Nona, {[s(">="), binop], [s(">"), binop], [s("<="), binop], [s("<"), binop], [s("=="), binop], [s("!="), binop]}],
                      [Left, {[s("+"), binop], [s("-"), binop]}],
                      [Left, {[s("*"), binop], [s("/"), binop], [s("%"), binop]}]}, primary)
                );

var ifTail = memo $ eta syntax (
      kElif e=exp kThen s1=stmt s2=ifTail {If(e, s1, s2)} |
      kElse s2=stmt kFi {s2} |
      kFi {Skip}
    );

var stmt1 = memo $ eta syntax (
                          kRead e=inbr[s("("), lident, s(")")] {Read(e)} |
                          kWrite e=inbr[s("("), exp, s(")")] {Write(e)} |
                          kSkip {Skip} |
                          l=lident s[":="] r=exp {Assn(l, r)} |
                          kIf e=exp kThen s1=stmt s2=ifTail {If(e, s1, s2)} |
                          kThen {Skip} |
                          kWhile e=exp kDo s=stmt kOd {While(e, s)} |
                          kDo s=stmt kWhile e=exp kOd {DoWhile(e, s)} |
                          kFor i0=stmt s[","] cond=exp s[","] step=stmt kDo body=stmt kOd {For(i0, cond, step, body)}
                        );
                        
                        
-- Public top-level parser
public stmt = memo $ eta syntax (
         stmt1 |
         s1=stmt1 s[";"] s2=stmt {Seq(s1, s2)}
       );

public parse = stmt;