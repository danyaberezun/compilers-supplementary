-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

fun mkBin (l, op, r) {
  Binop (op, l, r)
}

-- Primary expression
var primary = memo $ eta syntax (x=decimal {Const (stringInt (x))} |
                                 x=lident  {Var (x)}               |
                                 inbr[s("("), exp, s(")")]),

    exp = memo $ expr ({
        [ Left, { [s("!!"), mkBin] } ],
        [ Left, { [s("&&"), mkBin] } ],
        [ Nona, {
            [s("=="), mkBin],
            [s("!="), mkBin],
            [s("<="), mkBin],
            [s(">="), mkBin],
            [s("<"),  mkBin],
            [s(">"),  mkBin]
          } ],
        [ Left, {
            [s("+"), mkBin],
            [s("-"), mkBin]
          } ],
        [ Left, {
            [s("*"), mkBin],
            [s("/"), mkBin],
            [s("%"), mkBin]
          } ]
      }, primary),

    elsePart = memo $ eta (
      kElse |> fun (_) {stmt} |
      kElif |> fun (_) {
        exp |> fun (c) {
          kThen |> fun (_) {
            stmt |> fun (t) {
              elsePart @ fun (e) {If (c, t, e)}
            }
          }
        }
      } |
      empty @ lift (Skip)
    ),

    statement = memo $ eta syntax (
      kSkip { Skip } |
      kRead x = inbr[s("("), lident, s(")")] { Read (x) } |
      kWrite x = inbr[s("("), exp, s(")")] { Write (x) } |
      kIf c=exp -kThen t=stmt e=elsePart -kFi { If (c, t, e) } |
      kWhile c=exp -kDo b=stmt -kOd { While (c, b) } |
      kDo b=stmt -kWhile c=exp -kOd { DoWhile (b, c) } |
      kFor init=statement -s[","] c=exp -s[","] step=statement -kDo b=stmt -kOd { Seq (init, While (c, Seq (b, step))) } |
      x = lident -s[":="] e = exp { Assn (x, e) }
    ),

    stmt = memo $ eta syntax (
      x = statement -s[";"] y = stmt { Seq (x, y) } |
      x = statement { x }
    );

-- Public top-level parser
public parse = stmt;
