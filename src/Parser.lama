-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

fun mkBin (l, op, r) {
  Binop (op, l, r)
}

-- Primary expression
var primary = memo $ eta syntax (x=decimal {Const (stringInt (x))} |
                                 x=lident  {Var (x)}               |
                                 inbr[s("("), exp, s(")")]),
    
    exp = memo $ expr ({
        [ Left, { [s("!!"), mkBin] } ],
        [ Left, { [s("&&"), mkBin] } ],
        [ Nona, {
            [s("=="), mkBin],
            [s("!="), mkBin],
            [s("<"),  mkBin],
            [s("<="), mkBin],
            [s(">"),  mkBin],
            [s(">="), mkBin]
          } ],
        [ Left, {
            [s("+"), mkBin],
            [s("-"), mkBin]
          } ],
        [ Left, {
            [s("*"), mkBin],
            [s("/"), mkBin],
            [s("%"), mkBin]
          } ]
      }, primary);

    var statement = memo $ eta syntax (
      kSkip { Skip } |
      kRead x = inbr[s("("), lident, s(")")] { Read (x) } |
      kWrite x = inbr[s("("), exp, s(")")] { Write (x) } |
      x = lident -s[":="] e = exp { Assn (x, e) }
    );

    var stmt = memo $ eta syntax (
        x = statement -s[";"] y = stmt { Seq (x, y) } |
        x = statement { x }
    );
   

-- Public top-level parser
public parse = stmt;
             
