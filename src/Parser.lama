-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

-- Primary expression
var primary = memo $ eta syntax (x=decimal {Const (stringInt (x))} |
                                 x=lident  {Var (x)}               |
                                 inbr[s("("), exp, s(")")]),
    exp = memo $ eta (expr (
      case fun(op) {
        [s(op), fun(l, _, r) { Binop(op, l, r)}]
      } of transform ->
      {
        [Left, map(transform, {"!!"})],
        [Left, map(transform, {"&&"})],
        [Nona, map(transform, {">", "<", ">=", "<=", "==", "!="})],
        [Left, map(transform, {"+", "-"})],
        [Left, map(transform, {"*", "%", "/"})]
      } esac, 
      primary)
    );

var stmt = 
  memo $ eta syntax 
    (kRead x=inbr[s("("), lident, s(")")] {Read (x)} |
     kWrite x=inbr[s("("), exp, s(")")] {Write (x)}  |
     kSkip {Skip}                                    |
     x=lident s[":="] y=exp {Assn (x, y)}
  );
   

-- Public top-level parser
public parse = memo $ eta syntax (stmt | l=stmt s[";"] r=parse {Seq (l, r)});
             
