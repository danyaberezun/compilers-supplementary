-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

fun binop(op) {
  [s(op), fun(l, op, r) {Binop(op, l, r)}]
}

-- Primary expression
var primary = memo $ eta syntax (x=decimal {Const (stringInt (x))} |
                                 x=lident  {Var (x)}               |
                                 inbr[s("("), exp, s(")")]),
      exp = memo $ eta (expr({[Left, {binop("!!")}],
                              [Left, {binop("&&")}],
                              [Nona, {binop("=="), binop("<="), binop(">="),
                                      binop("!="), binop("<"), binop(">")}],
                              [Left, {binop("+"), binop("-")}],
                              [Left, {binop("*"), binop("/"), binop("%")}]},
                            primary));

var stmt = memo $ eta syntax (s1=basic -s[";"] s2=stmt {Seq(s1, s2)} | basic),
    basic = memo $ eta syntax (kSkip                               {Skip}       |
                              x=lident -s[":="] e=exp              {Assn(x, e)} |
                              kRead x=inbr[s("("), lident, s(")")] {Read(x)}    |
                              kWrite e=inbr[s("("), exp, s(")")]   {Write(e)});

-- Public top-level parser
public parse = stmt;
             
