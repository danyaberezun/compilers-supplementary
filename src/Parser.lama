-- Parser
import Ostap;
import Lexer;
import List;
import Fun;
import Matcher;

fun inbr (l, p, r) {
   syntax (-l p -r)
}
fun makeBinops (ops) {
   map(fun (op) {[s(op), fun (l, op, r) {Binop(op, l, r)}]}, ops)
}
var primary = memo $ eta syntax (
                       x=decimal {Const(stringInt(x))} |
                       
                       x=lident {Var(x)} |
                       
                       inbr[s("("), exp, s(")")]
                     ),
    exp     = memo $ eta (
                 expr({[Left, makeBinops({"!!", "&&"})],
                    [Nona, makeBinops({"==", "!=", "<", ">", "<=", ">="})],
                    [Left, makeBinops({"+", "-"})],
                    [Left, makeBinops({"*", "/", "%"})]}, primary)
              );
var line   = memo $ eta syntax (
                            -kRead x=inbr[s("("), lident, s(")")] {Read(x)} |
                            
                            -kWrite e=inbr[s("("), exp, s(")")] {Write(e)} |
                            
                            -kSkip {Skip} |
                            
                            -kIf cond=exp -kThen s1=stmt tail=ifTail {If(cond, s1, tail)} |
                            
                            -kWhile cond=exp -kDo body=stmt -kOd {While(cond, body)} |
                            
                            -kDo body=stmt -kWhile cond=exp -kOd {DoWhile(body, cond)} |
                            
                            -kFor init=line s[","] cond=exp s[","] step=line -kDo body=stmt -kOd {
                               Seq(init, While(cond, Seq(body, step)))
                            } |
                            
                            x=lident s[":="] e=exp {Assn(x, e)}
                          ),
    stmt   = memo $ eta syntax (
      s1=line s[";"] s2=stmt {Seq(s1, s2)} |
      
      line
    ),
    ifTail = memo $ eta syntax (
      -kElif cond=exp -kThen s1=stmt tail=ifTail {If(cond, s1, tail)} |
      
      -kElse s2=stmt -kFi {s2} |
      
      -kFi {Skip}
    );
public parse = stmt;