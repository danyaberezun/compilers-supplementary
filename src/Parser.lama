-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;
import Matcher;

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

-- Primary expression
--var primary = memo $ eta (decimal @ fun (x) {Const (stringInt (x))} | lident  @ fun (x) {Var (x)} | inbr (s ("("), exp, s (")")));
var
	primary=memo$eta syntax(
		x=decimal{Const(stringInt(x))}
		|x=lident  {Var(x)}
		|inbr[s("("),exp,s(")")]
	),
	exp=memo$eta syntax(exp_a|x=exp s["!!"] y=exp_a{Binop("!!",x,y)}),
	exp_a=memo$eta syntax(exp_b|x=exp_a s["&&"] y=exp_b{Binop("&&",x,y)}),
	exp_b=memo$eta syntax(exp_c
		|x=exp_b s["<"] y=exp_c{Binop("<",x,y)}
		|x=exp_b s[">"] y=exp_c{Binop(">",x,y)}
		|x=exp_b s["!="] y=exp_c{Binop("!=",x,y)}
		|x=exp_b s["=="] y=exp_c{Binop("==",x,y)}
		|x=exp_b s[">="] y=exp_c{Binop(">=",x,y)}
		|x=exp_b s["<="] y=exp_c{Binop("<=",x,y)}
	),
	exp_c=memo$eta syntax(exp_d
		|x=exp_c s["+"]  y=exp_d{Binop("+",x,y)}
		|x=exp_c s["-"]  y=exp_d{Binop("-",x,y)}
	),
	exp_d=memo$eta syntax(primary
		|x=exp_d s["*"]  y=primary {Binop("*",x,y)}
		|x=exp_d s["/"]  y=primary {Binop("/",x,y)}
		|x=exp_d s["%"]  y=primary {Binop("%",x,y)}
	),
	stmt=memo$eta syntax(stmt_a|x=stmt s[";"] y=stmt_a{Seq(x,y)}),
	stmt_fi=memo$eta syntax(
		kFi{Skip}
		|kElse z=stmt kFi{z}
		|kElif x=exp kThen y=stmt z=stmt_fi{If(x,y,z)}
	),
	stmt_a=memo $ eta syntax(
		kRead s["("] x=lident s[")"]{Read(x)}
		|kWrite s["("] x=exp s[")"]{Write(x)}
		|kSkip{Skip}
		|x=lident s[":="] e=exp{Assn(x,e)}
		|kWhile x=exp kDo y=stmt kOd{While(x,y)}
		|kIf x=exp kThen y=stmt z=stmt_fi{If(x,y,z)}
		|kDo x=stmt kWhile y=exp kOd{DoWhile(x,y)}
	);
   

-- Public top-level parser
public parse = stmt;
