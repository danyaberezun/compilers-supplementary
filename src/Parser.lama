-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

-- Primary expression
var primary = memo $ eta syntax (x=decimal {Const (stringInt (x))} |
                                 x=lident  {Var (x)}               |
                                 inbr[s("("), exp, s(")")]),
    exp = memo $ eta (expr ({
    [Left, {[s ("!!"), fun (x, op, y) {Binop ("!!", x, y)}]}],
    [Left, {[s ("&&"), fun (x, op, y) {Binop ("&&", x, y)}]}],
    [Nona, {[s ("=="), fun (x, op, y) {Binop ("==", x, y)}],
      [s ("!="), fun (x, op, y) {Binop ("!=", x, y)}],
      [s ("<="), fun (x, op, y) {Binop ("<=", x, y)}],
      [s ("<"),  fun (x, op, y) {Binop ("<", x, y)}],
      [s (">="), fun (x, op, y) {Binop (">=", x, y)}],
      [s (">"),  fun (x, op, y) {Binop (">", x, y)}]}],
    [Left, {[s ("+"),  fun (x, op, y) {Binop ("+", x, y)}],
      [s ("-"),  fun (x, op, y) {Binop ("-", x, y)}]}],
    [Left, {[s ("*"),  fun (x, op, y) {Binop ("*", x, y)}],
      [s ("/"),  fun (x, op, y) {Binop ("/", x, y)}],
      [s ("%"),  fun (x, op, y) {Binop ("%", x, y)}]}]
  }, primary));

var oper = memo $ eta syntax (lhs=lident -s[":="] rhs=exp {Assn(lhs, rhs)} |
                              -s["skip"] {Skip} |
                              -s["read"] name=inbr[s("("), lident, s(")")] {Read(name)}|
                              -s["write"] e=inbr[s("("), exp, s(")")] {Write(e)} |
                              -s["if"] c=exp -s["then"] t=stmt f=condTrail -s["fi"] {If(c, t, f)}|
                              -s["while"] c=exp -s["do"] b=stmt -s["od"] {While(c, b)}|
                              -s["do"] b=stmt -s["while"] c=exp -s["od"] {DoWhile(b, c)}|
                              -s["for"] i=stmt -s[","] c=exp -s[","] e=stmt -s["do"] b=stmt -s["od"] {Seq(i, While(c, Seq(b, e)))}),
  condTrail = memo $ eta syntax (-s["else"] f=stmt {f}|
                                 -s["elif"] c=exp -s["then"] t=stmt f=condTrail {If(c, t, f)}|
                                 -s[""] {Skip}),
  stmt = memo $ eta syntax (h=oper -s[";"] t=stmt {Seq(h, t)} |
                            op=oper {op});


-- Public top-level parser
public parse = stmt;

