-- Parser 

import Ostap;
import Lexer;
import List;
import Fun;
import Matcher;

-- A parser of "something" in brackets; l, r are left and right
-- brackets as parsers, p --- a parser of "something"
fun inbr (l, p, r) {
  syntax (-l p -r)
}

fun binops (ops) {
  map(fun (op) {
    [s(op), fun (l, op, r) {Binop (op, l, r)}]
  }, ops)
}

-- Primary expression
var primary = memo $ eta syntax (x=decimal {Const (stringInt (x))} |
                                 x=lident  {Var (x)}               |
                                 inbr[s("("), exp, s(")")]),
    exp = memo $ eta (
      expr({
        [Left, binops ({"!!", "&&"})],
        [Nona, binops ({"==", "!=", "<", ">", "<=", ">="})],
        [Left, binops ({"+", "-"})],
        [Left, binops ({"*", "/", "%"})]
      }, primary)
    );

var elsePart = syntax (
  -kElse stmts                                        | 
  kElif c=exp kThen t=stmts e=elsePart {If (c, t, e)} |
  empty                                {Skip}
);

var stmt = syntax(
  kRead  x=inbr[s("("), lident, s(")")]    {Read (x)}           | -- read
  kWrite e=inbr[s("("), exp, s(")")]       {Write (e)}          | -- write
  kSkip                                    {Skip}               | -- skip
  x=lident s[":="] e=exp                   {Assn (x, e)}        | -- assignment
  kIf c=exp kThen t=stmts e=elsePart kFi   {If (c, t, e)}       | -- if-then-else
  kWhile c=exp kDo b=stmts kOd             {While (c, b)}       | -- while-do-od
  kDo b=stmts kWhile c=exp kOd             {DoWhile (b, c)}     | -- do-while-od
  kFor i=stmts s[","] c=exp s[","] u=stmts 
    kDo b=stmts kOd           {Seq(i, While(c, Seq(b, u)))}       -- for
);

var stmts = syntax (
  stmt | s1=stmt s[";"] s2=stmts {Seq (s1, s2)}
);

-- Public top-level parser
public parse = stmts;
